<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <LangVersion>latest</LangVersion>
        <Version>0.3.14</Version>
        <AssemblyVersion>0.3.14.0</AssemblyVersion>
        <FileVersion>0.3.14.0</FileVersion>
        <Product>Patchouli.NET</Product>
        <Title>Patchouli.NET</Title>
        <AssemblyTitle>Patchouli.NET</AssemblyTitle>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
        <LangVersion>14.0</LangVersion>
        <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
    </PropertyGroup>
    <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
        <!-- Do not fall back to the SDK-shipped FSharp.Core when a project stops depending on FCS. -->
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>
</Project>

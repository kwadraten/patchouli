<Window x:Class="LiteratureApp.UI.MainWindow" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="1180" Height="780" MinWidth="900" MinHeight="620" Title="LiteratureApp">
  <Grid ColumnDefinitions="200,*,Auto" RowDefinitions="*,Auto" Margin="0">
    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
      <StackPanel DataContext="{Binding Shell}" Spacing="4" Margin="12">
        <TextBlock Text="{Binding LibraryName}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBlock Text="My Library" FontWeight="SemiBold" />
        <TextBlock Text="Recent Items" FontWeight="SemiBold" Margin="0,12,0,4" />
        <ItemsControl ItemsSource="{Binding RecentItems}" />
        <TextBlock Text="Recent Documents" FontWeight="SemiBold" Margin="0,12,0,4" />
        <ItemsControl ItemsSource="{Binding RecentDocuments}" />
        <Button Content="Developer Tools" Margin="0,24,0,0" Command="{Binding ToggleDeveloperToolsCommand}" />
      </StackPanel>
    </Border>
    <TabControl Grid.Column="1" Margin="12,0">
      <TabItem Header="Library">
        <ScrollViewer><StackPanel DataContext="{Binding Library}" Spacing="8">
          <TextBox PlaceholderText="Display name" Text="{Binding DisplayName}"/>
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Create Library" Command="{Binding CreateCommand}"/><Button Content="Refresh" Command="{Binding RefreshCommand}"/></StackPanel>
          <TextBox AcceptsReturn="True" Height="180" Text="{Binding Details}"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Items">
        <ScrollViewer><StackPanel DataContext="{Binding Bibliography}" Spacing="8">
          <TextBox PlaceholderText="Item type" Text="{Binding ItemType}"/><TextBox PlaceholderText="Title" Text="{Binding Title}"/>
          <Button Content="Create Item" Command="{Binding CreateItemCommand}"/>
          <TextBox AcceptsReturn="True" Height="360" Text="{Binding Output}"/>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="2" Margin="12,0,12,6">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" />
      <TextBlock FontSize="11" Text="{Binding VersionInfo}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>

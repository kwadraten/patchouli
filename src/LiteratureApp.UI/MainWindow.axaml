<Window x:Class="LiteratureApp.UI.MainWindow" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="1180" Height="780" MinWidth="900" MinHeight="620" Title="LiteratureApp MVP">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock VerticalAlignment="Center" Text="Runtime DB"/>
      <TextBox Width="600" Text="{Binding RuntimeDatabasePath}"/>
      <Button Content="Open / Migrate" Command="{Binding OpenDatabaseCommand}"/>
    </StackPanel>
    <TabControl Grid.Row="1" Margin="0,12,0,12">
      <TabItem Header="Library"><ScrollViewer><StackPanel DataContext="{Binding Library}" Spacing="8"><TextBox PlaceholderText="Display name" Text="{Binding DisplayName}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Create Library" Command="{Binding CreateCommand}"/><Button Content="Refresh" Command="{Binding RefreshCommand}"/></StackPanel><TextBox PlaceholderText="New display name" Text="{Binding RenameTo}"/><Button Content="Rename" Command="{Binding RenameCommand}"/><TextBox AcceptsReturn="True" Height="180" Text="{Binding Details}"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Bibliography"><ScrollViewer><StackPanel DataContext="{Binding Bibliography}" Spacing="8"><TextBox PlaceholderText="Item type" Text="{Binding ItemType}"/><TextBox PlaceholderText="Title" Text="{Binding Title}"/><TextBox PlaceholderText="Subtitle" Text="{Binding Subtitle}"/><Button Content="Create Item" Command="{Binding CreateItemCommand}"/><TextBox PlaceholderText="Item ID" Text="{Binding ItemId}"/><TextBox PlaceholderText="Scheme" Text="{Binding Scheme}"/><TextBox PlaceholderText="Identifier value" Text="{Binding IdentifierValue}"/><Button Content="Add Identifier" Command="{Binding AddIdentifierCommand}"/><TextBox AcceptsReturn="True" Height="180" Text="{Binding Output}"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="File / Document"><ScrollViewer><StackPanel DataContext="{Binding FileDocument}" Spacing="8"><TextBox PlaceholderText="File path" Text="{Binding FilePath}"/><Button Content="Register File" Command="{Binding RegisterCommand}"/><TextBox PlaceholderText="Item ID" Text="{Binding ItemId}"/><TextBox PlaceholderText="File asset ID (optional for attach)" Text="{Binding FileAssetId}"/><TextBox PlaceholderText="Instance type" Text="{Binding InstanceType}"/><Button Content="Attach Document Instance" Command="{Binding AttachCommand}"/><Button Content="Resolve File" Command="{Binding ResolveCommand}"/><TextBox AcceptsReturn="True" Height="180" Text="{Binding Output}"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Page / Layout"><ScrollViewer><StackPanel DataContext="{Binding PageLayout}" Spacing="8"><TextBox PlaceholderText="Document instance ID" Text="{Binding DocumentInstanceId}"/><TextBox PlaceholderText="Page index" Text="{Binding PageIndex}"/><Button Content="Create Page" Command="{Binding CreatePageCommand}"/><Button Content="Create Current Manual Revision" Command="{Binding CreateRevisionCommand}"/><TextBox PlaceholderText="Page ID" Text="{Binding PageId}"/><TextBox PlaceholderText="Revision ID" Text="{Binding RevisionId}"/><TextBox PlaceholderText="Simple text" Text="{Binding Text}"/><Button Content="Add Simple Text Node" Command="{Binding AddNodeCommand}"/><Button Content="Build Page Plain Text" Command="{Binding BuildTextCommand}"/><TextBox AcceptsReturn="True" Height="180" Text="{Binding Output}"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="PDF Render"><ScrollViewer><StackPanel DataContext="{Binding PdfRender}" Spacing="8"><TextBlock Text="Production uses optional pdftoppm (Poppler). Cache images are local, rebuildable, not synced, and never exposed by MCP. Batch PDF OCR is not implemented."/><Button Content="Check Renderer Status" Command="{Binding CheckRendererCommand}"/><TextBlock Text="{Binding RendererStatus}"/><TextBox PlaceholderText="Document instance ID" Text="{Binding DocumentInstanceId}"/><TextBox PlaceholderText="Page ID" Text="{Binding PageId}"/><TextBox PlaceholderText="Tesseract preset ID (for rendered OCR)" Text="{Binding PresetId}"/><TextBox PlaceholderText="DPI" Text="{Binding Dpi}"/><CheckBox Content="Force rerender" IsChecked="{Binding ForceRerender}"/><Button Content="Check BBox Warnings" Command="{Binding CheckBBoxWarningsCommand}"/><Button Content="Render PDF Page" Command="{Binding RenderCommand}"/><Button Content="Run OCR on Rendered PDF Page" Command="{Binding RunOcrCommand}"/><TextBox AcceptsReturn="True" Height="180" Text="{Binding Output}"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="OCR"><ScrollViewer><StackPanel DataContext="{Binding MockOcr}" Spacing="8"><TextBlock Text="PDF rendering and cloud OCR are not implemented. Local image OCR requires a separately installed Tesseract CLI."/><Button Content="Show OCR Engine Capabilities" Command="{Binding ShowCapabilitiesCommand}"/><TextBox AcceptsReturn="True" Height="72" Text="{Binding Capabilities}"/><TextBox PlaceholderText="Mock preset name" Text="{Binding Name}"/><TextBox PlaceholderText="Parameters JSON" Text="{Binding ParametersJson}"/><CheckBox Content="Apply on success" IsChecked="{Binding ApplyOnSuccess}"/><Button Content="Create Mock Preset" Command="{Binding CreatePresetCommand}"/><TextBox PlaceholderText="Tesseract preset name" Text="{Binding TesseractName}"/><TextBox PlaceholderText="Tesseract executable path (optional; PATH is used when blank)" Text="{Binding TesseractExecutablePath}"/><TextBox PlaceholderText="Tesseract language" Text="{Binding TesseractLanguage}"/><Button Content="Create Tesseract Image Preset" Command="{Binding CreateTesseractPresetCommand}"/><TextBox PlaceholderText="Preset ID" Text="{Binding PresetId}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Check OCR Environment" Command="{Binding CheckEnvironmentCommand}"/><TextBox Width="300" PlaceholderText="New model path or endpoint" Text="{Binding NewModelPath}"/><Button Content="Rebind Model Path" Command="{Binding RebindModelPathCommand}"/></StackPanel><TextBox PlaceholderText="Document instance ID" Text="{Binding DocumentInstanceId}"/><TextBox PlaceholderText="Page IDs, comma separated (Mock only)" Text="{Binding PageIds}"/><Button Content="Run Mock OCR" Command="{Binding RunCommand}"/><TextBox PlaceholderText="Single page ID (local image OCR)" Text="{Binding ImagePageId}"/><TextBox PlaceholderText="Local image path (PNG/JPEG/etc.)" Text="{Binding ImagePath}"/><Button Content="Run Local Image OCR" Command="{Binding RunImageCommand}"/><TextBox PlaceholderText="Run ID" Text="{Binding RunId}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Show Run" Command="{Binding ShowRunCommand}"/><Button Content="Adopt Candidate" Command="{Binding AdoptCommand}"/><Button Content="Cancel Run" Command="{Binding CancelCommand}"/></StackPanel><ItemsControl ItemsSource="{Binding RecentRuns}"/><TextBox AcceptsReturn="True" Height="180" Text="{Binding Output}"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="OCR Queue"><ScrollViewer><StackPanel DataContext="{Binding OcrQueue}" Spacing="8"><TextBlock Text="Queue is in-process only. Queue does not survive app restart. MCP cannot control OCR queue." TextWrapping="Wrap"/><TextBox PlaceholderText="Document instance ID" Text="{Binding DocumentInstanceId}"/><TextBox PlaceholderText="Preset ID" Text="{Binding PresetId}"/><TextBox PlaceholderText="Mock page IDs, comma separated" Text="{Binding PageIds}"/><TextBox PlaceholderText="Single page ID" Text="{Binding PageId}"/><TextBox PlaceholderText="Image path (local image task)" Text="{Binding ImagePath}"/><TextBox PlaceholderText="DPI (rendered PDF task)" Text="{Binding Dpi}"/><TextBox PlaceholderText="Priority" Text="{Binding Priority}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Enqueue Mock OCR" Command="{Binding EnqueueMockCommand}"/><Button Content="Enqueue Image OCR" Command="{Binding EnqueueImageCommand}"/><Button Content="Enqueue Rendered PDF OCR" Command="{Binding EnqueueRenderedPdfCommand}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Start Scheduler" Command="{Binding StartCommand}"/><Button Content="Stop Scheduler" Command="{Binding StopCommand}"/><Button Content="Run One Tick" Command="{Binding TickCommand}"/><Button Content="Refresh Status" Command="{Binding RefreshCommand}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Pause Global" Command="{Binding PauseGlobalCommand}"/><Button Content="Resume Global" Command="{Binding ResumeGlobalCommand}"/><Button Content="Pause Local" Command="{Binding PauseLocalCommand}"/><Button Content="Resume Local" Command="{Binding ResumeLocalCommand}"/></StackPanel><TextBox PlaceholderText="Provider ID or task ID for pause/resume" Text="{Binding PauseTarget}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Pause Provider" Command="{Binding PauseProviderCommand}"/><Button Content="Resume Provider" Command="{Binding ResumeProviderCommand}"/><Button Content="Pause Task" Command="{Binding PauseTaskCommand}"/><Button Content="Resume Task" Command="{Binding ResumeTaskCommand}"/></StackPanel><TextBox PlaceholderText="Task ID to cancel" Text="{Binding TaskId}"/><Button Content="Cancel Task" Command="{Binding CancelCommand}"/><TextBlock Text="{Binding StatusSummary}" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Tasks}"/><TextBox AcceptsReturn="True" Height="130" Text="{Binding Output}"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Search / Evidence"><ScrollViewer><StackPanel DataContext="{Binding SearchEvidence}" Spacing="8"><TextBox PlaceholderText="Document instance ID" Text="{Binding DocumentInstanceId}"/><Button Content="Rebuild Search Units + FTS" Command="{Binding RebuildCommand}"/><TextBox PlaceholderText="Search query" Text="{Binding Query}"/><Button Content="Search" Command="{Binding SearchCommand}"/><ItemsControl ItemsSource="{Binding SearchUnits}"/><TextBox PlaceholderText="Search unit ID" Text="{Binding UnitId}"/><Button Content="Create Evidence Ref" Command="{Binding CreateEvidenceCommand}"/><TextBox PlaceholderText="Evidence ref" Text="{Binding EvidenceRef}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Generate Evidence Markdown" Command="{Binding MarkdownCommand}"/><Button Content="Copy Evidence Markdown" Command="{Binding CopyMarkdownCommand}"/></StackPanel><TextBox AcceptsReturn="True" Height="220" Text="{Binding Output}"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Search Profiles"><ScrollViewer><StackPanel DataContext="{Binding SearchProfiles}" Spacing="8"><TextBlock Text="Canonical text is unchanged. Rewrites affect the query only. First-version expansions have equal weight." TextWrapping="Wrap"/><TextBox PlaceholderText="Profile name" Text="{Binding Name}"/><TextBox PlaceholderText="Description" Text="{Binding Description}"/><Button Content="Create Profile" Command="{Binding CreateProfileCommand}"/><TextBox PlaceholderText="Profile ID" Text="{Binding ProfileId}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Set Default" Command="{Binding SetDefaultCommand}"/><Button Content="Refresh Profiles" Command="{Binding RefreshCommand}"/></StackPanel><ItemsControl ItemsSource="{Binding Profiles}"/><TextBox PlaceholderText="Rule type" Text="{Binding RuleType}"/><TextBox PlaceholderText="Pattern" Text="{Binding Pattern}"/><TextBox PlaceholderText="Replacement" Text="{Binding Replacement}"/><TextBox PlaceholderText="Direction" Text="{Binding Direction}"/><TextBox PlaceholderText="Priority" Text="{Binding Priority}"/><Button Content="Add Rewrite Rule" Command="{Binding AddRuleCommand}"/><TextBox PlaceholderText="Query" Text="{Binding Query}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Preview Rewrite Plan" Command="{Binding PreviewCommand}"/><Button Content="Search with Profile" Command="{Binding SearchCommand}"/></StackPanel><TextBox AcceptsReturn="True" Height="220" Text="{Binding Output}"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="MCP Preview"><ScrollViewer><StackPanel DataContext="{Binding McpPreview}" Spacing="8"><TextBox PlaceholderText="Search query" Text="{Binding Query}"/><Button Content="search_library" Command="{Binding SearchCommand}"/><TextBox PlaceholderText="Specific path to check" Text="{Binding SpecificPath}"/><TextBox PlaceholderText="Specific secret to check" Text="{Binding SpecificSecret}"/><Button Content="Safety Check" Command="{Binding SafetyCommand}"/><TextBlock Text="{Binding Safety}"/><TextBox AcceptsReturn="True" Height="260" Text="{Binding Output}"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Snapshot"><ScrollViewer><StackPanel DataContext="{Binding Snapshot}" Spacing="8"><TextBox PlaceholderText="Sync root" Text="{Binding SyncRoot}"/><TextBox PlaceholderText="Device ID" Text="{Binding DeviceId}"/><Button Content="Publish Snapshot" Command="{Binding PublishCommand}"/><TextBox PlaceholderText="Manifest path" Text="{Binding ManifestPath}"/><Button Content="Validate Snapshot" Command="{Binding ValidateCommand}"/><TextBox PlaceholderText="Staging root" Text="{Binding StagingRoot}"/><Button Content="Import to Staging" Command="{Binding ImportCommand}"/><TextBox AcceptsReturn="True" Height="220" Text="{Binding Output}"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Snapshot Branch"><ScrollViewer><StackPanel DataContext="{Binding SnapshotBranch}" Spacing="8"><TextBlock Text="No automatic merge. No silent last-writer-wins. Provider credentials, original files, and local caches are not imported." TextWrapping="Wrap"/><TextBox PlaceholderText="Manifest path" Text="{Binding ManifestPath}"/><TextBox PlaceholderText="Staging root" Text="{Binding StagingRoot}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Open Branch for Inspection" Command="{Binding OpenCommand}"/><Button Content="List Branch Items" Command="{Binding ListItemsCommand}"/></StackPanel><TextBox PlaceholderText="Selected item IDs, comma separated" Text="{Binding SelectedItemIds}"/><TextBox PlaceholderText="Selected document IDs, comma separated" Text="{Binding SelectedDocumentIds}"/><Button Content="Build Import Plan" Command="{Binding BuildPlanCommand}"/><CheckBox Content="I confirm this explicit selective import" IsChecked="{Binding ConfirmImport}"/><Button Content="Apply Import Plan" Command="{Binding ApplyCommand}"/><TextBox PlaceholderText="Separate branch copy destination" Text="{Binding DestinationPath}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Keep as Separate Library Copy" Command="{Binding KeepCopyCommand}"/><Button Content="Discard Branch Staging" Command="{Binding DiscardCommand}"/></StackPanel><TextBox AcceptsReturn="True" Height="240" Text="{Binding Output}"/></StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Spacing="2"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock FontSize="11" Text="{Binding VersionInfo}" TextWrapping="Wrap"/></StackPanel>
  </Grid>
</Window>

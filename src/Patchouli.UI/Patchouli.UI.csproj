<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputType>Exe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Patchouli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Patchouli.Core\Patchouli.Core.csproj" />
    <ProjectReference Include="..\Patchouli.Infrastructure\Patchouli.Infrastructure.csproj" />
    <ProjectReference Include="..\Patchouli.Ocr\Patchouli.Ocr.csproj" />
    <ProjectReference Include="..\Patchouli.Mcp\Patchouli.Mcp.csproj" />
    <ProjectReference Include="..\Patchouli.McpServer\Patchouli.McpServer.csproj" />
    <ProjectReference Include="..\Patchouli.Host\Patchouli.Host.csproj" />
    <ProjectReference Include="..\Patchouli.Workflows\Patchouli.Workflows.fsproj" />
    <ProjectReference Include="..\Patchouli.Reading\Patchouli.Reading.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="LiveMarkdown.Avalonia" />
    <PackageReference Include="LiveMarkdown.Avalonia.Mermaid" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="..\Patchouli.UI.Generators\Patchouli.UI.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="ProDataGrid" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\AppIcon.ico" />
    <AvaloniaResource Include="Assets\Lucide\*.svg" />
    <AvaloniaResource Include="Assets\CatWalk\*.svg" />
    <AvaloniaResource Include="Assets\CatWalk\LICENSE" />
    <AvaloniaResource Include="Assets\CatWalk\NOTICE" />
    <AvaloniaResource Include="Assets\CatWalk\SOURCE" />
    <EmbeddedResource Include="..\..\LICENSE" Link="LICENSE" />
    <EmbeddedResource Include="..\..\Changelog.md" Link="Changelog.md" LogicalName="Patchouli.UI.Changelog.md" />
    <EmbeddedResource Include="Assets\FSharp.xshd" />
    <EmbeddedResource Include="Assets\CatWalk\LICENSE" Link="Assets\CatWalk\LICENSE" />
    <EmbeddedResource Include="Assets\CatWalk\NOTICE" Link="Assets\CatWalk\NOTICE" />
    <EmbeddedResource Include="Assets\CatWalk\SOURCE" Link="Assets\CatWalk\SOURCE" />
  </ItemGroup>
</Project>

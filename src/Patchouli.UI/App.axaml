<Application
    x:Class="Patchouli.UI.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Patchouli.UI/Styles/FormStyles.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Patchouli.UI/Themes/AcademicPrecision.axaml" />
        <ResourceInclude Source="avares://Patchouli.UI/Styles/TabStyles.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>

<Application
  x:Class="Patchouli.UI.App"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="using:Patchouli.UI.Converters">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Patchouli.UI/Styles/FormStyles.axaml" />
    <StyleInclude Source="avares://Patchouli.UI/Styles/CardStyles.axaml" />
    <StyleInclude Source="avares://Patchouli.UI/Styles/SidebarStyles.axaml" />
    <StyleInclude Source="avares://Patchouli.UI/Styles/HistoryStyles.axaml" />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.v2.xaml" />
    <StyleInclude Source="avares://Patchouli.UI/Styles/DataGridStyles.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Patchouli.UI/Themes/RadixViolet.axaml" />
        <ResourceInclude Source="avares://Patchouli.UI/Styles/TabStyles.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <converters:ItemTypeDisplayConverter x:Key="ItemTypeDisplayConverter" />
      <converters:BoolChoiceConverter x:Key="BoolChoiceConverter" />
      <converters:VersionSourceConverter x:Key="VersionSourceConverter" />
    </ResourceDictionary>
  </Application.Resources>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/AppIcon.ico"
                ToolTipText="Patchouli.Net"
                Clicked="OnTrayIconClicked">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="打开 Patchouli.Net" Click="OnOpenFromTrayClick" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="退出" Click="OnExitFromTrayClick" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>

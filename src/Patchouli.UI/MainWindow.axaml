<Window x:Class="Patchouli.UI.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Patchouli.UI.Views"
        xmlns:lucide="using:Patchouli.Lucide.Avalonia"
        Width="1280" Height="820" MinWidth="1040" MinHeight="680"
        Title="Patchouli" Background="{DynamicResource SurfaceBrush}">

  <Window.Styles>
    <Style Selector="Border.step">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.step.active">
      <Setter Property="Background" Value="{DynamicResource TertiaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="Border.step TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Border.step.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
    </Style>
    <Style Selector="Border.tab.active">
      <Setter Property="Background" Value="{DynamicResource SurfaceContainerLowestBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <Style Selector="Button.TabButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,0,36,0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    
    <Style Selector="Button.TabCloseButton">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="30,32,*,28">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="12,0">
        <Menu VerticalAlignment="Center" Background="Transparent">
          <MenuItem Header="文件">
            <MenuItem Header="设置" Command="{Binding OpenSettingsCommand}" />
            <MenuItem Header="OCR 队列" Command="{Binding OpenOcrQueueCommand}" />
          </MenuItem>
          <MenuItem Header="编辑">
            <MenuItem Header="新建题录" Command="{Binding CreateItemMenuCommand}" />
            <MenuItem Header="查看 PDF" Command="{Binding ShowReadingCommand}" />
            <MenuItem Header="编辑题录" Command="{Binding EditSelectedItemCommand}" />
            <MenuItem Header="运行 MinerU OCR" Command="{Binding RunSelectedItemOcrCommand}" />
            <Separator />
            <MenuItem Header="重建 FTS 索引" Command="{Binding RebuildSearchIndexCommand}" />
            <MenuItem Header="导出证据 Markdown" Click="OnExportEvidenceMarkdownClick" />
          </MenuItem>
          <MenuItem Header="视图">
            <MenuItem Header="切换详情面板" Command="{Binding ToggleInspectorPaneCommand}" />
          </MenuItem>
          <MenuItem Header="帮助">
            <MenuItem Header="关于" Command="{Binding ShowAboutCommand}" />
          </MenuItem>
        </Menu>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBox Width="260" Height="24" FontSize="12" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource OutlineVariantBrush}" PlaceholderText="搜索文献库..." IsEnabled="{Binding IsSearchEnabled}" Text="{Binding SearchEvidence.Query}" VerticalContentAlignment="Center">
            <TextBox.InnerLeftContent>
              <lucide:Lucide Icon="Search" Width="12" Height="12" StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <Button Content="搜索" Command="{Binding RunToolbarSearchCommand}" Height="24" Background="{DynamicResource PrimaryContainerBrush}" Foreground="{DynamicResource OnPrimaryBrush}" Padding="8,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceContainerLowBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="0" Margin="12,0,0,0" VerticalAlignment="Stretch">
          <Border Classes="tab" Classes.active="{Binding IsFirstRunVisible}" Padding="16,0" IsVisible="{Binding IsFirstRunVisible}" VerticalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <lucide:Lucide Icon="Database" Width="12" Height="12" StrokeBrush="{DynamicResource PrimaryBrush}" />
              <TextBlock Text="初始化向导" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
            </StackPanel>
          </Border>

          <Border Classes="tab" Classes.active="{Binding IsLibraryTabActive}" IsVisible="{Binding IsLibraryVisible}" VerticalAlignment="Stretch">
            <Button Classes="TabButton" Padding="16,0" Command="{Binding ShowLibraryCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <lucide:Lucide Icon="Database" Width="12" Height="12" StrokeBrush="{DynamicResource PrimaryBrush}" />
                <TextBlock Text="{Binding LibraryTabTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Border>

          <Border Classes="tab" Classes.active="{Binding IsReaderTabActive}" IsVisible="{Binding ShowSelectedDocumentTab}" VerticalAlignment="Stretch">
            <Grid>
              <Button Classes="TabButton" Command="{Binding ShowReadingCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <lucide:Lucide Icon="FolderOpen" Width="12" Height="12" StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="{Binding PdfTabTitle}" Width="300" FontSize="13" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="TabCloseButton" Command="{Binding ClosePdfWorkspaceTabCommand}">
                <lucide:Lucide Icon="X" Width="12" Height="12" />
              </Button>
            </Grid>
          </Border>

          <Border Classes="tab" Classes.active="{Binding IsSearchVisible}" IsVisible="{Binding ShowSearchTab}" VerticalAlignment="Stretch">
            <Grid>
              <Button Classes="TabButton" Command="{Binding ActivateSearchTabCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <lucide:Lucide Icon="Search" Width="12" Height="12" StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="搜索结果" FontSize="13" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="TabCloseButton" Command="{Binding CloseSearchTabCommand}">
                <lucide:Lucide Icon="X" Width="12" Height="12" />
              </Button>
            </Grid>
          </Border>

          <Border Classes="tab" Classes.active="{Binding IsSettingsVisible}" IsVisible="{Binding ShowSettingsTab}" VerticalAlignment="Stretch">
            <Grid>
              <Button Classes="TabButton" Command="{Binding ActivateSettingsTabCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <lucide:Lucide Icon="Menu" Width="12" Height="12" StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="设置" FontSize="13" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="TabCloseButton" Command="{Binding CloseSettingsTabCommand}">
                <lucide:Lucide Icon="X" Width="12" Height="12" />
              </Button>
            </Grid>
          </Border>

          <Border Classes="tab" Classes.active="{Binding IsAboutTabActive}" IsVisible="{Binding ShowAboutTab}" VerticalAlignment="Stretch">
            <Grid>
              <Button Classes="TabButton" Command="{Binding ActivateAboutTabCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <lucide:Lucide Icon="Info" Width="12" Height="12" StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="关于" FontSize="13" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="TabCloseButton" Command="{Binding CloseAboutTabCommand}">
                <lucide:Lucide Icon="X" Width="12" Height="12" />
              </Button>
            </Grid>
          </Border>

          <Border Classes="tab" Classes.active="{Binding IsOcrQueueTabActive}" IsVisible="{Binding ShowOcrQueueTab}" VerticalAlignment="Stretch">
            <Grid>
              <Button Classes="TabButton" Command="{Binding ActivateOcrQueueTabCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <lucide:Lucide Icon="RefreshCw" Width="12" Height="12" StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="OCR 队列" FontSize="13" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="TabCloseButton" Command="{Binding CloseOcrQueueTabCommand}">
                <lucide:Lucide Icon="X" Width="12" Height="12" />
              </Button>
            </Grid>
          </Border>

          <Border Classes="tab" Classes.active="{Binding IsItemEditorTabActive}" IsVisible="{Binding ShowItemEditorTab}" VerticalAlignment="Stretch">
            <Grid>
              <Button Classes="TabButton" Command="{Binding OpenItemEditorCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <lucide:Lucide Icon="Plus" Width="12" Height="12" StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="{Binding ItemEditor.Header}" FontSize="13" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="TabCloseButton" Command="{Binding CloseItemEditorTabCommand}">
                <lucide:Lucide Icon="X" Width="12" Height="12" />
              </Button>
            </Grid>
          </Border>

          <Button Background="Transparent" BorderThickness="0" Padding="6" VerticalAlignment="Center" Margin="8,0" Command="{Binding CreateItemMenuCommand}">
            <lucide:Lucide Icon="Plus" Width="12" Height="12" StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" Background="{DynamicResource SurfaceBrush}">
      <views:FirstRunPage IsVisible="{Binding IsFirstRunVisible}" />
      <views:LibraryPage IsVisible="{Binding ShowLibraryPage}" />
      <views:PdfWorkspacePage IsVisible="{Binding ShowPdfWorkspacePage}" />
      <views:ItemEditorPage IsVisible="{Binding ShowItemEditorWorkspace}" />
      <views:SettingsPage IsVisible="{Binding ShowSettingsWorkspace}" />
      <views:SearchResultsPage IsVisible="{Binding ShowSearchWorkspace}" />
      <views:OcrQueuePage IsVisible="{Binding ShowOcrQueueWorkspace}" />
      <views:AboutPage IsVisible="{Binding ShowAboutWorkspace}" />
    </Grid>

    <Border Grid.Row="3" Background="{DynamicResource InverseSurfaceBrush}" Padding="12,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status}" FontSize="12" VerticalAlignment="Center">
          <TextBlock.Styles>
            <Style Selector="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource InverseOnSurfaceBrush}" />
            </Style>
            <Style Selector="TextBlock.error">
              <Setter Property="Foreground" Value="#ffdad6" />
            </Style>
          </TextBlock.Styles>
          <Classes.error>
            <MultiBinding Converter="{x:Static BoolConverters.Or}">
              <Binding Path="StatusIsError" />
            </MultiBinding>
          </Classes.error>
        </TextBlock>
        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="6,2" VerticalAlignment="Center">
          <Button.Styles>
            <Style Selector="FlyoutPresenter">
              <Setter Property="Background" Value="#2E2E2E" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="BorderBrush" Value="#444444" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="CornerRadius" Value="8" />
            </Style>
          </Button.Styles>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="{Binding McpStatusBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding McpStatusText}" FontSize="12" Foreground="{DynamicResource InverseOnSurfaceBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedRight" ShowMode="Standard">
              <Border Width="260" Padding="16">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="状态" FontSize="13" Foreground="#999999" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Ellipse Width="8" Height="8" Fill="{Binding McpStatusBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding McpStatusText}" FontSize="13" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="4">
                    <TextBlock Text="服务地址" FontSize="13" Foreground="#999999" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <TextBox Text="{Binding McpEndpoint}" IsReadOnly="True" Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#444444" Height="26" FontSize="12" VerticalContentAlignment="Center">
                        <TextBox.Styles>
                          <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                            <Setter Property="Background" Value="#1E1E1E" />
                            <Setter Property="BorderBrush" Value="#666666" />
                          </Style>
                          <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                            <Setter Property="Background" Value="#1E1E1E" />
                            <Setter Property="BorderBrush" Value="#555555" />
                          </Style>
                        </TextBox.Styles>
                      </TextBox>
                      <Button Grid.Column="1" Width="26" Height="26" Padding="0" Background="#3E3E3E" Click="OnCopyMcpAddressClick">
                        <lucide:Lucide Icon="Copy" Width="12" Height="12" StrokeBrush="#FFFFFF" />
                      </Button>
                    </Grid>
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="详情" FontSize="13" Foreground="#999999" />
                    <TextBlock Grid.Column="1" Text="{Binding McpStatusDetail}" FontSize="13" Foreground="#FFFFFF" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="150" />
                  </Grid>
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>

<Window x:Class="Patchouli.UI.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Patchouli.UI.Views"
        xmlns:local="using:Patchouli.UI.ViewModels"
        xmlns:settings="using:Patchouli.UI.ViewModels.Settings"
        xmlns:editor="using:Patchouli.UI.ViewModels.Editor"
        xmlns:agents="using:Patchouli.UI.ViewModels.Agents"
        xmlns:lucide="using:Patchouli.Lucide.Avalonia"
        xmlns:search="using:Patchouli.Core.Search"
        xmlns:controls="using:Patchouli.UI.Controls"
        x:DataType="local:MainWindowViewModel"
        Width="1280" Height="820" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Title="Patchouli.NET" Icon="/Assets/AppIcon.ico" Background="{DynamicResource SurfaceBrush}">

  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type local:LibraryShellViewModel}">
      <views:LibraryPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:PdfWorkspaceViewModel}">
      <views:PdfWorkspacePage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type editor:ItemEditorViewModel}">
      <!-- DataType="{x:Type local:ItemEditorViewModel}" -->
      <views:ItemEditorPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
      <views:SettingsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:SnapshotViewModel}">
      <views:SyncCenterPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:SearchEvidenceViewModel}">
      <views:SearchResultsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:OcrQueueViewModel}">
      <views:OcrQueuePage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type agents:AgentWorkspaceViewModel}">
      <views:AgentWorkspacePage />
    </DataTemplate>
    <!-- About tab content is AboutViewModel -->
    <DataTemplate DataType="{x:Type local:AboutViewModel}">
      <views:AboutPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ChangelogViewModel}">
      <views:ChangelogPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ExtensionManagerViewModel}">
      <views:ExtensionManagerPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:PluginViewViewModel}">
      <views:PluginViewPage />
    </DataTemplate>
  </Window.DataTemplates>

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="StatusErrorBrush" Color="#ffdad6" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark" />
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Menu.toolbar > MenuItem">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.statusBar">
      <Setter Property="Foreground" Value="{DynamicResource InverseOnSurfaceBrush}" />
    </Style>
    <Style Selector="TextBlock.statusBar.error">
      <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
    </Style>
    <Style Selector="ToggleButton#ToolbarSearchFilterButton">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ToggleButton#ToolbarSearchFilterButton.hasActiveFilters">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

  </Window.Styles>

  <Grid RowDefinitions="30,*,28">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="12,0">
        <Menu Classes="toolbar" VerticalAlignment="Center" Background="Transparent">
          <MenuItem Header="书库">
            <MenuItem Header="打开其他书库…" Command="{Binding OpenOtherLibraryCommand}" />
            <MenuItem Header="任务队列" Command="{Binding OpenOcrQueueCommand}" />
            <Separator />
            <MenuItem Header="侧边栏">
              <MenuItem Header="左侧边栏" ToggleType="CheckBox"
                        IsChecked="{Binding ShowLibraryLeftSidebarPreference, Mode=TwoWay}" />
              <MenuItem Header="右侧边栏" ToggleType="CheckBox"
                        IsChecked="{Binding ShowLibraryRightSidebarPreference, Mode=TwoWay}" />
            </MenuItem>
            <MenuItem Header="书库列">
              <MenuItem Header="题录类型" ToggleType="CheckBox" IsChecked="{Binding Shell.ShowItemTypeColumn, Mode=TwoWay}" />
              <MenuItem Header="年份" ToggleType="CheckBox" IsChecked="{Binding Shell.ShowYearColumn, Mode=TwoWay}" />
              <MenuItem Header="作者" ToggleType="CheckBox" IsChecked="{Binding Shell.ShowAuthorColumn, Mode=TwoWay}" />
              <MenuItem Header="标题" ToggleType="CheckBox" IsChecked="{Binding Shell.ShowTitleColumn, Mode=TwoWay}" />
              <MenuItem Header="来源" ToggleType="CheckBox" IsChecked="{Binding Shell.ShowSourceColumn, Mode=TwoWay}" />
              <MenuItem Header="OCR/索引状态" ToggleType="CheckBox"
                        IsChecked="{Binding Shell.ShowStatusColumn, Mode=TwoWay}" />
              <MenuItem Header="页数" ToggleType="CheckBox" IsChecked="{Binding Shell.ShowPagesColumn, Mode=TwoWay}" />
              <MenuItem Header="关联文件" ToggleType="CheckBox" IsChecked="{Binding Shell.ShowFileColumn, Mode=TwoWay}" />
            </MenuItem>
          </MenuItem>
          <MenuItem Header="同步">
            <MenuItem Header="{Binding CheckSyncStateDescriptor.Label}" Command="{Binding CheckSyncStateDescriptor}"
                      ToolTip.Tip="{Binding CheckSyncStateDescriptor.DisabledReason}" />
            <MenuItem Header="{Binding PublishSnapshotDescriptor.Label}" Command="{Binding PublishSnapshotDescriptor}"
                      ToolTip.Tip="{Binding PublishSnapshotDescriptor.DisabledReason}" />
            <MenuItem Header="{Binding ReceiveSnapshotDescriptor.Label}" Command="{Binding ReceiveSnapshotDescriptor}"
                      ToolTip.Tip="{Binding ReceiveSnapshotDescriptor.DisabledReason}" />
            <MenuItem Header="{Binding ExportSnapshotPackageDescriptor.Label}"
                      Command="{Binding ExportSnapshotPackageDescriptor}"
                      ToolTip.Tip="{Binding ExportSnapshotPackageDescriptor.DisabledReason}" />
            <MenuItem Header="{Binding OpenSnapshotPackageDescriptor.Label}"
                      Command="{Binding OpenSnapshotPackageDescriptor}"
                      ToolTip.Tip="{Binding OpenSnapshotPackageDescriptor.DisabledReason}" />
          </MenuItem>
          <MenuItem Header="题录"
                    DataContext="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).Shell, FallbackValue={x:Null}}"
                    x:DataType="local:LibraryShellViewModel">
            <MenuItem Header="新建题录" Command="{Binding CreateItemMenuCommand}" />
            <MenuItem Header="编辑元数据" Command="{Binding EditSelectedItemCommand}"
                      IsEnabled="{Binding IsSingleSelectionOrNone}"
                      IsVisible="{Binding Sidebar.IsActiveSelected}" />
            <MenuItem Header="合并题录" Command="{Binding MergeSelectedItemsCommand}"
                      IsEnabled="{Binding CanMergeSelectedItems}"
                      IsVisible="{Binding Sidebar.IsActiveSelected}" />
            <MenuItem Header="检测重复题录"
                      Command="{Binding DetectDuplicatesCommand}"
                      IsVisible="{Binding Sidebar.IsActiveSelected}" />
            <MenuItem Header="获取所选题录元数据"
                      Command="{Binding LookupMetadataBatchCommand}"
                      IsEnabled="{Binding HasBatchSelection}"
                      IsVisible="{Binding Sidebar.IsActiveSelected}" />
            <MenuItem Header="取消批量获取元数据"
                      Command="{Binding CancelMetadataBatchCommand}"
                      IsVisible="{Binding IsMetadataBatchBusy}" />
            <MenuItem Header="打开文档" Command="{Binding ShowReadingCommand}"
                      IsVisible="{Binding Sidebar.IsActiveSelected}" />
            <MenuItem Header="运行 OCR" Command="{Binding RunSelectedItemOcrCommand}"
                      IsVisible="{Binding Sidebar.IsActiveSelected}" />
            <MenuItem Header="添加到集合" IsVisible="{Binding Sidebar.IsActiveSelected}"
                      IsEnabled="{Binding HasCollections}" ItemsSource="{Binding CollectionContextItems}"
                      x:CompileBindings="False">
              <MenuItem.ItemTemplate>
                <DataTemplate x:DataType="local:CollectionListItemViewModel">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </MenuItem.ItemTemplate>
              <MenuItem.Styles>
                <Style Selector="MenuItem MenuItem">
                  <Setter Property="ToggleType" Value="CheckBox" />
                  <Setter Property="IsChecked" Value="{Binding ContainsSelection, Mode=OneWay}" />
                  <Setter Property="Command" Value="{Binding AddToSelectionCommand}" />
                </Style>
              </MenuItem.Styles>
            </MenuItem>
            <MenuItem Header="从当前集合移除"
                      Command="{Binding RemoveSelectedItemsFromCurrentCollectionCommand}"
                      IsVisible="{Binding HasSelectedCollectionFilter}" />
            <MenuItem Header="{Binding CopyCslBibliographyDescriptor.Label}"
                      Command="{Binding CopyCslBibliographyDescriptor}"
                      ToolTip.Tip="{Binding CopyCslBibliographyDescriptor.DisabledReason}"
                      IsVisible="{Binding Sidebar.IsActiveSelected}" />
            <MenuItem Header="删除" Command="{Binding DeleteSelectedItemsCommand}"
                      IsVisible="{Binding Sidebar.IsActiveSelected}" />
            <MenuItem Header="还原" Command="{Binding RestoreSelectedItemsCommand}"
                      IsVisible="{Binding Sidebar.IsTrashSelected}" />
            <MenuItem Header="永久删除" Command="{Binding PurgeSelectedItemsCommand}"
                      IsVisible="{Binding Sidebar.IsTrashSelected}" />
            <Separator />
            <MenuItem Header="{Binding ImportBiblatexBatchDescriptor.Label}"
                      Command="{Binding ImportBiblatexBatchDescriptor}" />
            <MenuItem Header="{Binding ExportBiblatexDescriptor.Label}" Command="{Binding ExportBiblatexDescriptor}"
                      IsVisible="{Binding Sidebar.IsActiveSelected}" />
            <MenuItem Header="{Binding CopyBiblatexDescriptor.Label}" Command="{Binding CopyBiblatexDescriptor}"
                      IsVisible="{Binding Sidebar.IsActiveSelected}" />
            <MenuItem Header="管理 CSL 样式" Command="{Binding OpenCslStyleManagerCommand}" />
          </MenuItem>
          <MenuItem Header="文献加工" SubmenuOpened="OnOcrMenuOpened">
            <MenuItem Header="运行 OCR" Command="{Binding RunSelectedItemOcrCommand}"
                      IsVisible="{Binding Shell.CanModifyLibraryItems}" />
            <MenuItem Header="快速补全 OCR" Command="{Binding Shell.QuickFillOcrCommand}"
                      IsVisible="{Binding Shell.CanModifyLibraryItems}" />
            <MenuItem Header="选择 OCR 预设">
              <MenuItem Header="文档级" Classes="ocrPresetScope"
                        ItemsSource="{Binding DocumentOcrPresetMenuEntries}"
                        x:CompileBindings="False">
                <MenuItem.ItemTemplate>
                  <DataTemplate x:DataType="local:OcrPresetMenuEntryViewModel">
                    <TextBlock Text="{Binding Header}" />
                  </DataTemplate>
                </MenuItem.ItemTemplate>
                <MenuItem.Styles>
                  <Style Selector="MenuItem.ocrPresetScope > MenuItem">
                    <Setter Property="ToggleType" Value="Radio" />
                    <Setter Property="GroupName" Value="OcrPresetScope1" />
                    <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                    <Setter Property="Command" Value="{Binding SelectCommand}" />
                  </Style>
                </MenuItem.Styles>
              </MenuItem>
              <MenuItem Header="页面级" Classes="ocrPresetScope"
                        ItemsSource="{Binding PageOcrPresetMenuEntries}"
                        x:CompileBindings="False">
                <MenuItem.ItemTemplate>
                  <DataTemplate x:DataType="local:OcrPresetMenuEntryViewModel">
                    <TextBlock Text="{Binding Header}" />
                  </DataTemplate>
                </MenuItem.ItemTemplate>
                <MenuItem.Styles>
                  <Style Selector="MenuItem.ocrPresetScope > MenuItem">
                    <Setter Property="ToggleType" Value="Radio" />
                    <Setter Property="GroupName" Value="OcrPresetScope2" />
                    <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                    <Setter Property="Command" Value="{Binding SelectCommand}" />
                  </Style>
                </MenuItem.Styles>
              </MenuItem>
              <MenuItem Header="区域级" Classes="ocrPresetScope"
                        ItemsSource="{Binding RegionOcrPresetMenuEntries}"
                        x:CompileBindings="False">
                <MenuItem.ItemTemplate>
                  <DataTemplate x:DataType="local:OcrPresetMenuEntryViewModel">
                    <TextBlock Text="{Binding Header}" />
                  </DataTemplate>
                </MenuItem.ItemTemplate>
                <MenuItem.Styles>
                  <Style Selector="MenuItem.ocrPresetScope > MenuItem">
                    <Setter Property="ToggleType" Value="Radio" />
                    <Setter Property="GroupName" Value="OcrPresetScope3" />
                    <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                    <Setter Property="Command" Value="{Binding SelectCommand}" />
                  </Style>
                </MenuItem.Styles>
              </MenuItem>
            </MenuItem>
            <Separator />
            <MenuItem Header="全文翻译" Command="{Binding StartFullTranslationCommand}"
                      IsVisible="{Binding Shell.CanModifyLibraryItems}"
                      ToolTip.Tip="翻译当前所选题录主文档的全部页面" />
            <MenuItem Header="切换翻译引擎" Classes="translationEngine"
                      ItemsSource="{Binding TranslationEngineMenuEntries}"
                      x:CompileBindings="False">
              <MenuItem.ItemTemplate>
                <DataTemplate x:DataType="local:TranslationEngineMenuEntryViewModel">
                  <TextBlock Text="{Binding Header}" />
                </DataTemplate>
              </MenuItem.ItemTemplate>
              <MenuItem.Styles>
                <Style Selector="MenuItem.translationEngine > MenuItem">
                  <Setter Property="ToggleType" Value="Radio" />
                  <Setter Property="GroupName" Value="TranslationEngineGroup" />
                  <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                  <Setter Property="Command" Value="{Binding SelectCommand}" />
                </Style>
              </MenuItem.Styles>
            </MenuItem>
            <Separator />
            <MenuItem Header="文献加工设置" Command="{Binding OpenProcessingSettingsCommand}" />
          </MenuItem>
          <MenuItem Header="搜索">
            <MenuItem Header="启用查询重写" ToggleType="CheckBox"
                      IsChecked="{Binding QueryRewriteEnabled, Mode=TwoWay}"
                      IsEnabled="{Binding HasOpenRuntimeDatabase}" />
            <MenuItem Header="搜索重写设置…" Command="{Binding OpenSearchRewriteSettingsCommand}" />
            <Separator />
            <MenuItem Header="重建 FTS 索引" Command="{Binding RebuildSearchIndexCommand}" />
          </MenuItem>
          <MenuItem Header="AI集成">
            <MenuItem Header="{Binding ToggleMcpServerLabel}" Command="{Binding ToggleMcpServerCommand}" />
            <MenuItem Header="AI集成设置" Command="{Binding OpenMcpSettingsCommand}" />
            <Separator />
            <MenuItem Header="Agent 集成" Command="{Binding OpenAgentTabCommand}" />
          </MenuItem>
          <MenuItem Header="扩展功能" SubmenuOpened="OnExtensionMenuOpened" Classes="extensionMenu"
                    ItemsSource="{Binding ExtensionMenuEntries}" x:CompileBindings="False">
            <MenuItem.ItemTemplate>
              <DataTemplate x:DataType="local:ExtensionMenuEntryViewModel">
                <TextBlock Text="{Binding Header}" />
              </DataTemplate>
            </MenuItem.ItemTemplate>
            <MenuItem.Styles>
              <Style Selector="MenuItem.extensionMenu MenuItem">
                <Setter Property="Command" Value="{Binding OpenCommand}" />
              </Style>
            </MenuItem.Styles>
          </MenuItem>
          <MenuItem Header="设置">
            <MenuItem Header="全局设置" Command="{Binding OpenSettingsCommand}" />
            <MenuItem Header="检查更新" Command="{Binding CheckForUpdatesCommand}" />
            <MenuItem Header="更新日志" Command="{Binding ShowChangelogCommand}" />
            <MenuItem Header="关于" Command="{Binding ShowAboutCommand}" />
          </MenuItem>
        </Menu>
        <StackPanel x:Name="ToolbarSearchPanel" Grid.Column="1" Orientation="Horizontal"
                    Spacing="0" VerticalAlignment="Center">
          <Menu Classes="toolbar" Height="24" Background="Transparent" FontSize="12">
            <MenuItem ToolTip.Tip="{Binding ToolbarSearchMode.Hint}">
              <MenuItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding ToolbarSearchMode.Label}" VerticalAlignment="Center" />
                  <lucide:Lucide Icon="ChevronDown" Width="14" Height="14" VerticalAlignment="Center" />
                </StackPanel>
              </MenuItem.Header>
              <MenuItem Header="{Binding ToolbarSearchModeOptions[0].Label}" ToggleType="Radio"
                        GroupName="ToolbarSearchMode"
                        IsChecked="{Binding IsToolbarBibliographicSearch, Mode=OneWay}"
                        Command="{Binding SelectToolbarSearchModeCommand}"
                        CommandParameter="{Binding ToolbarSearchModeOptions[0]}" />
              <MenuItem Header="{Binding ToolbarSearchModeOptions[1].Label}" ToggleType="Radio"
                        GroupName="ToolbarSearchMode"
                        IsChecked="{Binding IsToolbarFullTextSearch, Mode=OneWay}"
                        Command="{Binding SelectToolbarSearchModeCommand}"
                        CommandParameter="{Binding ToolbarSearchModeOptions[1]}" />
              <MenuItem Header="{Binding ToolbarSearchModeOptions[2].Label}" ToggleType="Radio"
                        x:Name="ToolbarDocumentSearchMenuItem" IsVisible="{Binding IsToolbarDocumentSearchAvailable}"
                        GroupName="ToolbarSearchMode"
                        IsChecked="{Binding IsToolbarDocumentFullTextSearch, Mode=OneWay}"
                        Command="{Binding SelectToolbarSearchModeCommand}"
                        CommandParameter="{Binding ToolbarSearchModeOptions[2]}" />
              <Separator />
              <MenuItem x:Name="ToolbarPageAwareMenuItem" Header="页面感知" ToggleType="CheckBox"
                        IsChecked="{Binding IsToolbarSearchPageAware, Mode=TwoWay}" />
            </MenuItem>
          </Menu>
          <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource OutlineVariantBrush}"
                  Height="24" VerticalAlignment="Center" />
          <TextBox Width="220" Height="24" FontSize="12" CornerRadius="0" BorderThickness="0"
                   Background="Transparent"
                   PlaceholderText="搜索"
                   IsEnabled="{Binding IsSearchEnabled}" Text="{Binding ToolbarSearchQuery}"
                   VerticalContentAlignment="Center" KeyDown="OnToolbarSearchKeyDown">
            <TextBox.InnerLeftContent>
              <lucide:Lucide Icon="Search" Width="12" Height="12" StrokeBrush="{DynamicResource OnSurfaceVariantBrush}"
                             Margin="6,0,0,0" VerticalAlignment="Center" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <Button Command="{Binding RunToolbarSearchCommand}" Height="24" Width="28"
                  IsEnabled="{Binding IsSearchEnabled}"
                  ToolTip.Tip="搜索" Background="Transparent" BorderThickness="0" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <lucide:Lucide Icon="Search" Width="13" Height="13" StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
          </Button>
          <ToggleButton x:Name="ToolbarSearchFilterButton" Height="24" Width="28"
                        IsChecked="{Binding IsToolbarSearchFilterOpen, Mode=TwoWay}"
                        IsVisible="{Binding !IsToolbarDocumentFullTextSearch}" IsEnabled="{Binding IsSearchEnabled}"
                        ToolTip.Tip="筛选条件" AutomationProperties.Name="筛选条件"
                        Classes.hasActiveFilters="{Binding SearchFilters.HasActiveFilters}"
                        Background="Transparent" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        KeyDown="OnToolbarSearchFilterKeyDown">
            <lucide:Lucide Icon="Filter" Width="13" Height="13" StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
          </ToggleButton>
          <Popup x:Name="ToolbarSearchFilterPopup" IsOpen="{Binding IsToolbarSearchFilterOpen, Mode=TwoWay}"
                 PlacementTarget="{Binding #ToolbarSearchPanel}" Placement="BottomEdgeAlignedRight" VerticalOffset="4"
                 ShouldUseOverlayLayer="True" IsLightDismissEnabled="True" OverlayDismissEventPassThrough="True"
                 OverlayInputPassThroughElement="{Binding #ToolbarSearchFilterButton}"
                 Opened="OnToolbarSearchFilterOpened">
            <Border Width="408" Padding="10" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource OutlineVariantBrush}"
                    Background="{DynamicResource SurfaceContainerLowestBrush}" BoxShadow="0 4 16 #33000000"
                    KeyDown="OnToolbarSearchFilterKeyDown">
              <Grid RowDefinitions="Auto,Auto">
                <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <ItemsControl ItemsSource="{Binding SearchFilters.FilterRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:SearchFilterRowViewModel">
                          <Grid ColumnDefinitions="30,120,*" ColumnSpacing="6" Margin="0,0,0,6">
                            <Button Command="{Binding RemoveCommand}" ToolTip.Tip="删除筛选条件"
                                    AutomationProperties.Name="删除筛选条件" Width="30" Height="30"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                              <lucide:Lucide Icon="Trash2" Width="13" Height="13"
                                             StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
                            </Button>
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static local:SearchFilterKeyOption.All}"
                                      SelectedItem="{Binding Key}" FontSize="12" MinHeight="30"
                                      HorizontalAlignment="Stretch" AutomationProperties.Name="筛选字段"
                                      IsVisible="{Binding !IsReadOnly}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="local:SearchFilterKeyOption">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Column="1" Text="{Binding Key.Label}" FontSize="12" MinHeight="30"
                                       VerticalAlignment="Center" Margin="12,0" IsVisible="{Binding IsReadOnly}" />
                            <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" MinHeight="30" VerticalContentAlignment="Center"
                                     IsVisible="{Binding IsTextKey}" AutomationProperties.Name="{Binding Key.Label}"
                                     KeyDown="OnToolbarSearchKeyDown" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableValues}"
                                      SelectedValue="{Binding Value}" SelectedValueBinding="{Binding Value}"
                                      FontSize="12" MinHeight="30" HorizontalAlignment="Stretch"
                                      IsVisible="{Binding IsChoiceKey}" AutomationProperties.Name="{Binding Key.Label}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="search:SearchFilterOption">
                                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="{Binding DisplayValue}" FontSize="12" MinHeight="30"
                                       VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding DisplayValue}" IsVisible="{Binding IsReadOnly}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
                <Button Grid.Row="1" Command="{Binding SearchFilters.AddFilterRowCommand}" Height="30"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <lucide:Lucide Icon="Plus" Width="12" Height="12" VerticalAlignment="Center"
                                   StrokeBrush="{DynamicResource OnSurfaceBrush}" />
                    <TextBlock Text="添加筛选条件" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
          </Popup>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" RowDefinitions="Auto,*" Background="{DynamicResource SurfaceContainerLowestBrush}">
      <TabStrip Grid.Row="0" ItemsSource="{Binding Layout.Tabs}" SelectedItem="{Binding Layout.ActiveTab}" Padding="0">
        <TabStrip.ItemTemplate>
          <DataTemplate DataType="{x:Type local:WorkspaceTabViewModel}">
            <Grid>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,24,0">
                <lucide:Lucide Icon="{Binding IconName}" Width="12" Height="12"
                               StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                           VerticalAlignment="Center" />
              </StackPanel>
              <Button Command="{Binding CloseCommand}" IsVisible="{Binding IsClosable}"
                      Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,-8,0"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <lucide:Lucide Icon="X" Width="12" Height="12" StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
              </Button>
            </Grid>
          </DataTemplate>
        </TabStrip.ItemTemplate>
      </TabStrip>
      <controls:WorkspaceTabContentHost Grid.Row="1" ItemsSource="{Binding Layout.Tabs}"
                                        ActiveTab="{Binding Layout.ActiveTab}" />

      <views:FirstRunPage Grid.Row="1" IsVisible="{Binding IsFirstRunVisible}" ZIndex="10" />
      <views:StartupLoadingPage Grid.Row="1" IsVisible="{Binding IsStartupLoadingVisible}" ZIndex="20" />
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource InverseSurfaceBrush}" Padding="12,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0" Classes="statusBar" Command="{Binding OpenOcrQueueCommand}"
                Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"
                AutomationProperties.Name="打开任务队列">
          <controls:CatStatusIndicator x:Name="CatIndicator"
                                       IsBusy="{Binding IsActivityBusy}"
                                       ActivitySummary="{Binding ActivitySummary}"
                                       SleepReason="{Binding ActivityReason}"
                                       StatusText="{Binding ActivityDescription}"
                                       Foreground="{DynamicResource InverseOnSurfaceBrush}" />
        </Button>
        <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="statusBar" FontSize="12" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}">
          <Classes.error>
            <MultiBinding Converter="{x:Static BoolConverters.Or}">
              <Binding Path="StatusIsError" />
            </MultiBinding>
          </Classes.error>
        </TextBlock>
        <Button Grid.Column="2" Classes="statusBar" Padding="6,2" VerticalAlignment="Center">
          <Button.Styles>
            <Style Selector="FlyoutPresenter">
              <Setter Property="Background" Value="#2E2E2E" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="BorderBrush" Value="#444444" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="CornerRadius" Value="8" />
            </Style>
          </Button.Styles>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="{Binding McpStatusBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding McpStatusText}" FontSize="12"
                       Foreground="{DynamicResource InverseOnSurfaceBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedRight" ShowMode="Standard">
              <Border Width="260" Padding="16">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="状态" FontSize="13" Foreground="#999999" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Ellipse Width="8" Height="8" Fill="{Binding McpStatusBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding McpStatusText}" FontSize="13" Foreground="#FFFFFF"
                                 FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="4">
                    <TextBlock Text="服务地址" FontSize="13" Foreground="#999999" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <TextBox Text="{Binding McpEndpoint}" IsReadOnly="True" Background="#1E1E1E" Foreground="#FFFFFF"
                               BorderBrush="#444444" Height="26" FontSize="12" VerticalContentAlignment="Center">
                        <TextBox.Styles>
                          <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                            <Setter Property="Background" Value="#1E1E1E" />
                            <Setter Property="BorderBrush" Value="#666666" />
                          </Style>
                          <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                            <Setter Property="Background" Value="#1E1E1E" />
                            <Setter Property="BorderBrush" Value="#555555" />
                          </Style>
                        </TextBox.Styles>
                      </TextBox>
                      <Button Grid.Column="1" Classes="mcpPopupAction" Width="26" Height="26" Padding="0"
                              ToolTip.Tip="复制服务地址"
                              Click="OnCopyMcpAddressClick">
                        <lucide:Lucide Icon="Copy" Width="12" Height="12" StrokeBrush="#FFFFFF" />
                      </Button>
                    </Grid>
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="详情" FontSize="13" Foreground="#999999" />
                    <TextBlock Grid.Column="1" Text="{Binding McpStatusDetail}" FontSize="13" Foreground="#FFFFFF"
                               FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="150" />
                  </Grid>
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>

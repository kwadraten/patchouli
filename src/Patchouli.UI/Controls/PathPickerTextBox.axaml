<UserControl x:Class="Patchouli.UI.Controls.PathPickerTextBox"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
    <TextBox Text="{Binding Path, ElementName=Root}" PlaceholderText="{Binding PlaceholderText, ElementName=Root}" Height="32" VerticalContentAlignment="Center" />
    <Button Grid.Column="1" Click="OnBrowseClick" Height="32" Width="40" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
      <PathIcon Data="{Binding IconData, ElementName=Root}" Width="16" Height="16" Foreground="{DynamicResource OnSurfaceBrush}" />
    </Button>
  </Grid>
</UserControl>

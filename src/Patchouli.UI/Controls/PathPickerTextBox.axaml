<UserControl x:Class="Patchouli.UI.Controls.PathPickerTextBox"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
    <TextBox Classes="FormField" Text="{Binding Path, ElementName=Root}"
             PlaceholderText="{Binding PlaceholderText, ElementName=Root}" IsReadOnly="True" />
    <Button Classes="FormFieldAction" Grid.Column="1" Click="OnBrowseClick" Width="54" Padding="0">
      <PathIcon Data="{Binding IconData, ElementName=Root}" Width="16" Height="16"
                Foreground="{DynamicResource OnSurfaceBrush}" />
    </Button>
  </Grid>
</UserControl>

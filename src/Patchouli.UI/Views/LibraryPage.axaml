<UserControl x:Class="Patchouli.UI.Views.LibraryPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid ColumnDefinitions="Auto,*,Auto" Background="{DynamicResource SurfaceBrush}">
<Border Grid.Column="0" Width="260" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,1,0" IsVisible="{Binding ShowSidebar}">
  <Grid>
    <!-- 1. Library Sidebar (Visible when library is visible) -->
    <Border Background="{DynamicResource SurfaceContainerLowBrush}" IsVisible="{Binding IsLibraryVisible}">
      <Grid RowDefinitions="*,Auto" Margin="0,10,0,0">
        <ScrollViewer>
          <StackPanel Spacing="16">
            <!-- Main navigation -->
            <StackPanel Spacing="2">
              <!-- 我的书库 (Selected/Plank style) -->
              <Border Background="{DynamicResource TertiaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="3,0,0,0" Padding="16,8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Data="{StaticResource IconDatabase}" Width="13" Height="13" Foreground="{DynamicResource PrimaryBrush}" />
                  <TextBlock Text="我的书库" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <Separator Height="1" Background="{DynamicResource OutlineVariantBrush}" Margin="16,0" />

            <!-- 数据库路径 -->
            <StackPanel Spacing="8" Margin="16,0">
              <TextBlock Text="数据库路径" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding RuntimeDatabasePath}" FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RuntimeDatabasePath}" />
                </Grid>
              </StackPanel>
            </StackPanel>

            <!-- 同步根目录 -->
            <StackPanel Spacing="8" Margin="16,0">
              <TextBlock Text="同步根目录" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <PathIcon Data="{StaticResource IconCloud}" Width="13" Height="13" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding DefaultSyncRootPath}" FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DefaultSyncRootPath}" />
                </Grid>
              </StackPanel>
            </StackPanel>

            <!-- FileSearchRoot -->
            <StackPanel Spacing="8" Margin="16,0">
              <TextBlock Text="文件搜索根" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
              <TextBlock Text="暂无" FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" IsVisible="{Binding NoFileSearchRoots}" />
              <ItemsControl ItemsSource="{Binding FileSearchRoots}" IsVisible="{Binding HasFileSearchRoots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,8">
                      <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding RootPath}" FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RootPath}" />
                        <WrapPanel>
                          <TextBlock Text="{Binding AvailabilityText}" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,10,0" />
                          <TextBlock Text="{Binding FileCountText}" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,10,0" />
                          <TextBlock Text="{Binding UpdatedAtText}" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                        </WrapPanel>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Border>
<Grid Grid.Column="1" RowDefinitions="44,*">
  <!-- Header -->
  <Border BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="16,0" Background="{DynamicResource SurfaceContainerLowestBrush}">
    <Grid ColumnDefinitions="48,*,200,100,150" ColumnSpacing="12" VerticalAlignment="Center">
      <TextBlock Grid.Column="1" Text="标题" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
      <TextBlock Grid.Column="2" Text="作者" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
      <TextBlock Grid.Column="3" Text="出版日期" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
      <TextBlock Grid.Column="4" Text="文献来源" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
    </Grid>
  </Border>

  <!-- List of Bibliographies -->
  <ListBox Grid.Row="1" ItemsSource="{Binding Shell.Items}" SelectedItem="{Binding Shell.SelectedItem}" BorderThickness="0" Background="{DynamicResource SurfaceContainerLowestBrush}" DoubleTapped="OnListBoxDoubleTapped">
    <ListBox.Styles>
      <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
      </Style>
    </ListBox.Styles>
    <ListBox.ItemTemplate>
      <DataTemplate>
        <Border BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="16,8" Background="Transparent">
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem Header="编辑题录信息" Command="{Binding EditMetadataCommand}" />
              <MenuItem Header="运行 MinerU OCR" Command="{Binding RunOcrCommand}" />
            </ContextMenu>
          </Border.ContextMenu>
          <Grid ColumnDefinitions="48,*,200,100,150" ColumnSpacing="12">
            <!-- PDF Icon Badge -->
            <Border Width="28" Height="18" Background="{DynamicResource TertiaryBrush}" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="PDF" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Authors}" FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="3" Text="{Binding Year}" FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="{Binding PublicationTitle}" FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</Grid>
<!-- Column 2: Details Inspector (Width 340 when visible) -->
<Border Grid.Column="2" Width="340" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1,0,0,0" IsVisible="{Binding IsInspectorVisible}">
  <!-- Visible when not reading mode -->
  <Grid DataContext="{Binding Shell}" RowDefinitions="40,*" IsVisible="{Binding ShowLibraryList}">
    <Border BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource SurfaceContainerLowBrush}">
      <TextBlock Text="详情" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceContainerLowBrush}">
      <ScrollViewer>
        <StackPanel Margin="18" Spacing="14">
          <!-- Book Title -->
          <TextBlock Text="{Binding InspectorTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding InspectorSubtitle}" FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />

          <!-- Empty state -->
          <StackPanel IsVisible="{Binding NoSelectedItem}" Spacing="6" Margin="0,20">
            <TextBlock Text="未选择题录" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}" />
            <TextBlock Text="选择一个已导入题录以查看 OCR/索引状态。" FontSize="13" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Selected state -->
          <StackPanel IsVisible="{Binding HasSelectedItem}" Spacing="16">
            <!-- Metadata Table Grid -->
            <Border Background="{DynamicResource SurfaceContainerLowestBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="80,*" RowSpacing="10">
                <!-- Row 0: Item Type -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="条目类型" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.ItemType}" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />

                <!-- Row 1: Authors -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="作者" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.Authors}" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />

                <!-- Row 2: Year -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="年份" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.Year}" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center" />

                <!-- Row 3: Publication -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="期刊/出处" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.PublicationTitle}" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />

                <!-- Row 4: OCR Status -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="OCR/索引" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InspectorStatus}" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />

                <!-- Row 5: File Name -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="关联文件" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedItem.FileName}" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <!-- Metadata Editor Inline Popup -->
            <Border BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" Background="{DynamicResource SurfaceContainerLowestBrush}" CornerRadius="4" Padding="12" IsVisible="{Binding ShowMetadataEditor}">
              <StackPanel Spacing="10">
                <TextBlock Text="编辑题录信息" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                <TextBox PlaceholderText="标题" Text="{Binding EditTitle}" Height="30" VerticalContentAlignment="Center" />
                <TextBox PlaceholderText="作者" Text="{Binding EditAuthors}" Height="30" VerticalContentAlignment="Center" />
                <TextBox PlaceholderText="年份" Text="{Binding EditYear}" Height="30" VerticalContentAlignment="Center" />
                <TextBox PlaceholderText="期刊/出处" Text="{Binding EditPublicationTitle}" Height="30" VerticalContentAlignment="Center" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Content="保存" Command="{Binding SaveMetadataCommand}" Background="{DynamicResource PrimaryContainerBrush}" Foreground="{DynamicResource OnPrimaryBrush}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="30" />
                  <Button Content="取消" Command="{Binding CancelMetadataEditCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="30" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Giant Edit Metadata Button -->
            <Button Content="编辑元数据" Command="{Binding SelectedItem.EditMetadataCommand}" Background="{DynamicResource PrimaryContainerBrush}" Foreground="{DynamicResource OnPrimaryBrush}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36" CornerRadius="4" Margin="0,10,0,0" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Border>
  </Grid>
</UserControl>

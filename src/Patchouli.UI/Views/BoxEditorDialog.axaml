<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Patchouli.UI.ViewModels"
        xmlns:rte="using:AvaloniaRichEditor.Controls"
        xmlns:lucide="using:Patchouli.Lucide.Avalonia"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="Patchouli.UI.Views.BoxEditorDialog"
        x:DataType="vm:PdfBBoxViewModel"
        Title="编辑边界框"
        Icon="/Assets/AppIcon.ico"
        Width="900" Height="700"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        WindowDecorations="Full"
        Background="{DynamicResource SurfaceBrush}">

  <Window.Styles>
    <Style Selector="Button.IconButton">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.IconButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighestBrush}" />
    </Style>
    <Style Selector="Button.IconButton:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
  </Window.Styles>

  <Border Padding="16">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
      <TextBlock x:Name="TableEditorError" Grid.Row="0" IsVisible="False" TextWrapping="Wrap"
                 Foreground="{DynamicResource ErrorBrush}" />
      <Border Grid.Row="1" IsVisible="{Binding Workspace.HasCandidate}" Padding="10" CornerRadius="6"
              BorderThickness="1"
              BorderBrush="{DynamicResource OutlineVariantBrush}">
        <StackPanel Spacing="6">
          <TextBlock Text="局部 OCR 候选（接受后覆盖类型与内容）" FontWeight="SemiBold"
                     FontSize="12" />
          <TextBlock Text="原内容" FontSize="11"
                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />
          <TextBlock Text="{Binding Workspace.LocalOcrSourceText}" TextWrapping="Wrap"
                     FontSize="12" MaxHeight="80" />
          <TextBlock Text="识别内容" FontSize="11"
                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />
          <ItemsControl ItemsSource="{Binding Workspace.CandidateBoxes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PdfBBoxViewModel">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Text="{Binding BoxType}" FontWeight="SemiBold"
                             FontSize="12" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                             FontSize="12" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="拒绝" Command="{Binding Workspace.RejectLocalOcrCommand}" />
            <Button Content="接受" Click="OnAcceptClicked" />
          </StackPanel>
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="2" Spacing="8">
        <ComboBox ItemsSource="{Binding Workspace.EditableBoxTypeOptions}"
                  SelectedItem="{Binding BoxType}" SelectionChanged="OnBoxTypeChanged"
                  HorizontalAlignment="Stretch" />
        <NumericUpDown Value="{Binding HeadingLevel}" Minimum="1" Maximum="6"
                       IsVisible="{Binding IsTitle}" PlaceholderText="标题级别 1-6" />
        <TextBox Text="{Binding CodeLanguage}" IsVisible="{Binding IsCode}"
                 PlaceholderText="代码语言（可选）" />
        <TextBox Text="{Binding AssetId}" IsVisible="{Binding IsMedia}"
                 PlaceholderText="资源引用（可选）" />
      </StackPanel>
      <TextBox Grid.Row="3" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
               AcceptsReturn="True" VerticalAlignment="Stretch"
               TextWrapping="Wrap" MinHeight="120" IsVisible="{Binding !IsTable}" />
      <Grid Grid.Row="3" IsVisible="{Binding IsTable}" RowDefinitions="Auto,*" RowSpacing="6">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2">
          <Button Classes="IconButton" Click="OnTableUndoClicked" ToolTip.Tip="撤销">
            <lucide:Lucide Icon="Undo2" Width="16" Height="16" />
          </Button>
          <Button Classes="IconButton" Click="OnTableRedoClicked" ToolTip.Tip="重做">
            <lucide:Lucide Icon="Redo2" Width="16" Height="16" />
          </Button>
          <Rectangle Width="1" Fill="{DynamicResource OutlineVariantBrush}" Margin="4,6" />
          <Button Classes="IconButton" Click="OnInsertRowAboveClicked" ToolTip.Tip="在上方插入行">
            <lucide:Lucide Icon="BetweenHorizontalStart" Width="16" Height="16" />
          </Button>
          <Button Classes="IconButton" Click="OnInsertRowBelowClicked" ToolTip.Tip="在下方插入行">
            <lucide:Lucide Icon="BetweenHorizontalEnd" Width="16" Height="16" />
          </Button>
          <Button Classes="IconButton" Click="OnDeleteRowClicked" ToolTip.Tip="删除当前行">
            <lucide:Lucide Icon="X" Width="16" Height="16" />
          </Button>
          <Rectangle Width="1" Fill="{DynamicResource OutlineVariantBrush}" Margin="4,6" />
          <Button Classes="IconButton" Click="OnInsertColumnLeftClicked" ToolTip.Tip="在左侧插入列">
            <lucide:Lucide Icon="BetweenVerticalStart" Width="16" Height="16" />
          </Button>
          <Button Classes="IconButton" Click="OnInsertColumnRightClicked" ToolTip.Tip="在右侧插入列">
            <lucide:Lucide Icon="BetweenVerticalEnd" Width="16" Height="16" />
          </Button>
          <Button Classes="IconButton" Click="OnDeleteColumnClicked" ToolTip.Tip="删除当前列">
            <lucide:Lucide Icon="X" Width="16" Height="16" />
          </Button>
          <Rectangle Width="1" Fill="{DynamicResource OutlineVariantBrush}" Margin="4,6" />
          <Button x:Name="MergeCellsButton" Classes="IconButton" Click="OnMergeCellsClicked"
                  ToolTip.Tip="合并选中的单元格（拖动或按住 Shift+方向键选中相邻单元格后点击）">
            <lucide:Lucide Icon="TableCellsMerge" Width="16" Height="16" />
          </Button>
          <Button x:Name="UnmergeCellsButton" Classes="IconButton" Click="OnUnmergeCellsClicked"
                  ToolTip.Tip="拆分当前单元格">
            <lucide:Lucide Icon="TableCellsSplit" Width="16" Height="16" />
          </Button>
        </StackPanel>
        <rte:RichEditorView Grid.Row="1" x:Name="TableEditorView" VerticalAlignment="Stretch"
                            ShowStatusBar="False" ShowFileActions="False" />
      </Grid>
      <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="关闭" Click="OnCloseClicked" />
        <Button x:Name="SaveButton" Content="保存" Click="OnSaveClicked"
                Background="{DynamicResource PrimaryBrush}"
                Foreground="{DynamicResource OnPrimaryBrush}" />
      </StackPanel>
    </Grid>
  </Border>
</Window>

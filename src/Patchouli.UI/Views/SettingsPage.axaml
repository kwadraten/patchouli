<UserControl x:Class="Patchouli.UI.Views.SettingsPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lucide="using:Patchouli.Lucide.Avalonia"
             xmlns:controls="using:Patchouli.UI.Controls"
             xmlns:vm="using:Patchouli.UI.ViewModels"
             xmlns:settings="using:Patchouli.UI.ViewModels.Settings"
             xmlns:csl="using:Patchouli.UI.ViewModels.Csl"
             x:DataType="settings:SettingsViewModel">
  <Grid ColumnDefinitions="Auto,*">
    <!-- Sidebar -->
    <Border Grid.Column="0" Width="260" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,1,0">
      <Border Background="{DynamicResource SurfaceContainerLowBrush}">
        <Grid RowDefinitions="Auto,*" Margin="0,10,0,0">
          <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}"
                     Margin="16,6,16,16" />

          <ListBox Grid.Row="1" Classes="SidebarListBox" ItemsSource="{Binding Categories}"
                   SelectedItem="{Binding ActiveCategory}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:NavCategoryViewModel">
                <Border Classes="ItemBorder">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <lucide:Lucide Classes="ItemIcon" Icon="{Binding IconName}" Width="13" Height="13" />
                    <TextBlock Classes="ItemText" Text="{Binding Title}" FontSize="13" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Border>

    <!-- Content Area -->
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
      <Border x:Name="SettingsHeader" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1"
              Padding="32,16">
        <TextBlock Text="{Binding ActiveCategory.Title}" FontSize="24" FontWeight="SemiBold" />
      </Border>

      <ContentControl Grid.Row="1" Content="{Binding ActiveTabbedGroup}" IsVisible="{Binding HasSectionTabs}">
        <ContentControl.ContentTemplate>
          <DataTemplate DataType="settings:SettingsSectionGroupViewModel">
            <Border x:Name="SettingsTabHeader" Background="{DynamicResource SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1">
              <TabStrip x:Name="SettingsSectionTabs" ItemsSource="{Binding Entries}"
                        SelectedItem="{Binding SelectedTab}">
                <TabStrip.ItemTemplate>
                  <DataTemplate DataType="settings:SettingsSectionEntryViewModel">
                    <TextBlock Text="{Binding Title}" />
                  </DataTemplate>
                </TabStrip.ItemTemplate>
              </TabStrip>
            </Border>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <controls:RetainedContentHost Grid.Row="2" ItemsSource="{Binding Categories}"
                                    SelectedItem="{Binding ActiveCategory}">
        <controls:RetainedContentHost.DataTemplates>

          <DataTemplate DataType="vm:NavCategoryViewModel">
            <ScrollViewer>
              <ContentControl Content="{Binding Content}" />
            </ScrollViewer>
          </DataTemplate>

          <DataTemplate DataType="settings:SettingsSectionGroupViewModel">
            <Grid MaxHeight="{ReflectionBinding $parent[ScrollViewer].Viewport.Height}">
              <controls:RetainedContentHost ItemsSource="{Binding Entries}"
                                            SelectedItem="{Binding SelectedTab}">
                <controls:RetainedContentHost.ContentTemplate>
                  <DataTemplate DataType="settings:SettingsSectionEntryViewModel">
                    <ScrollViewer>
                      <ContentControl Content="{Binding Content}" />
                    </ScrollViewer>
                  </DataTemplate>
                </controls:RetainedContentHost.ContentTemplate>
              </controls:RetainedContentHost>
            </Grid>
          </DataTemplate>

          <DataTemplate DataType="settings:LlmOcrDefaultsViewModel">
            <ContentControl Content="{Binding Settings}" Margin="32">
              <ContentControl.ContentTemplate>
                <DataTemplate DataType="settings:LlmSettingsViewModel">
                  <StackPanel MaxWidth="720">
                    <Border Classes="Card">
                      <StackPanel Spacing="10">
                        <TextBlock Text="默认 Provider 与模型" Classes="CardTitle" />
                        <TextBlock Text="多模态 LLM OCR 默认使用的 provider 与模型；未配置时回落到翻译默认 Provider。"
                                   FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="Auto,*,Auto,*" VerticalAlignment="Center" ColumnSpacing="8">
                          <TextBlock Grid.Column="0" Text="默认 Provider" VerticalAlignment="Center" />
                          <ComboBox Grid.Column="1" ItemsSource="{Binding OcrProviderOptions}"
                                    DisplayMemberBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedOcrProvider}"
                                    PlaceholderText="{Binding OcrProviderPlaceholder}"
                                    HorizontalAlignment="Stretch" />
                          <TextBlock Grid.Column="2" Text="默认模型" VerticalAlignment="Center" />
                          <ComboBox Grid.Column="3" IsEditable="True" ItemsSource="{Binding OcrModelOptions}"
                                    Text="{Binding OcrModel}" HorizontalAlignment="Stretch" />
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Classes="Card" Margin="0,16,0,0">
                      <StackPanel Spacing="10">
                        <TextBlock Text="识别性能" Classes="CardTitle" />
                        <TextBlock Text="推理强度（用于阅读顺序和文字识别）" />
                        <ComboBox ItemsSource="{Binding OcrReasoningOptions}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  SelectedItem="{Binding SelectedOcrReasoning}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="分块识别并发数（1–16）" />
                        <NumericUpDown Value="{Binding OcrConcurrency}" Minimum="1" Maximum="16" Increment="1"
                                       FormatString="0" />
                        <TextBlock Text="默认关闭推理，并发识别 4 个区域。推理选项是否生效取决于服务商和模型；提高并发可能触发限流。"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                        <TextBlock Text="版面识别" Classes="CardTitle" />
                        <CheckBox Content="先进行本地版面识别，再分块识别文字（默认）"
                                  IsChecked="{Binding OcrUseLocalLayout}" />
                        <TextBlock Text="关闭后，整页交给多模态 LLM，直接输出边界框和文本。手动画框的区域始终跳过版面识别。"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                        <StackPanel Spacing="10" IsEnabled="{Binding OcrUseLocalLayout}">
                          <TextBlock Text="本地版面模型" />
                          <ComboBox ItemsSource="{Binding OcrLayoutModelOptions}"
                                    DisplayMemberBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedOcrLayoutModel}"
                                    HorizontalAlignment="Stretch" />
                          <TextBlock
                            Text="权重不随应用提供；请在「本地文件」页点击「下载模型」，下载完成后即可使用。"
                            TextWrapping="Wrap" FontSize="12"
                            Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding OcrLayoutStatus}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </DataTemplate>

          <!-- Appearance Settings -->
          <DataTemplate DataType="settings:AppearanceSettingsViewModel">
            <StackPanel Spacing="20" MaxWidth="720" Margin="32">
              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="外观模式与配色" Classes="CardTitle" />
                  <TextBlock Text="选择明暗模式与界面配色。跟随系统时将随操作系统的深浅模式自动切换。" FontSize="12"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />

                  <StackPanel Spacing="6" Margin="0,4,0,4">
                    <TextBlock Text="明暗模式" FontSize="13" FontWeight="Medium" />
                    <ComboBox ItemsSource="{Binding AvailableThemeModes}" SelectedItem="{Binding SelectedThemeMode}"
                              MinWidth="200" HorizontalAlignment="Left">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="settings:ThemeModeOption">
                          <TextBlock Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>

                  <StackPanel Spacing="6" Margin="0,4,0,0">
                    <TextBlock Text="配色方案" FontSize="13" FontWeight="Medium" />
                    <ComboBox ItemsSource="{Binding Palettes}" SelectedItem="{Binding SelectedPalette}"
                              MinWidth="280" HorizontalAlignment="Left">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="settings:PaletteOption">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="14" Height="14" CornerRadius="7" VerticalAlignment="Center"
                                    Background="{Binding AccentBrush}"
                                    BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" />
                            <TextBlock Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center" />
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="40" Height="24" CornerRadius="4"
                            Background="{Binding SelectedPalette.SurfaceBrush}"
                            BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1"
                            ToolTip.Tip="背景" />
                    <Border Width="40" Height="24" CornerRadius="4"
                            Background="{Binding SelectedPalette.TertiaryBrush}"
                            BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1"
                            ToolTip.Tip="强调底色" />
                    <Border Width="40" Height="24" CornerRadius="4"
                            Background="{Binding SelectedPalette.AccentBrush}"
                            ToolTip.Tip="主色" />
                    <Border Width="40" Height="24" CornerRadius="4" Background="{Binding SelectedPalette.TextBrush}"
                            ToolTip.Tip="正文文字" />
                  </StackPanel>
                  <TextBlock Text="修改会自动保存并实时生效。" FontSize="11"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                </StackPanel>
              </Border>

              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="阅读模式" Classes="CardTitle" />
                  <TextBlock Text="全书阅读模式的正文字体、字号与对照翻译布局，保存后立即生效。对照翻译布局：并排对照为左右两栏；段落下方将译文显示在原文段落之下（类似沉浸式翻译）。"
                             FontSize="12"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                  <ComboBox ItemsSource="{Binding ReadingFontFamilies}"
                            SelectedItem="{Binding SelectedReadingFontOption}"
                            MinWidth="280" HorizontalAlignment="Left" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="字号" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding ReadingFontSize}" Minimum="10" Maximum="28"
                                   Increment="1" Width="100" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="对照翻译布局" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding ReadingCompareModes}"
                              SelectedItem="{Binding SelectedReadingCompareMode}"
                              MinWidth="140" HorizontalAlignment="Left" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>

          <!-- Library Settings -->
          <DataTemplate DataType="settings:LibrarySettingsViewModel">
            <StackPanel Spacing="20" MaxWidth="720" Margin="32">
              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="路径信息" Classes="CardTitle" />
                  <TextBlock Text="{Binding RuntimeDatabasePath, StringFormat='运行数据库：\{0\}'}" FontSize="12"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding DefaultSyncRootPath, StringFormat='同步根目录：\{0\}'}" FontSize="12"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="设备设置" Classes="CardTitle" />
                  <CheckBox Content="记住上次打开的数据库" IsChecked="{Binding RememberLastDatabase}" />
                  <TextBlock Text="排除规则（每行一个正则表达式，匹配以 / 分隔的相对路径）" FontSize="12"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <TextBox Text="{Binding ExclusionPatternsText}" AcceptsReturn="True" MinHeight="120"
                           FontFamily="Consolas, Menlo, monospace" />
                  <TextBlock Text="修改会自动保存并实时生效。" FontSize="11"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                </StackPanel>
              </Border>

              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="文件搜索目录" Classes="CardTitle" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <controls:PathPickerTextBox Path="{Binding FileSearchRootInput}"
                                                SelectedRoot="{Binding SelectedFileSearchRoot}" PickerMode="Folder"
                                                DialogTitle="选择文件搜索根目录" PlaceholderText="目录路径" />
                    <Button Classes="FormFieldAction" Grid.Column="1" Content="添加并扫描"
                            Command="{Binding AddFileSearchRootCommand}" Padding="16,0" />
                  </Grid>
                  <Button Content="立即重新扫描" Command="{Binding RescanFileSearchRootsCommand}"
                          HorizontalAlignment="Left" />
                  <ItemsControl ItemsSource="{Binding FileSearchRoots}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="settings:FileSearchRootSettingsRowViewModel">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                          <TextBlock Text="{Binding RootPath}" FontSize="12"
                                     Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RootPath}" />
                          <Button Grid.Column="1" Content="↑" Command="{Binding MoveUpCommand}"
                                  Padding="10,2" ToolTip.Tip="上移（第一个目录是“移动到第一个文件搜索根”导入的目标）" />
                          <Button Grid.Column="2" Content="↓" Command="{Binding MoveDownCommand}"
                                  Padding="10,2" ToolTip.Tip="下移" />
                          <Button Grid.Column="3" Content="移除" Command="{Binding DeleteCommand}" Classes="Danger"
                                  Padding="10,2" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="第一个目录是“移动到第一个文件搜索根”导入行为的目标；以上操作立即生效。" FontSize="11"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>

          <!-- Import Settings -->
          <DataTemplate DataType="settings:ImportSettingsViewModel">
            <StackPanel Spacing="20" MaxWidth="720" Margin="32">
              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="整本失败阈值" Classes="CardTitle" />
                  <TextBlock
                    Text="导入书籍时，失败页数占比严格超过该阈值则整本导入失败并回滚；未超过时失败页以占位页导入，可稍后修复。"
                    FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="失败页比例阈值" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding MaxFailedPageRatioPercent}" Minimum="0" Maximum="90"
                                   Increment="5" Width="100" />
                    <TextBlock Text="%" VerticalAlignment="Center"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  </StackPanel>
                  <TextBlock Text="修改会自动保存并实时生效。" FontSize="11"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                </StackPanel>
              </Border>
              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="文件处理行为" Classes="CardTitle" />
                  <TextBlock
                    Text="按触发动作分别配置导入 PDF 时如何处理源文件。这是本机系统设置，不会随文库快照同步。MCP 调用方不能按请求覆盖。"
                    FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                  <StackPanel Spacing="4">
                    <TextBlock Text="MCP add 导入 PDF" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding BehaviorOptions}"
                              SelectedItem="{Binding McpAddBehaviorOption}"
                              HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="settings:FileHandlingBehaviorOption">
                          <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock
                      Text="“移动到第一个文件搜索根”会改变源文件的位置：文件先移动，再计算 BLAKE3 并登记。若无搜索根、或首个搜索根不可写，导入会显式失败，不会悄悄换用其他目录。"
                      FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Text="窗口拖放 PDF" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding BehaviorOptions}"
                              SelectedItem="{Binding PdfDragDropBehaviorOption}"
                              HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="settings:FileHandlingBehaviorOption">
                          <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock
                      Text="拖入主窗口的 PDF 使用与 MCP add 独立的设置；“保留在原位置”是默认行为，不改变源文件位置。"
                      FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>

          <DataTemplate DataType="settings:SyncSettingsViewModel">
            <StackPanel Spacing="20" MaxWidth="720" Margin="32">
              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="本机同步绑定" Classes="CardTitle" />
                  <TextBlock Text="{Binding DeviceId, StringFormat='设备 ID：\{0\}'}" FontSize="12" />
                  <TextBox Text="{Binding DeviceName}" PlaceholderText="设备名称" />
                  <controls:PathPickerTextBox Path="{Binding SyncRoot}" PickerMode="Folder"
                                              DialogTitle="选择本机同步目录" PlaceholderText="本机同步目录" />
                  <TextBlock Text="{Binding SnapshotOperationStateText, StringFormat='最近同步状态：{0}'}"
                             FontSize="12" Foreground="{DynamicResource PrimaryBrush}" />
                  <TextBlock Text="{Binding SnapshotOperationMessage}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="凭据、MCP token、设备授权和本机运行状态不会随快照同步。发布、导出、接收和冲突解决在同步中心完成。"
                             FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <Separator />
                  <TextBlock Text="随库同步的非秘密设置" Classes="CardTitle" />
                  <CheckBox Content="随库同步元数据来源优先级" IsChecked="{Binding SyncMetadataLookup}" />
                  <Separator />
                  <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1"
                            Padding="0,0,0,6" Margin="0,4,0,0">
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition SharedSizeGroup="ScopeColA" Width="1.4*" />
                          <ColumnDefinition SharedSizeGroup="ScopeColB" Width="0.8*" />
                          <ColumnDefinition SharedSizeGroup="ScopeColC" Width="0.8*" />
                          <ColumnDefinition SharedSizeGroup="ScopeColD" Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="设置项" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                        <TextBlock Grid.Column="1" Text="同步策略" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                        <TextBlock Grid.Column="2" Text="存储位置" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                        <TextBlock Grid.Column="3" Text="传播方式" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                      </Grid>
                    </Border>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding SettingScopeRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="settings:SyncSettingScopeRowViewModel">
                          <Border BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1"
                                  Padding="0,6">
                            <Grid ColumnSpacing="12">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="ScopeColA" Width="1.4*" />
                                <ColumnDefinition SharedSizeGroup="ScopeColB" Width="0.8*" />
                                <ColumnDefinition SharedSizeGroup="ScopeColC" Width="0.8*" />
                                <ColumnDefinition SharedSizeGroup="ScopeColD" Width="1.2*" />
                              </Grid.ColumnDefinitions>
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SettingKey}" FontSize="11"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                              </StackPanel>
                              <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding AllowedSyncText}" FontSize="12" />
                                <TextBlock Text="{Binding EnabledText}" FontSize="11"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                              </StackPanel>
                              <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="{Binding OwnerText}" FontSize="12" />
                                <TextBlock Text="{Binding SchemaText}" FontSize="11"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                              </StackPanel>
                              <TextBlock Grid.Column="3" Text="{Binding SourceText}" FontSize="12"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                  <TextBlock Text="启用后，元数据来源优先级的基准值存入当前资料库，并随内容快照整体发布和接收；本机设备绑定、MCP 配置、凭据和运行状态始终不进入快照。"
                             FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="打开同步中心" Command="{Binding OpenSyncCenterCommand}" />
                    <Button Content="立即发布" Command="{Binding PublishSnapshotCommand}" />
                    <Button Content="检查传入快照" Command="{Binding CheckIncomingSnapshotCommand}" />
                    <Button Content="导出快照包" Command="{Binding ExportSnapshotPackageCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>

          <!-- MCP Settings -->
          <DataTemplate DataType="settings:McpSettingsViewModel">
            <StackPanel Spacing="20" MaxWidth="720" Margin="32">
              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="运行状态" Classes="CardTitle" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <Button Content="停止" Command="{Binding StopMcpCommand}"
                              ToolTip.Tip="关闭 MCP 服务。" />
                      <Button Content="启动" Command="{Binding StartMcpCommand}" Classes="Primary" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding McpStatusText}" FontSize="12"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding McpEndpoint, StringFormat='端点：\{0\}'}" FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                    <Button Grid.Column="1" Content="复制" Command="{Binding CopyEndpointCommand}"
                            ToolTip.Tip="复制端点到剪贴板" Padding="10,2" />
                  </Grid>
                  <Border Background="{DynamicResource ErrorContainerBrush}"
                          BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" CornerRadius="4"
                          Padding="12" IsVisible="{Binding RequiresReload}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="设置已保存，需重启服务后生效" FontWeight="Bold"
                                 Foreground="{DynamicResource OnErrorContainerBrush}" />
                      <Button Content="保存并重启服务" Command="{Binding SaveAndRestartCommand}"
                              HorizontalAlignment="Left" Classes="Primary" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="监听设置" Classes="CardTitle" />
                  <TextBlock Text="端口" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <NumericUpDown Value="{Binding Port}" Minimum="1024" Maximum="65535" />
                  <TextBlock Text="Bind 地址" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <TextBox Text="{Binding BindAddress}" PlaceholderText="127.0.0.1 或 0.0.0.0" />
                  <TextBlock Text="协议：Streamable HTTP" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="{Binding TransportDescription}" FontSize="12"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="MCP 外部访问控制" Classes="CardTitle" />
                  <CheckBox Content="允许局域网访问" IsChecked="{Binding AllowExternalAccess}" />
                  <CheckBox Content="JSON-RPC 请求需要 Bearer Token" IsChecked="{Binding AuthRequired}" />

                  <Border Background="{DynamicResource ErrorContainerBrush}"
                          BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" CornerRadius="4"
                          Padding="12" IsVisible="{Binding IsAllowExternalAccessWarningVisible}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="警告：暴露于 0.0.0.0 但未配置鉴权 Token" FontWeight="Bold"
                                 Foreground="{DynamicResource OnErrorContainerBrush}" />
                      <TextBlock Text="为了保护您的电脑，外部请求将被阻塞。请生成一个 Server Token 启用鉴权。"
                                 Foreground="{DynamicResource OnErrorContainerBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="安全鉴权 (Server Token)" Classes="CardTitle" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding ServerToken}" PlaceholderText="留空则无鉴权" />
                    <Button Grid.Column="1" Content="随机生成" Command="{Binding GenerateTokenCommand}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="CORS" Classes="CardTitle" />
                  <CheckBox Content="启用 CORS" IsChecked="{Binding CorsEnabled}" />
                  <TextBox Text="{Binding AllowedOriginsText}" AcceptsReturn="True" MinHeight="72"
                           PlaceholderText="每行一个 allowed origin，例如 http://localhost:3000" />
                </StackPanel>
              </Border>

              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Agent 资源访问权限" Classes="CardTitle" />
                  <TextBlock Text="按域分别授权每个动词。授权不改变资源支持的操作；保存后后续 MCP/CLI 调用立即生效，MCP 服务需重新加载。"
                             FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel MinWidth="608" Spacing="4">
                      <Grid ColumnDefinitions="160,64,64,64,64,64,64,64">
                        <TextBlock Text="VFS 域" />
                        <TextBlock Grid.Column="1" Text="find" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="fetch" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="put" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="cite" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="send" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="add" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="7" Text="view" HorizontalAlignment="Center" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding PermissionRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="settings:McpDomainPermissionRowViewModel">
                            <Grid ColumnDefinitions="160,448" RowDefinitions="Auto,Auto" Margin="0,3">
                              <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Domain}" VerticalAlignment="Center" />
                                <ToggleButton IsVisible="{Binding HasChildren}" IsChecked="{Binding IsExpanded}"
                                              Content="{Binding ExpansionGlyph}" Padding="2,0" MinWidth="0"
                                              MinHeight="0"
                                              Width="20" Height="22" Background="Transparent" BorderThickness="0"
                                              Foreground="{DynamicResource OnSurfaceBrush}"
                                              AutomationProperties.Name="展开 runs 子域权限">
                                  <ToggleButton.Template>
                                    <ControlTemplate>
                                      <ContentPresenter Content="{TemplateBinding Content}" Background="Transparent"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center" />
                                    </ControlTemplate>
                                  </ToggleButton.Template>
                                </ToggleButton>
                              </StackPanel>
                              <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="settings:McpDomainPermissionCellViewModel">
                                    <Grid>
                                      <CheckBox IsVisible="{Binding !IsAggregate}" IsChecked="{Binding Enabled}"
                                                IsEnabled="{Binding IsSupported}"
                                                HorizontalAlignment="Center" ToolTip.Tip="{Binding Description}"
                                                AutomationProperties.Name="{Binding Description}" />
                                      <CheckBox IsVisible="{Binding IsAggregate}" IsThreeState="True"
                                                IsChecked="{Binding Aggregate.Checked, Mode=OneWay}"
                                                Command="{Binding Aggregate.ToggleCommand}"
                                                HorizontalAlignment="Center"
                                                AutomationProperties.Name="runs 全部子域 send 权限" />
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Children}"
                                            IsVisible="{Binding IsExpanded}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="settings:RunSendPermissionViewModel">
                                    <Grid ColumnDefinitions="160,64,64,64,64,64,64,64" Margin="0,3">
                                      <TextBlock Text="{Binding Domain}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                      <CheckBox Grid.Column="5" IsChecked="{Binding Enabled}"
                                                HorizontalAlignment="Center"
                                                AutomationProperties.Name="{Binding Domain}" />
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>

                </StackPanel>
              </Border>

              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Library 投影暴露" Classes="CardTitle" />
                  <TextBlock
                    Text="仅对 MCP/CLI agent 生效，保存在本设备。隐藏后对应筛选返回 PERMISSION_DENIED；隐藏标签同时隐藏 BibLaTeX keyword，写入时保留现有标签。"
                    FontSize="12" TextWrapping="Wrap"
                    Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <CheckBox Content="暴露标签（patchouli://library.yml 与题录关系）"
                            IsChecked="{Binding ExposeLibraryTags}" />
                  <CheckBox Content="暴露集合（patchouli://library.yml 与题录关系）"
                            IsChecked="{Binding ExposeLibraryCollections}" />
                  <Button Content="刷新预览" Command="{Binding RefreshLibraryPreviewCommand}"
                          HorizontalAlignment="Left" />
                  <TextBlock Text="{Binding LibraryPreviewHint}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <TextBox Text="{Binding LibraryPreviewText}" IsReadOnly="True" AcceptsReturn="True"
                           MinHeight="120" FontFamily="Consolas" TextWrapping="NoWrap" />
                </StackPanel>
              </Border>

              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="命令行工具 (patchouli-cli)" Classes="CardTitle" />
                  <TextBlock Text="{Binding CliStatusText}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="加入 PATH" Command="{Binding AddCliToPathCommand}" />
                    <Button Content="从 PATH 移除" Command="{Binding RemoveCliFromPathCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>

          <!-- OCR Settings -->
          <DataTemplate DataType="settings:OcrProviderSettingsViewModel">
            <StackPanel Spacing="20" MaxWidth="720" Margin="32">
              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="OCR 通用配置" Classes="CardTitle" />
                  <TextBlock Text="OCR 预设" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="{Binding OcrConcurrencySummary}" FontSize="12"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="默认 OCR 引擎" Classes="CardTitle" />
                  <TextBlock Text="为不同作用域选择当前使用的 OCR 引擎。保存后生效。" FontSize="12"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="文档级 OCR" VerticalAlignment="Center"
                               Margin="0,0,12,8" />
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding AvailableEngines}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              SelectedValue="{Binding SelectedDocumentEngine}"
                              SelectedValueBinding="{Binding EngineId}"
                              HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="页面级 OCR" VerticalAlignment="Center"
                               Margin="0,0,12,8" />
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding AvailableEngines}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              SelectedValue="{Binding SelectedPageEngine}"
                              SelectedValueBinding="{Binding EngineId}"
                              HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="区域级 OCR" VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              ItemsSource="{Binding AvailableEngines}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              SelectedValue="{Binding SelectedRegionEngine}"
                              SelectedValueBinding="{Binding EngineId}"
                              HorizontalAlignment="Stretch" />
                  </Grid>
                </StackPanel>
              </Border>


              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="云端版面解析 (MinerU)" Classes="CardTitle" />
                  <TextBlock Text="解析模型" FontSize="12"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <ComboBox ItemsSource="{Binding MinerUModelVersionOptions}"
                            SelectedItem="{Binding MinerUModelVersion}" />
                  <TextBlock Text="轮询超时（秒）" FontSize="12"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <NumericUpDown Value="{Binding MinerUPollingTimeoutSeconds}" Minimum="30" Maximum="3600" />
                  <TextBox Text="{Binding MinerUTokenInput}" PasswordChar="•" PlaceholderText="在此输入 Token" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding MinerUCredentialStatus}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                    <Button Grid.Column="1" Content="移除凭据" Classes="Danger"
                            Command="{Binding RemoveMinerUCredentialCommand}"
                            IsEnabled="{Binding HasPersistedCredential}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>

          <DataTemplate DataType="settings:TranslationDefaultsViewModel">
            <ContentControl Content="{Binding Settings}">
              <ContentControl.ContentTemplate>
                <DataTemplate DataType="settings:LlmSettingsViewModel">
                  <StackPanel Spacing="20" MaxWidth="720" Margin="32">
                    <!-- Direct translation (issue #20): the persisted "Translation" subsection. -->
                    <Border Classes="Card">
                      <StackPanel Spacing="10">
                        <TextBlock Text="翻译" Classes="CardTitle" />
                        <TextBlock
                          Text="「全文翻译」按页批量调用模型。此处的修改会自动保存，对之后启动的翻译生效。"
                          FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />

                        <TextBlock Text="目标语言" FontSize="13" FontWeight="Medium" />
                        <ComboBox x:Name="TranslationTargetLanguageSelector"
                                  ItemsSource="{Binding TranslationLanguageOptions}"
                                  SelectedItem="{Binding SelectedTranslationLanguage}"
                                  DisplayMemberBinding="{Binding DisplayName}" Width="280" MaxDropDownHeight="360"
                                  HorizontalAlignment="Left" AutomationProperties.Name="目标语言" />

                        <Separator />
                        <TextBlock Text="批处理" FontWeight="SemiBold" FontSize="13" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                          <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="批量大小（1–64）" FontSize="12"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            <TextBox Text="{Binding TranslationBatchSizeText}" Width="160" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding TranslationBatchSizeError}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       IsVisible="{Binding TranslationBatchSizeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="单请求最大字符（1000–200000）" FontSize="12"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            <TextBox Text="{Binding TranslationMaxBatchCharactersText}" Width="180"
                                     HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding TranslationMaxBatchCharactersError}" FontSize="12"
                                       TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"
                                       IsVisible="{Binding TranslationMaxBatchCharactersError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                          <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Token 上限（可空，正整数）" FontSize="12"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            <TextBox Text="{Binding TranslationMaxBatchTokensText}" Width="160"
                                     HorizontalAlignment="Left" PlaceholderText="留空表示不限制" />
                            <TextBlock Text="{Binding TranslationMaxBatchTokensError}" FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       IsVisible="{Binding TranslationMaxBatchTokensError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="并发数（1–16）" FontSize="12"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            <TextBox Text="{Binding TranslationConcurrencyText}" Width="160" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding TranslationConcurrencyError}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       IsVisible="{Binding TranslationConcurrencyError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="单批请求的页数与字符上限决定一次发送多少内容；Token 上限用于同时约束模型输入预算。"
                                   FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap" />

                        <Separator />
                        <TextBlock Text="请求与重试" FontWeight="SemiBold" FontSize="13" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                          <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="请求间隔（秒，0–600）" FontSize="12"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            <TextBox Text="{Binding TranslationRequestIntervalSecondsText}" Width="140"
                                     HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding TranslationRequestIntervalSecondsError}" FontSize="12"
                                       TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"
                                       IsVisible="{Binding TranslationRequestIntervalSecondsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="超时（秒，1–3600）" FontSize="12"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            <TextBox Text="{Binding TranslationRequestTimeoutSecondsText}" Width="140"
                                     HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding TranslationRequestTimeoutSecondsError}" FontSize="12"
                                       TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"
                                       IsVisible="{Binding TranslationRequestTimeoutSecondsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="重试次数（0–10）" FontSize="12"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            <TextBox Text="{Binding TranslationMaxRetriesText}" Width="140" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding TranslationMaxRetriesError}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       IsVisible="{Binding TranslationMaxRetriesError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="请求间隔用于限制相邻批次的发送频率，0 表示不限制；超时只作用于一次模型请求，重试仅针对临时失败。"
                                   FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap" />

                        <Separator />
                        <TextBlock Text="上下文" FontWeight="SemiBold" FontSize="13" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <TextBlock Text="上下文窗口半径（0–5）" VerticalAlignment="Center" FontSize="12"
                                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                          <TextBox Grid.Column="1" Text="{Binding TranslationWindowRadiusText}" Width="140"
                                   HorizontalAlignment="Left" />
                        </Grid>
                        <TextBlock Text="{Binding TranslationWindowRadiusError}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   IsVisible="{Binding TranslationWindowRadiusError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <CheckBox Content="回填前窗译文（把上一窗口的译文作为术语上下文）"
                                  IsChecked="{Binding TranslationBackfillPreviousWindowTranslation}" />
                        <TextBlock Text="窗口半径决定每页携带多少相邻页作为上下文；回填会把上一窗口已经生成的译文放入提示词，帮助保持术语一致。"
                                   FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap" />

                        <Separator />
                        <TextBlock Text="模型覆盖" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="留空时跟随默认模型；可以只覆盖模型，也可以同时指定 provider 与模型。"
                                   FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                          <TextBlock Grid.Column="0" Text="Provider" VerticalAlignment="Center" />
                          <ComboBox Grid.Column="1" ItemsSource="{Binding TranslationProviderOptions}"
                                    DisplayMemberBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedTranslationProvider}"
                                    PlaceholderText="跟随默认模型" HorizontalAlignment="Stretch" />
                          <TextBlock Grid.Column="2" Text="模型" VerticalAlignment="Center" />
                          <ComboBox Grid.Column="3" IsEditable="True" ItemsSource="{Binding TranslationModelOptions}"
                                    Text="{Binding TranslationModel}"
                                    PlaceholderText="留空=跟随默认模型" HorizontalAlignment="Stretch" />
                        </Grid>
                        <TextBlock Text="模型覆盖只影响翻译请求；Provider 未配置完成时保存会提示补全。" FontSize="12"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TranslationErrorMessage}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   IsVisible="{Binding TranslationErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </Border>


                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </DataTemplate>
          <!-- LLM & Translation Settings -->
          <DataTemplate DataType="settings:LlmSettingsViewModel">
            <StackPanel Spacing="20" MaxWidth="720" Margin="32">
              <TextBlock
                Text="供应商表单按内置目录自动生成：新增供应商只需扩展目录，无需修改界面。API key 写入本机凭据存储，设置文件只保存端点与模型。"
                FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />

              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Text="默认模型" Classes="CardTitle" />
                  <TextBlock Text="翻译未单独指定 provider 或模型时使用此设置。"
                             FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                             TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="Provider" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ChatProviderOptions}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              SelectedItem="{Binding SelectedChatProvider}"
                              PlaceholderText="{Binding ChatProviderPlaceholder}"
                              HorizontalAlignment="Stretch" />
                    <TextBlock Grid.Column="2" Text="模型" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="3" IsEditable="True"
                              ItemsSource="{Binding ChatModelOptions}"
                              Text="{Binding ChatModel}" HorizontalAlignment="Stretch" />
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Text="Provider 配置" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Text="尚未添加 Provider。选择服务后填写模型和凭据，即可启用。"
                         IsVisible="{Binding HasNoProviders}" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource OnSurfaceVariantBrush}" />
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <ComboBox ItemsSource="{Binding AvailableProviderOptions}"
                          DisplayMemberBinding="{Binding DisplayName}"
                          SelectedItem="{Binding SelectedProviderToAdd}"
                          IsEnabled="{Binding !HasPendingProvider}" HorizontalAlignment="Stretch" />
                <Button Grid.Column="1" Content="添加 Provider" Command="{Binding AddProviderCommand}" />
                <Button Grid.Column="2" Content="取消添加" Command="{Binding CancelAddProviderCommand}"
                        IsVisible="{Binding HasPendingProvider}" />
              </Grid>
              <TextBlock Text="填写后自动保存；配置完整的 Provider 会出现在翻译和 OCR 的选项中。"
                         FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource OnSurfaceVariantBrush}" />
              <ItemsControl ItemsSource="{Binding VisibleProviders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="settings:LlmProviderSettingsRowViewModel">
                    <Border Classes="Card" Margin="0,0,0,12">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            <Border IsVisible="{Binding RequiresBaseUrl}" Padding="6,0" CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SurfaceContainerHighestBrush}">
                              <TextBlock Text="必须填写 Base URL" FontSize="11"
                                         Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            </Border>
                            <Border IsVisible="{Binding IsAzure}" Padding="6,0" CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SurfaceContainerHighestBrush}">
                              <TextBlock Text="Azure 专属字段" FontSize="11"
                                         Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding CredentialStatusText}" FontSize="11"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding SupportsSubscription}">
                          <TextBlock Text="认证方式" VerticalAlignment="Center" />
                          <ComboBox Grid.Column="1" ItemsSource="{Binding AuthenticationOptions}"
                                    DisplayMemberBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedAuthenticationOption}"
                                    IsEnabled="{Binding !IsSubscriptionBusy}" HorizontalAlignment="Stretch" />
                        </Grid>
                        <StackPanel IsVisible="{Binding IsSubscription}" Spacing="8">
                          <TextBlock Text="{Binding SubscriptionStatusText}" FontSize="12" TextWrapping="Wrap" />
                          <TextBlock Text="使用订阅账号的模型额度；当前订阅接口支持文本翻译。"
                                     FontSize="12" TextWrapping="Wrap" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="登录订阅" Command="{Binding LoginSubscriptionCommand}"
                                    IsEnabled="{Binding !IsSubscriptionBusy}" />
                            <Button Content="刷新模型" Command="{Binding RefreshSubscriptionModelsCommand}"
                                    IsEnabled="{Binding !IsSubscriptionBusy}" />
                            <Button Content="退出订阅" Command="{Binding LogoutSubscriptionCommand}"
                                    IsEnabled="{Binding !IsSubscriptionBusy}" />
                            <Button Content="取消登录" Command="{Binding CancelSubscriptionLoginCommand}"
                                    IsVisible="{Binding LoginSubscriptionCommand.IsRunning}" />
                          </StackPanel>
                          <ComboBox ItemsSource="{Binding SubscriptionModels}"
                                    SelectedItem="{Binding SelectedSubscriptionModel}"
                                    PlaceholderText="登录后选择订阅账号可用的模型" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8"
                              RowSpacing="8" IsVisible="{Binding !IsSubscription}">
                          <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" VerticalAlignment="Center" />
                          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Model}"
                                   PlaceholderText="{Binding ModelWatermark}" />

                          <TextBlock Grid.Row="1" Grid.Column="0" Text="Base URL" VerticalAlignment="Center" />
                          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BaseUrl}"
                                   PlaceholderText="{Binding DefaultBaseUrl}" />

                          <TextBlock Grid.Row="2" Grid.Column="0" Text="API key" VerticalAlignment="Center" />
                          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ApiKeyInput}" PasswordChar="•"
                                   PlaceholderText="{Binding ApiKeyPlaceholder}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <TextBlock Text="上下文总长度（tokens）" VerticalAlignment="Center" />
                          <NumericUpDown Grid.Column="1" Value="{Binding ContextWindowTokens}"
                                         Minimum="4096" Maximum="10000000" Increment="1024"
                                         FormatString="0" HorizontalAlignment="Stretch" />
                        </Grid>
                        <TextBlock Text="请填写所选模型的上下文容量；达到 80% 时压缩完整历史并继续，原始记录可按需读取。"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                          <TextBlock Text="{Binding DiagnosticText}" FontSize="11" VerticalAlignment="Center"
                                     Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                     TextWrapping="Wrap" />
                          <Button Grid.Column="1" Content="移除凭据" Classes="Danger"
                                  Command="{Binding RemoveApiKeyCommand}"
                                  IsVisible="{Binding !IsSubscription}"
                                  IsEnabled="{Binding HasCredential}" />
                          <Button Grid.Column="2" Content="移除连接" Classes="Danger"
                                  Command="{Binding RemoveConnectionCommand}" />
                        </Grid>
                        <StackPanel IsVisible="{Binding IsAzure}" Spacing="8">
                          <Separator />
                          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8"
                                RowSpacing="8">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Subscription" VerticalAlignment="Center"
                                       IsVisible="{Binding IsAzureSubscriptionRequired}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Subscription}"
                                     IsVisible="{Binding IsAzureSubscriptionRequired}"
                                     PlaceholderText="Azure 资源（subscription）名称" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Deployment" VerticalAlignment="Center"
                                       IsVisible="{Binding IsAzureDeploymentRequired}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Deployment}"
                                     IsVisible="{Binding IsAzureDeploymentRequired}"
                                     PlaceholderText="Azure 部署名称" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="API Version" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ApiVersion}"
                                     PlaceholderText="留空使用默认 api-version" />
                          </Grid>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>

          <!-- Agent Integration Settings -->
          <DataTemplate DataType="settings:AgentIntegrationSettingsViewModel">
            <StackPanel Spacing="20" MaxWidth="760" Margin="32">
              <TextBlock
                Text="在 Patchouli 中启动外部编码 Agent。检测结果来自本机可执行文件；启用状态、默认 Agent 与自定义路径会自动保存。"
                FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />

              <Border Classes="Card">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Agent 集成" Classes="CardTitle" />
                      <TextBlock Text="关闭后保留检测结果与路径设置，但不会启动 Agent。" FontSize="12"
                                 Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Content="启用" IsChecked="{Binding Enabled}"
                              VerticalAlignment="Center" />
                  </Grid>

                  <Separator />

                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="可用 Agent" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Padding="12,4" Command="{Binding DetectAllCommand}"
                            IsEnabled="{Binding !IsDetecting}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:Lucide Icon="RefreshCw" Width="14" Height="14" />
                        <TextBlock Text="重新检测" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Padding="12,4" Content="取消"
                            Command="{Binding CancelOperationCommand}"
                            IsVisible="{Binding CanCancelOperation}" />
                  </Grid>

                  <ItemsControl ItemsSource="{Binding Agents}" IsEnabled="{Binding Enabled}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="settings:AgentIntegrationRowViewModel">
                        <Border Classes="CardTile" Margin="0,0,0,10" Padding="14">
                          <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                              <controls:AgentIcon AgentId="{Binding Entry.Id}" Width="22" Height="22" Margin="0,2,0,0"
                                                  Foreground="{DynamicResource OnSurfaceBrush}" />
                              <StackPanel Grid.Column="1" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                  <Border IsVisible="{Binding IsDefault}" Padding="6,0" CornerRadius="4"
                                          VerticalAlignment="Center"
                                          Background="{DynamicResource SurfaceContainerHighestBrush}">
                                    <TextBlock Text="默认" FontSize="11"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                  </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="11"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusText}" FontSize="12"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding VersionText}" FontSize="12" TextWrapping="Wrap"
                                           IsVisible="{Binding VersionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Text="{Binding PathText}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                           IsVisible="{Binding PathText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Text="{Binding ErrorText}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                              </StackPanel>
                              <RadioButton Grid.Column="2" GroupName="AgentSelection" VerticalAlignment="Center"
                                           IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanOperate}"
                                           ToolTip.Tip="设为默认 Agent" />
                              <Button Grid.Column="3" Padding="8,4" Command="{Binding RedetectCommand}"
                                      IsEnabled="{Binding CanOperate}" ToolTip.Tip="重新检测">
                                <lucide:Lucide Icon="RefreshCw" Width="14" Height="14" />
                              </Button>
                              <Button Grid.Column="4" Padding="8,4" Command="{Binding TogglePathEditorCommand}"
                                      ToolTip.Tip="自定义路径">
                                <lucide:Lucide Icon="FolderOpen" Width="14" Height="14" />
                              </Button>
                            </Grid>

                            <StackPanel Spacing="6" IsVisible="{Binding IsInstalling}">
                              <ProgressBar Value="{Binding InstallProgress}" Minimum="0" Maximum="1" Height="6" />
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding InstallStageText}" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                           TextWrapping="Wrap" />
                                <Button Grid.Column="1" Content="取消" Padding="10,2"
                                        Command="{Binding CancelInstallCommand}" />
                              </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanInstall}">
                              <Button Padding="12,4" Command="{Binding InstallCommand}"
                                      IsEnabled="{Binding CanOperate}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <lucide:Lucide Icon="Download" Width="14" Height="14" />
                                  <TextBlock Text="一键安装" />
                                </StackPanel>
                              </Button>
                              <TextBlock Text="从官方发布地址下载并安装到 Patchouli 管理的目录。" FontSize="11"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                         TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Text="{Binding InstallErrorText}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       IsVisible="{Binding InstallErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <TextBlock Text="{Binding InstallHelpText}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       IsVisible="{Binding ShowInstallHelp}" />

                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowInstallHelp}">
                              <Button Padding="12,4" Command="{Binding TogglePathEditorCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <lucide:Lucide Icon="FolderOpen" Width="14" Height="14" />
                                  <TextBlock Text="自定义路径" />
                                </StackPanel>
                              </Button>
                              <Button Padding="12,4" Command="{Binding OpenRepositoryCommand}"
                                      IsVisible="{Binding HasRepository}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <lucide:Lucide Icon="ArrowUpRight" Width="13" Height="13" />
                                  <TextBlock Text="官方安装说明" />
                                </StackPanel>
                              </Button>
                            </StackPanel>

                            <StackPanel Spacing="6" IsVisible="{Binding IsPathEditorOpen}">
                              <TextBlock Text="自定义可执行文件路径（留空则恢复自动检测）" FontSize="11"
                                         Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                              <controls:PathPickerTextBox Path="{Binding CustomPath}"
                                                          PickerMode="OpenFile"
                                                          DialogTitle="选择 Agent 可执行文件"
                                                          PlaceholderText="选择已安装的 Agent 可执行文件" />
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="恢复自动检测" Padding="12,4"
                                        Command="{Binding ClearCustomPathCommand}"
                                        IsEnabled="{Binding HasCustomPath}" />
                                <Button Content="重新检测" Padding="12,4"
                                        Command="{Binding RedetectCommand}"
                                        IsEnabled="{Binding CanOperate}" />
                              </StackPanel>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="{Binding Status}" FontSize="12"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>

          <!-- Local File Management -->
          <DataTemplate DataType="settings:LocalFileManagementSettingsViewModel">
            <StackPanel Spacing="20" MaxWidth="720" Margin="32">
              <TextBlock Text="管理 OCR 模型文件与运行时产生的临时文件。删除的模型可重新下载。"
                         FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />

              <Border Classes="Card">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="托管位置" Classes="CardTitle" />
                    <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Locations}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="settings:ManagedLocationViewModel">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12" Margin="0,6">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Path}" FontSize="11"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Path}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding SizeDisplay}" FontSize="11"
                                         Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                              <TextBlock Text="{Binding ItemCountDisplay}" FontSize="11"
                                         Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            </StackPanel>
                          </StackPanel>
                          <Button Grid.Column="1" Content="下载模型" Command="{Binding DownloadCommand}"
                                  IsVisible="{Binding CanDownload}" Padding="12,4" />
                          <Button Grid.Column="2" Content="打开目录" Command="{Binding OpenCommand}" Padding="12,4" />
                          <Button Grid.Column="3" Content="清理" Command="{Binding ClearCommand}" Classes="Danger"
                                  IsVisible="{Binding CanClear}" Padding="12,4" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="Card" IsVisible="{Binding IsDownloading}">
                <StackPanel Spacing="8">
                  <TextBlock Text="下载进度" Classes="CardTitle" />
                  <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="1" />
                  <TextBlock Text="{Binding Status}" FontSize="12"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>

          <!-- Metadata Lookup Settings -->
          <DataTemplate DataType="settings:MetadataLookupSettingsViewModel">
            <StackPanel Spacing="20" MaxWidth="720" Margin="32">
              <TextBlock Text="按顺序尝试已启用的来源。更专业的国家、地区和学科来源默认优先。" FontSize="12"
                         Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />

              <Border Classes="Card">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="CardTitle" Text="来源优先级" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Status}" FontSize="12" VerticalAlignment="Center"
                                 Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                      <Button Content="恢复默认" Command="{Binding RestoreDefaultsCommand}" />
                    </StackPanel>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Sources}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="settings:MetadataSourceSettingsRowViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,4">
                          <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" FontSize="11"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                          </StackPanel>
                          <Button Grid.Column="2" Content="上移" Command="{Binding MoveUpCommand}"
                                  IsEnabled="{Binding CanMoveUp}" Padding="10,4" />
                          <Button Grid.Column="3" Content="下移" Command="{Binding MoveDownCommand}"
                                  IsEnabled="{Binding CanMoveDown}" Padding="10,4" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>

          <!-- CSL Localization Settings -->
          <DataTemplate DataType="settings:CslLocalizationSettingsViewModel">
            <StackPanel Spacing="16" MaxWidth="720" Margin="32">
              <Border Classes="Card">
                <StackPanel Spacing="12">
                  <TextBlock Classes="CardTitle" Text="默认本地化" />
                  <ComboBox x:Name="DefaultCslLocaleEditor" ItemsSource="{Binding DefaultLocaleOptions}"
                            DisplayMemberBinding="{Binding DisplayName}"
                            SelectedItem="{Binding SelectedDefaultLocale}" HorizontalAlignment="Stretch" />
                  <TextBlock Text="控制默认输出中的本地化术语；选择“使用样式默认”时，遵循 CSL 样式自身的语言设置。更改会自动保存，不改变题录原始语言。"
                             FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                </StackPanel>
              </Border>
              <TextBlock
                Text="优先使用 CSL 样式中与题录语言匹配的布局；没有匹配时，再尝试下方的语言映射；映射也无法匹配时，使用样式自身的默认布局。默认本地化控制未指定语言的术语与回退输出。默认将日语、韩语映射为中文。"
                FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
              <Border Classes="Card">
                <StackPanel Spacing="12">
                  <TextBlock Classes="CardTitle" Text="题录本地化规则" />
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="settings:CslLanguageLocaleMappingRowViewModel">
                        <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="8" Margin="0,2">
                          <ComboBox x:Name="MappingLanguageEditor" Grid.Column="0"
                                    ItemsSource="{Binding LanguageOptions}"
                                    DisplayMemberBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedLanguage}"
                                    MinWidth="120" HorizontalAlignment="Stretch" />
                          <TextBlock Grid.Column="1" Text="→" FontSize="12"
                                     Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                     VerticalAlignment="Center" />
                          <ComboBox x:Name="MappingLocaleEditor" Grid.Column="2"
                                    ItemsSource="{Binding LocaleOptions}"
                                    DisplayMemberBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedLocale}"
                                    MinWidth="120" HorizontalAlignment="Stretch" />
                          <Button x:Name="RemoveMappingButton" Grid.Column="3" Content="删除"
                                  Command="{Binding RemoveCommand}" Padding="8,4" MinWidth="52" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button x:Name="AddMappingButton" Content="添加语言映射"
                          Command="{Binding AddMappingCommand}" HorizontalAlignment="Left" Padding="12,6" />
                  <TextBlock Text="每种题录语言只能有一条规则。删除规则或选择“使用默认输出”后，没有直接匹配布局的题录将使用样式的默认布局。规则会自动保存。"
                             FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>

          <DataTemplate DataType="csl:CslStyleManagerViewModel">
            <StackPanel Spacing="16" MaxWidth="720" Margin="32">
              <TextBlock Text="默认样式用于题录预览和默认引用输出。设为默认后立即保存。"
                         FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
              <Border Classes="Card">
                <StackPanel Spacing="12">
                  <TextBlock Classes="CardTitle" Text="{Binding InstalledStyles.Count, StringFormat='已安装样式（{0}）'}" />
                  <ItemsControl ItemsSource="{Binding InstalledStyles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="csl:CslStyleViewModel">
                        <Border Classes="CardTile" Margin="0,0,0,8">
                          <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding StyleId}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            <TextBlock Text="{Binding FormattedUpdated, StringFormat='更新时间：{0}'}" FontSize="11"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                              <TextBlock Text="默认" IsVisible="{Binding IsDefault}" VerticalAlignment="Center"
                                         Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,8,0" />
                              <Button Content="设为默认" Command="{Binding SetDefaultCommand}"
                                      IsVisible="{Binding IsNotDefault}" Padding="10,4" />
                              <Button Content="移除" Command="{Binding RemoveCommand}" Classes="Danger" Padding="10,4" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="可在“在线样式”中搜索并安装更多 CSL 样式。" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>

          <DataTemplate DataType="settings:CslOnlineStylesSettingsViewModel">
            <ContentControl Content="{Binding Styles}">
              <ContentControl.ContentTemplate>
                <DataTemplate DataType="csl:CslStyleManagerViewModel">
                  <StackPanel Spacing="16" MaxWidth="720" Margin="32">
                    <Border Classes="Card">
                      <StackPanel Spacing="12">
                        <TextBlock Classes="CardTitle" Text="在线样式" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <ComboBox x:Name="CslCatalogSourceEditor" ItemsSource="{Binding CatalogSources}"
                                    DisplayMemberBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedCatalogSource}" HorizontalAlignment="Stretch"
                                    ToolTip.Tip="{Binding SelectedCatalogSource.Description}" />
                          <Button Grid.Column="1" Content="刷新索引" Command="{Binding RefreshCommand}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBox x:Name="CslCatalogSearchEditor" Text="{Binding SearchQuery}"
                                   PlaceholderText="搜索在线样式，留空加载当前源">
                            <TextBox.KeyBindings>
                              <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.KeyBindings>
                          </TextBox>
                          <Button Grid.Column="1" Content="搜索" Command="{Binding SearchCommand}" />
                        </Grid>
                        <TextBlock Text="选择样式源后搜索；刷新索引可获取该来源的最新样式。" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding RemoteStyles}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="csl:CslCatalogStyleViewModel">
                          <Border Classes="CardTile" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                              <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StyleId}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                              </StackPanel>
                              <Button Grid.Column="1" Content="安装" Command="{Binding InstallCommand}"
                                      IsVisible="{Binding IsNotInstalled}" VerticalAlignment="Center" Padding="10,4" />
                              <TextBlock Grid.Column="1" Text="已安装" IsVisible="{Binding IsInstalled}"
                                         Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </DataTemplate>

          <!-- Search Rewrite Settings -->
          <DataTemplate DataType="settings:SearchRewriteSettingsViewModel">
            <StackPanel Spacing="20" MaxWidth="720" Margin="32">
              <TextBlock Text="OCR 结果进入搜索单元后，可通过搜索菜单重建本地 FTS 索引。"
                         FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
              <TextBlock
                Text="为当前资料库维护查询重写规则；「全局」规则对所有搜索配置生效，其余规则仅在对应配置下生效。表格内容和启用复选框的修改都会自动保存并实时生效；「预览」按需构建重写计划，不受「启用查询重写」开关影响。"
                FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />

              <Border Classes="Card">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="CardTitle" Text="重写规则" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Status}" FontSize="12" VerticalAlignment="Center"
                                 Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                      <Button Content="添加规则" Command="{Binding AddRuleCommand}" />
                    </StackPanel>
                  </Grid>

                  <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1"
                            Padding="0,0,0,6" Margin="0,4,0,0">
                      <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition SharedSizeGroup="RewriteEnabled" Width="Auto" />
                          <ColumnDefinition SharedSizeGroup="RewriteType" Width="1.1*" />
                          <ColumnDefinition SharedSizeGroup="RewritePattern" Width="1.3*" />
                          <ColumnDefinition SharedSizeGroup="RewriteReplacement" Width="1.3*" />
                          <ColumnDefinition SharedSizeGroup="RewriteDirection" Width="0.8*" />
                          <ColumnDefinition SharedSizeGroup="RewritePriority" Width="Auto" />
                          <ColumnDefinition SharedSizeGroup="RewriteScope" Width="1*" />
                          <ColumnDefinition SharedSizeGroup="RewriteNote" Width="1.1*" />
                          <ColumnDefinition SharedSizeGroup="RewriteDelete" Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="启用" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                        <TextBlock Grid.Column="1" Text="类型" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                        <TextBlock Grid.Column="2" Text="匹配 / OpenCC 配置" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                        <TextBlock Grid.Column="3" Text="替换" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                        <TextBlock Grid.Column="4" Text="方向" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                        <TextBlock Grid.Column="5" Text="优先级" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                        <TextBlock Grid.Column="6" Text="归属" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                        <TextBlock Grid.Column="7" Text="备注" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                      </Grid>
                    </Border>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Rules}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="settings:SearchRewriteRuleRowViewModel">
                          <Border BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1"
                                  Padding="0,6">
                            <Grid ColumnSpacing="8">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="RewriteEnabled" Width="Auto" />
                                <ColumnDefinition SharedSizeGroup="RewriteType" Width="1.1*" />
                                <ColumnDefinition SharedSizeGroup="RewritePattern" Width="1.3*" />
                                <ColumnDefinition SharedSizeGroup="RewriteReplacement" Width="1.3*" />
                                <ColumnDefinition SharedSizeGroup="RewriteDirection" Width="0.8*" />
                                <ColumnDefinition SharedSizeGroup="RewritePriority" Width="Auto" />
                                <ColumnDefinition SharedSizeGroup="RewriteScope" Width="1*" />
                                <ColumnDefinition SharedSizeGroup="RewriteNote" Width="1.1*" />
                                <ColumnDefinition SharedSizeGroup="RewriteDelete" Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                        ToolTip.Tip="启用状态修改后自动保存并生效" />
                              <ComboBox Grid.Column="1" ItemsSource="{Binding RuleTypeOptions}"
                                        SelectedItem="{Binding SelectedRuleType}"
                                        DisplayMemberBinding="{Binding Label}" />
                              <Grid Grid.Column="2">
                                <TextBox Text="{Binding Pattern}" PlaceholderText="匹配内容"
                                         IsVisible="{Binding IsStandardRule}" />
                                <ComboBox ItemsSource="{Binding OpenccOptions}"
                                          SelectedItem="{Binding Pattern}" IsVisible="{Binding IsOpenccRule}"
                                          ToolTip.Tip="OpenCC 配置名，例如 s2t" />
                              </Grid>
                              <Grid Grid.Column="3">
                                <TextBox Text="{Binding Replacement}" PlaceholderText="替换或展开内容"
                                         IsVisible="{Binding IsStandardRule}" />
                                <TextBlock Text="简繁转换不使用替换值" FontSize="11" VerticalAlignment="Center"
                                           IsVisible="{Binding IsOpenccRule}"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                              </Grid>
                              <ComboBox Grid.Column="4" ItemsSource="{Binding DirectionOptions}"
                                        SelectedItem="{Binding SelectedDirection}"
                                        DisplayMemberBinding="{Binding Label}" />
                              <NumericUpDown Grid.Column="5" Value="{Binding Priority}" Width="110"
                                             Minimum="-1000" Maximum="1000" ShowButtonSpinner="False" />
                              <ComboBox Grid.Column="6" ItemsSource="{Binding ScopeOptions}"
                                        SelectedItem="{Binding SelectedScope}"
                                        DisplayMemberBinding="{Binding Label}" />
                              <TextBox Grid.Column="7" Text="{Binding Note}" PlaceholderText="备注" />
                              <Button Grid.Column="8" Content="删除" Command="{Binding DeleteCommand}"
                                      Classes="Danger" Padding="10,4" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="Card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="CardTitle" Text="预览" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding PreviewQuery}" PlaceholderText="示例查询，例如 臺灣史" />
                    <Button Grid.Column="1" Content="预览" Command="{Binding PreviewCommand}" />
                  </Grid>
                  <TextBlock Text="{Binding PreviewSummary}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <ItemsControl ItemsSource="{Binding PreviewExpandedQueries}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding PreviewWarnings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ErrorBrush}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>

        </controls:RetainedContentHost.DataTemplates>
      </controls:RetainedContentHost>
    </Grid>
  </Grid>
</UserControl>

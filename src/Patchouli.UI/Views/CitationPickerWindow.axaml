<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Patchouli.UI.ViewModels.Citations"
        mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="560"
        x:Class="Patchouli.UI.Views.CitationPickerWindow"
        x:DataType="vm:CitationPickerViewModel"
        Title="选择引用条目"
        Icon="/Assets/AppIcon.ico"
        Width="880" Height="560" MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        WindowDecorations="Full"
        Background="{DynamicResource SurfaceBrush}">

  <Border Margin="1" Padding="20" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1"
          CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
      <StackPanel Spacing="4">
        <TextBlock Text="选择引用条目" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource OnSurfaceBrush}" />
        <TextBlock Text="搜索并添加条目，可调整顺序，并为每条设置定位符（页码）、标签、前缀、后缀与隐藏作者。确认后引用将按所选格式写回编辑器。"
                   FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="*,12,340">
        <!-- Search + results -->
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
          <TextBox Text="{Binding SearchText}" PlaceholderText="搜索标题、作者、年份、刊物或引文键…"
                   x:Name="SearchBox" />
          <Border Grid.Row="1" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1"
                  CornerRadius="4" Background="{DynamicResource SurfaceContainerLowBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Results}" Margin="8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:CitationPickerResultViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MetaLine}" FontSize="12"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="添加" Command="{Binding AddCommand}"
                              CommandParameter="{Binding}" IsEnabled="{Binding !IsPicked}"
                              VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <Button Grid.Row="2" Content="加载更多" Command="{Binding LoadMoreCommand}"
                  IsVisible="{Binding HasMore}" HorizontalAlignment="Left" />
        </Grid>

        <!-- Picked entries -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="8">
          <TextBlock Text="{Binding PickedSummary}" FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource OnSurfaceBrush}" />
          <Border Grid.Row="1" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1"
                  CornerRadius="4" Background="{DynamicResource SurfaceContainerLowBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Picked}" Margin="8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:CitationPickerEntryViewModel">
                    <Border BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="8" Margin="0,0,0,8"
                            Background="{DynamicResource SurfaceBrush}">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding MetaLine}" FontSize="12"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                          </StackPanel>
                          <Button Grid.Column="1" Content="↑" Command="{Binding MoveUpCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="上移" Padding="6,2" />
                          <Button Grid.Column="2" Content="↓" Command="{Binding MoveDownCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="下移" Padding="6,2" />
                          <Button Grid.Column="3" Content="移除" Command="{Binding RemoveCommand}"
                                  CommandParameter="{Binding}" Padding="6,2" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                          <StackPanel Spacing="2">
                            <TextBlock Text="定位符 (locator)" FontSize="11"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            <TextBox Text="{Binding Locator}" PlaceholderText="如 33 或 iv" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="标签 (label)" FontSize="11"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            <TextBox Text="{Binding Label}" PlaceholderText="如 page、chapter" />
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                          <StackPanel Spacing="2">
                            <TextBlock Text="前缀 (prefix)" FontSize="11"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            <TextBox Text="{Binding Prefix}" PlaceholderText="如 see" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="后缀 (suffix)" FontSize="11"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            <TextBox Text="{Binding Suffix}" PlaceholderText="如 and passim" />
                          </StackPanel>
                        </Grid>
                        <CheckBox Content="隐藏作者 (suppress-author)" IsChecked="{Binding SuppressAuthor}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>

      <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="12"
                 Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />

      <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="取消" Command="{Binding CancelCommand}" />
        <Button Content="确认引用" Command="{Binding ConfirmCommand}" Classes="Primary" />
      </StackPanel>
    </Grid>
  </Border>
</Window>

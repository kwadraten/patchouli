<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Patchouli.UI.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="420"
        x:Class="Patchouli.UI.Views.UpdateAvailableDialog"
        x:DataType="vm:UpdateAvailableDialogViewModel"
        Title="{Binding Title}"
        Icon="/Assets/AppIcon.ico"
        Width="520" Height="440"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        WindowDecorations="Full"
        Background="{DynamicResource SurfaceBrush}">

  <Border Margin="1" Padding="20" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1"
          CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock Text="{Binding NewVersionText}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource OnSurfaceBrush}" />
        <TextBlock Text="{Binding CurrentVersionText}" FontSize="12"
                   Foreground="{DynamicResource OnSurfaceVariantBrush}" />
        <TextBlock Text="{Binding PublishedText}" FontSize="12"
                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                   IsVisible="{Binding PublishedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding AssetText}" FontSize="12"
                   Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
      </StackPanel>

      <TextBlock Grid.Row="1" Text="更新说明" FontSize="13" FontWeight="Medium"
                 Foreground="{DynamicResource OnSurfaceBrush}" />

      <Border Grid.Row="2" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1"
              CornerRadius="4" Padding="8" Background="{DynamicResource SurfaceContainerLowBrush}">
        <ScrollViewer>
          <TextBlock Text="{Binding ReleaseNotes}" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />
        </ScrollViewer>
      </Border>

      <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="暂不更新" Command="{Binding PostponeCommand}" />
        <Button Content="下载更新" Command="{Binding DownloadCommand}" Classes="Primary" />
      </StackPanel>
    </Grid>
  </Border>
</Window>

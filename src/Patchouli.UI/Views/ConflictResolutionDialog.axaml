<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Patchouli.UI.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
        x:Class="Patchouli.UI.Views.ConflictResolutionDialog"
        x:DataType="vm:ConflictResolutionDialogViewModel"
        Title="{Binding Title}"
        Icon="/Assets/AppIcon.ico"
        Width="900" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        WindowDecorations="Full"
        Background="{DynamicResource SurfaceBrush}">

  <Border Margin="1" Padding="20" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1"
          CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding ConflictDescription}" FontSize="14"
                     Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SeverityDescription}" FontSize="12"
                     Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="12"
                Padding="10,3" VerticalAlignment="Top">
          <TextBlock Text="{Binding Severity}" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />
        </Border>
      </Grid>

      <Grid Grid.Row="1" IsVisible="{Binding ShowSnapshotPanels}" ColumnDefinitions="*,20,*">
        <Border Grid.Column="0" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1"
                CornerRadius="4" Padding="10">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="本地版本" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"
                       Foreground="{DynamicResource OnSurfaceBrush}" />
            <ScrollViewer Grid.Row="1">
              <TextBlock Text="{Binding LocalContent}" TextWrapping="Wrap" FontFamily="Consolas" />
            </ScrollViewer>
          </Grid>
        </Border>
        <Border Grid.Column="2" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="4"
                Padding="10">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="传入版本" FontWeight="Bold" Margin="0,0,0,10"
                       Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
            <ScrollViewer Grid.Row="1">
              <TextBlock Text="{Binding IncomingContent}" TextWrapping="Wrap" FontFamily="Consolas" />
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer Grid.Row="1" IsVisible="{Binding IsFieldChoiceMode}"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding FieldChoices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ConflictFieldChoiceViewModel">
              <Border Margin="0,0,0,12" Padding="14" BorderBrush="{DynamicResource OutlineVariantBrush}"
                      BorderThickness="1" CornerRadius="4">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                  <TextBlock Grid.Row="0" Text="{Binding Label}" FontWeight="SemiBold" FontSize="14"
                             Foreground="{DynamicResource OnSurfaceBrush}" />
                  <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Padding="10" CornerRadius="4"
                            Background="{DynamicResource SurfaceContainerBrush}">
                      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <RadioButton Grid.Row="0" Content="保留本地值" IsChecked="{Binding KeepLocal}"
                                     GroupName="{Binding FieldKey}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="{Binding LocalValue}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                      </Grid>
                    </Border>
                    <Border Grid.Column="1" Padding="10" CornerRadius="4"
                            Background="{DynamicResource SurfaceContainerBrush}">
                      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <RadioButton Grid.Row="0" Content="采用导入值" IsChecked="{Binding UseIncoming}"
                                     GroupName="{Binding FieldKey}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="{Binding IncomingValue}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                      </Grid>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <ScrollViewer Grid.Row="1" IsVisible="{Binding IsLinkChoiceMode}">
        <ItemsControl ItemsSource="{Binding LinkChoices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ConflictLinkChoiceViewModel">
              <Border Margin="0,0,0,10" Padding="10" BorderBrush="{DynamicResource OutlineVariantBrush}"
                      BorderThickness="1" CornerRadius="4">
                <Grid ColumnDefinitions="2*,3*" ColumnSpacing="12">
                  <StackPanel>
                    <TextBlock Text="{Binding SourceEntryKey}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SourceTitle}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                            SelectedItem="{Binding SelectedOption}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ConflictDialogOption">
                        <StackPanel>
                          <TextBlock Text="{Binding Label}" />
                          <TextBlock Text="{Binding Detail}" FontSize="11"
                                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <ListBox Grid.Row="2" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
               IsVisible="{Binding HasOptions}" MaxHeight="140">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ConflictDialogOption">
            <StackPanel Margin="8,4">
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource OnSurfaceVariantBrush}" FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ItemsControl Grid.Row="3" ItemsSource="{Binding Actions}" HorizontalAlignment="Right">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ConflictDialogActionViewModel">
            <Button Content="{Binding Label}" Command="{Binding SelectCommand}" IsEnabled="{Binding IsEnabled}"
                    ToolTip.Tip="{Binding Description}"
                    Margin="4,0" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </Grid>
  </Border>
</Window>

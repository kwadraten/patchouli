<UserControl x:Class="Patchouli.UI.Views.ItemEditorPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Patchouli.UI.Controls"
             xmlns:editor="using:Patchouli.UI.ViewModels.Editor"
             x:DataType="editor:ItemEditorViewModel">
  <Grid RowDefinitions="Auto,*">
    <Grid Margin="32,32,32,16" ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Header}" FontSize="24" FontWeight="SemiBold"
                   Foreground="{DynamicResource OnSurfaceBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button Content="粘贴 BibLaTeX" Command="{Binding ImportBiblatexFromClipboardCommand}" Height="32" />
        <Button Content="导入 .bib" Command="{Binding ImportBiblatexFromFileCommand}" Height="32" />
        <Button Content="放弃更改" Command="{Binding DiscardCommand}" Height="32" Classes="Danger" />
        <Button Content="保存题录" Command="{Binding SaveCommand}" Height="32"
                Background="{DynamicResource PrimaryContainerBrush}" Foreground="{DynamicResource OnPrimaryBrush}" />
        <Button Content="新建" Command="{Binding NewCommand}" Height="32" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" Margin="32,0,32,32">
      <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Left">
        <!-- Type Selection and Warning -->
        <Border Background="{DynamicResource SurfaceContainerLowestBrush}"
                BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
          <StackPanel Spacing="16">
            <TextBlock Text="文献类型" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
            <ComboBox ItemsSource="{Binding AvailableItemTypes}" SelectedItem="{Binding ItemType}"
                      HorizontalAlignment="Stretch" Height="32" />

            <Border Background="{DynamicResource ErrorContainerBrush}" BorderBrush="{DynamicResource ErrorBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12" IsVisible="{Binding IsGeneralTypeWarningVisible}">
              <StackPanel Spacing="6">
                <TextBlock Text="当前为通用文献，无法直接生成 CSL 引用，请指定具体类型" FontWeight="Bold"
                           Foreground="{DynamicResource OnErrorContainerBrush}" />
                <TextBlock Text="通用的 general 类型通常作为备选方案使用。若要参与引文生成，请选择合适的具体类型如 book, article-journal 等。"
                           Foreground="{DynamicResource OnErrorContainerBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Dynamic Fields -->
        <Border Background="{DynamicResource SurfaceContainerLowestBrush}"
                BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
          <StackPanel Spacing="16">
            <TextBlock Text="核心元数据" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />

            <ItemsControl ItemsSource="{Binding Fields}">
              <ItemsControl.DataTemplates>
                <DataTemplate DataType="editor:ItemFieldDescriptor">
                  <StackPanel Spacing="8" Margin="0,0,0,16">
                    <TextBlock Text="{Binding Label}" FontSize="12"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}" />

                    <TextBox Text="{Binding Value}" IsVisible="{Binding IsString}" />

                    <TextBox Text="{Binding Value}" AcceptsReturn="True" Height="100" TextWrapping="Wrap"
                             IsVisible="{Binding IsMultilineString}" />

                    <TextBox Text="{Binding Value}" PlaceholderText="YYYY-MM-DD、YYYY 或 CSL date-parts，如 [[2026,7,9]]"
                             IsVisible="{Binding IsDate}" />

                    <StackPanel Spacing="8" IsVisible="{Binding IsCreatorList}">
                      <ItemsControl ItemsSource="{Binding Creators}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="editor:CreatorItemViewModel">
                            <StackPanel Spacing="6" Margin="0,0,0,8">
                              <Grid ColumnDefinitions="110,*,Auto,Auto" ColumnSpacing="8">
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableRoles}"
                                          SelectedItem="{Binding Role}" HorizontalAlignment="Stretch" />
                                <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="姓名" />
                                <CheckBox Grid.Column="2" Content="整体署名" IsChecked="{Binding IsLiteral}"
                                          VerticalAlignment="Center" />
                                <Button Grid.Column="3" Content="移除" Command="{Binding RemoveCommand}" Width="64"
                                        HorizontalContentAlignment="Center" />
                              </Grid>
                              <Expander Header="修正姓和名" IsVisible="{Binding IsPersonalName}">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,6,0,0">
                                  <TextBox Grid.Column="0" Text="{Binding Family}" PlaceholderText="姓" />
                                  <TextBox Grid.Column="1" Text="{Binding Given}" PlaceholderText="名" />
                                </Grid>
                              </Expander>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Content="添加作者/贡献者" Command="{Binding AddCreatorCommand}" HorizontalAlignment="Left" />
                    </StackPanel>

                  </StackPanel>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource SurfaceContainerLowestBrush}"
                BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="CSL 预览" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
            <Border Background="{DynamicResource ErrorContainerBrush}" BorderBrush="{DynamicResource ErrorBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10" IsVisible="{Binding HasCslPreviewWarning}">
              <TextBlock Text="{Binding CslPreviewText}" Foreground="{DynamicResource OnErrorContainerBrush}"
                         TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{Binding CslPreviewText}" FontSize="13"
                       Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap"
                       IsVisible="{Binding !HasCslPreviewWarning}" />
          </StackPanel>
        </Border>

        <!-- Bottom Tools (Identifiers & Linked Files) -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
          <Border Grid.Column="0" Background="{DynamicResource SurfaceContainerLowestBrush}"
                  BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Text="标识符" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
              <ScrollViewer MaxHeight="150">
                <ItemsControl ItemsSource="{Binding Identifiers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="editor:IdentifierItemViewModel">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding DisplayText}" FontSize="13"
                                     Foreground="{DynamicResource OnSurfaceBrush}" />
                          <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" FontSize="11"
                                     Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock Text="获取中..." IsVisible="{Binding IsBusy}" FontSize="11"
                                     Foreground="{DynamicResource PrimaryBrush}" />
                          <Button Content="获取元数据" Command="{Binding LookupCommand}" IsVisible="{Binding ShowLookup}" />
                          <Button Content="移除" Command="{Binding RemoveCommand}" IsVisible="{Binding ShowRemove}"
                                  Classes="Danger" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Separator Background="{DynamicResource OutlineVariantBrush}" Margin="0,4" />
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasIdentifierSchemeShortcuts}">
                <TextBlock Text="当前类型推荐：" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                <ItemsControl ItemsSource="{Binding IdentifierSchemeShortcuts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="editor:IdentifierSchemeShortcutViewModel">
                      <Button Content="{Binding Scheme}" Command="{Binding SelectCommand}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Text="类型统一保存为小写；常用值包括 doi、isbn、issn、url、pmid、pmcid、arxiv。" FontSize="11"
                         Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="120,*,*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding IdentifierScheme}" PlaceholderText="类型" />
                <TextBox Grid.Column="1" Text="{Binding IdentifierValue}" PlaceholderText="值" />
                <TextBox Grid.Column="2" Text="{Binding IdentifierNote}" PlaceholderText="备注（可选）" />
                <Button Grid.Column="3" Content="添加" Command="{Binding AddIdentifierCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Background="{DynamicResource SurfaceContainerLowestBrush}"
                  BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Text="关联文件" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
              <ScrollViewer MaxHeight="150">
                <ItemsControl ItemsSource="{Binding LinkedFiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="editor:LinkedDocumentInstanceItemViewModel">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                     Foreground="{DynamicResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Status}" FontSize="11"
                                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="主要文件" FontSize="11"
                                   Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"
                                   IsVisible="{Binding IsPrimary}" />
                        <Button Grid.Column="2" Content="设为主要文件" Command="{Binding SetPrimaryCommand}"
                                IsVisible="{Binding CanSetPrimary}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Separator Background="{DynamicResource OutlineVariantBrush}" Margin="0,4" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <controls:PathPickerTextBox Grid.Column="0" Path="{Binding FilePath}" PickerMode="OpenFile"
                                            DialogTitle="选择关联文件" PlaceholderText="文件路径" />
                <Button Grid.Column="1" Content="注册" Command="{Binding RegisterFileCommand}" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

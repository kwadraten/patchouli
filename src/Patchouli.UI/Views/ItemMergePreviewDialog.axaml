<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Patchouli.UI.ViewModels.Dialogs"
        xmlns:bib="using:Patchouli.Core.Bibliography"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
        x:Class="Patchouli.UI.Views.ItemMergePreviewDialog"
        x:DataType="vm:ItemMergePreviewDialogViewModel"
        Title="{Binding Title}"
        Icon="/Assets/AppIcon.ico"
        Width="640" MinHeight="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        WindowDecorations="Full"
        Background="{DynamicResource SurfaceBrush}">

  <Border Margin="1" Padding="20" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1"
          CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
      <!-- Header -->
      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Text="选择保留目标或来源的字段值，然后点击合并。"
                   FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
      </Grid>

      <!-- Body -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
          <!-- Conflict fields -->
          <StackPanel Spacing="8" IsVisible="{Binding HasConflicts}">
            <TextBlock Text="冲突字段" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource OnSurfaceBrush}" />
            <Border BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="4">
              <DataGrid ItemsSource="{Binding Conflicts}" IsReadOnly="True" GridLinesVisibility="Horizontal"
                        CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="False"
                        AutoGenerateColumns="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="字段" Binding="{Binding Label}" Width="120" />
                  <DataGridTextColumn Header="目标值" Binding="{Binding TargetValue}" Width="*" />
                  <DataGridTextColumn Header="来源值" Binding="{Binding SourceValue}" Width="*" />
                  <DataGridTextColumn Header="将使用" Binding="{Binding SelectedValue}" Width="*" />
                  <DataGridCheckBoxColumn Header="使用来源" Binding="{Binding UseSourceValue}" Width="90" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </StackPanel>

          <!-- Missing fields -->
          <StackPanel Spacing="8" IsVisible="{Binding HasMissingFields}">
            <TextBlock Text="将补全的字段" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource OnSurfaceBrush}" />
            <Border BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="4"
                    Background="{DynamicResource SurfaceContainerLowBrush}" Padding="12">
              <ItemsControl ItemsSource="{Binding MissingFields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="bib:ItemMergeMissingField">
                    <Grid ColumnDefinitions="120,*" ColumnSpacing="8" Margin="0,0,0,4">
                      <TextBlock Text="{Binding Label}" FontSize="12"
                                 Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding SourceValue}" FontSize="12"
                                 Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>

          <!-- Tags and documents -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="8" IsVisible="{Binding HasTags}">
              <TextBlock Text="合并后标签" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource OnSurfaceBrush}" />
              <TextBlock Text="{Binding TagUnionText}" FontSize="12"
                         Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8" IsVisible="{Binding HasDocumentsToTransfer}"
                        VerticalAlignment="Top">
              <TextBlock Text="转移文档" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource OnSurfaceBrush}" />
              <TextBlock Text="{Binding DocumentInstancesToTransfer, StringFormat='{}{0} 个 DocumentInstance 将转移到目标题录'}"
                         FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
            </StackPanel>
          </Grid>

          <!-- No changes note -->
          <Border BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="4"
                  Padding="12" Background="{DynamicResource SurfaceContainerLowBrush}">
            <TextBlock Text="没有冲突或缺失字段时，仅文档和标签会被合并。"
                       FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Buttons -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="16">
        <Button Content="互换方向" Command="{Binding SwapCommand}" IsEnabled="{Binding CanMerge}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="取消" Command="{Binding CancelCommand}" />
          <Button Content="合并" Command="{Binding MergeCommand}" IsEnabled="{Binding CanMerge}" Classes="Primary" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>

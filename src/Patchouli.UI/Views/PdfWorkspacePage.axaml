<UserControl x:Class="Patchouli.UI.Views.PdfWorkspacePage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lucide="using:Patchouli.Lucide.Avalonia"
             xmlns:controls="using:Patchouli.UI.Controls"
             xmlns:vm="using:Patchouli.UI.ViewModels"
             x:DataType="vm:PdfWorkspaceViewModel">
  <UserControl.Resources>
    <!-- Shared context menu for canvas boxes and the edit-mode box tree.
         DataContext is the PdfBBoxViewModel of the control the flyout is attached to. -->
    <MenuFlyout x:Key="BBoxContextMenu" x:DataType="vm:PdfBBoxViewModel">
      <MenuItem Header="编辑" Click="OnOpenBoxEditor" />
      <MenuItem Header="跳转到续接源框" Command="{Binding JumpToContinuationSourceCommand}"
                IsVisible="{Binding IsContinuation}" />
      <MenuItem Header="局部 OCR" Command="{Binding Workspace.RunLocalOcrCommand}"
                IsVisible="{Binding Workspace.IsSingleSelection}" />
      <MenuItem Header="拆分" Command="{Binding Workspace.SplitSelectedCommand}"
                IsVisible="{Binding Workspace.IsSingleSelection}" />
      <MenuItem Header="合并选中" Command="{Binding Workspace.MergeSelectedCommand}"
                IsVisible="{Binding Workspace.IsMultiSelection}" />
      <MenuItem Header="上移" Command="{Binding Workspace.MoveSelectedUpCommand}" />
      <MenuItem Header="下移" Command="{Binding Workspace.MoveSelectedDownCommand}" />
      <MenuItem Header="移入为上方兄弟的子级" Command="{Binding Workspace.IndentSelectedCommand}" />
      <MenuItem Header="移出到上一级" Command="{Binding Workspace.OutdentSelectedCommand}" />
      <MenuItem Header="从文档流排除/纳入" Command="{Binding Workspace.ToggleSuppressedCommand}" />
      <MenuItem Header="删除" Command="{Binding DeleteCommand}" />
    </MenuFlyout>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.ToolbarButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="ToggleButton.ToolbarToggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="ToggleButton.ToolbarToggle:checked">
      <Setter Property="Background" Value="{DynamicResource PrimaryContainerBrush}" />
    </Style>
    <Style Selector="Border.BBox">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="#22FFFFFF" />
    </Style>
    <Style Selector="Border.BBox.selected">
      <Setter Property="BorderThickness" Value="4" />
      <Setter Property="Background" Value="#44FFFFFF" />
    </Style>
    <Style Selector="Border.BBox.draft">
      <Setter Property="BorderBrush" Value="DarkOrange" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="Border.BBox.suppressed">
      <Setter Property="Opacity" Value="0.35" />
      <Setter Property="Background" Value="#22000000" />
    </Style>
    <Style Selector="TextBlock.previewHeading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Button.PreviewBlock">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.PreviewBlock.selected">
      <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}" />
    </Style>
    <Style Selector="Border.TreeRow">
      <Setter Property="Background" Value="{DynamicResource SurfaceContainerLowestBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Border.TreeRow.selected">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="Border.TreeRow.suppressed">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Border.TreeRow.dropAbove">
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="BorderThickness" Value="1,3,1,1" />
    </Style>
    <Style Selector="Border.TreeRow.dropBelow">
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,3" />
    </Style>
    <Style Selector="Border.BBox.overlapWarning">
      <Setter Property="Background" Value="#55FF8C00" />
    </Style>
    <Style Selector="Border.TreeRow.overlapWarning">
      <Setter Property="BorderBrush" Value="DarkOrange" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Rectangle.overlapMark">
      <Setter Property="Fill" Value="#44FF8C00" />
      <Setter Property="Stroke" Value="DarkOrange" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeDashArray" Value="4,2" />
      <Setter Property="RadiusX" Value="3" />
      <Setter Property="RadiusY" Value="3" />
    </Style>
    <Style Selector="Line.continuationLink">
      <Setter Property="Stroke" Value="#2E7D32" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeDashArray" Value="4,2" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Border.crossPageMark">
      <Setter Property="Background" Value="#DDEEDC" />
      <Setter Property="BorderBrush" Value="#2E7D32" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,2" />
    </Style>
    <Style Selector="Border.TreeRow.continuation">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Border.WizardCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceContainerLowestBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="12,0,12,12" />
    </Style>
    <Style Selector="Border.SidebarHeader">
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="44,*">
    <!-- Toolbar -->
    <Border BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="12,0"
            Background="{DynamicResource SurfaceContainerLowBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <!-- Page navigation -->
          <Button Classes="ToolbarButton" Command="{Binding PreviousPageCommand}">
            <lucide:Lucide Icon="ChevronLeft" Width="14" Height="14"
                           StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
          </Button>
          <TextBox Text="{Binding PageNumberText, Mode=OneWay}" Width="36" Height="24" FontSize="12"
                   BorderThickness="1"
                   BorderBrush="{DynamicResource OutlineVariantBrush}" CornerRadius="3"
                   HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0"
                   KeyDown="OnPageNumberKeyDown" GotFocus="OnPageNumberGotFocus" />
          <TextBlock Text="{Binding PageTotalText}" FontSize="13" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                     VerticalAlignment="Center" Margin="4,0" />
          <Button Classes="ToolbarButton" Command="{Binding NextPageCommand}">
            <lucide:Lucide Icon="ChevronRight" Width="14" Height="14"
                           StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
          </Button>
        </StackPanel>

        <!-- Zoom and Tools Controls -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button Classes="ToolbarButton" Command="{Binding ZoomOutCommand}">
            <TextBlock Text="-" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                       VerticalAlignment="Center" />
          </Button>
          <TextBlock Text="{Binding ZoomText}" FontSize="13" Foreground="{DynamicResource OnSurfaceBrush}"
                     VerticalAlignment="Center" Margin="4,0" />
          <Button Classes="ToolbarButton" Command="{Binding ZoomInCommand}">
            <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                       VerticalAlignment="Center" />
          </Button>

          <Border Width="1" Height="20" Background="{DynamicResource OutlineVariantBrush}" Margin="8,0" />

          <ToggleButton Classes="ToolbarToggle" IsChecked="{Binding IsSelectToolActive}"
                        Command="{Binding SelectToolCommand}" ToolTip.Tip="点选工具">
            <lucide:Lucide Icon="MousePointer2" Width="16" Height="16" Margin="0,-2,0,0" />
          </ToggleButton>
          <ToggleButton Classes="ToolbarToggle" IsChecked="{Binding IsMarqueeToolActive}"
                        Command="{Binding MarqueeToolCommand}" ToolTip.Tip="框选工具（拖出矩形选择多个边界框）">
            <lucide:Lucide Icon="SquareDashed" Width="16" Height="16" Margin="0,-2,0,0" />
          </ToggleButton>
          <ToggleButton Classes="ToolbarToggle" IsChecked="{Binding IsCreateBoxToolActive}"
                        Command="{Binding CreateBoxToolCommand}" IsEnabled="{Binding IsEditMode}"
                        ToolTip.Tip="新建边界框（在页面上框出区域）">
            <lucide:Lucide Icon="Plus" Width="16" Height="16" Margin="0,-2,0,0" />
          </ToggleButton>
        </StackPanel>

        <!-- Edit Mode Controls -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button IsVisible="{Binding IsEditMode}" ToolTip.Tip="{Binding OcrPresetStatusText}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <lucide:Lucide Icon="ScanText" Width="14" Height="14" />
              <TextBlock Text="OCR" FontSize="12" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="本页 OCR" Command="{Binding RunCurrentPageOcrCommand}" />
                <MenuItem Header="逻辑页 OCR" Command="{Binding RunLogicalPageOcrCommand}" />
                <MenuItem Header="文档级 OCR" Command="{Binding RunDocumentOcrCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Command="{Binding EnterEditModeCommand}" IsVisible="{Binding !IsEditMode}" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <lucide:Lucide Icon="Pencil" Width="14" Height="14" />
              <TextBlock Text="编辑 OCR 结果" FontSize="12" />
            </StackPanel>
          </Button>

          <Border Width="1" Height="20" Background="{DynamicResource OutlineVariantBrush}" Margin="4,0" />

          <ToggleButton Classes="ToolbarToggle" IsChecked="{Binding IsSidebarOpen}"
                        IsEnabled="{Binding !IsEditMode}" ToolTip.Tip="切换侧边栏">
            <lucide:Lucide Icon="List" Width="14" Height="14" />
          </ToggleButton>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Split View -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="400" MinWidth="{Binding SidebarMinWidth}" MaxWidth="{Binding SidebarMaxWidth}">
          <ColumnDefinition.SharedSizeGroup>SidebarGroup</ColumnDefinition.SharedSizeGroup>
        </ColumnDefinition>
      </Grid.ColumnDefinitions>

      <!-- Left: PDF Viewer Canvas -->
      <Border Background="{DynamicResource SurfaceContainerHighestBrush}">
        <Panel>
          <ScrollViewer x:Name="PdfScrollViewer" HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        PointerPressed="OnScrollPointerPressed"
                        PointerMoved="OnScrollPointerMoved"
                        PointerReleased="OnScrollPointerReleased">
            <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20">
              <LayoutTransformControl.LayoutTransform>
                <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
              </LayoutTransformControl.LayoutTransform>
              <Border Background="#FFFFFF" BorderThickness="1" BorderBrush="{DynamicResource OutlineVariantBrush}"
                      CornerRadius="4" BoxShadow="0 4 16 #22000000">
                <Grid MinWidth="360" MinHeight="480">
                  <Border Background="Transparent" PointerPressed="OnCanvasBackgroundPressed" />
                  <Image Source="{Binding Image}" Width="{Binding ActualWidthPixels}"
                         Height="{Binding ActualHeightPixels}" Stretch="None" IsVisible="{Binding HasImage}"
                         IsHitTestVisible="False" />

                  <ItemsControl x:Name="BBoxItems" ItemsSource="{Binding BoundingBoxes}"
                                Width="{Binding ActualWidthPixels}"
                                Height="{Binding ActualHeightPixels}" IsVisible="{Binding HasImage}">
                    <ItemsControl.ItemContainerTheme>
                      <ControlTheme TargetType="ContentPresenter" x:DataType="vm:PdfBBoxViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                      </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PdfBBoxViewModel">
                        <Border Classes="BBox"
                                Classes.selected="{Binding IsSelected}"
                                Classes.draft="{Binding IsDraft}"
                                Classes.suppressed="{Binding IsSuppressed}"
                                Classes.overlapWarning="{Binding HasOverlapWarning}"
                                BorderBrush="{Binding VisualBoxColor}"
                                Width="{Binding Width}"
                                Height="{Binding Height}"
                                Cursor="Hand"
                                ContextFlyout="{StaticResource BBoxContextMenu}"
                                PointerPressed="OnBBoxPointerPressed"
                                PointerMoved="OnBBoxPointerMoved"
                                PointerReleased="OnBBoxPointerReleased"
                                ContextRequested="OnBBoxContextRequested">
                          <Panel IsVisible="{Binding ShowHandles}" IsHitTestVisible="False">
                            <lucide:Lucide Icon="Move" Width="14" Height="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           StrokeBrush="{Binding VisualBoxColor}" />
                            <Ellipse Width="10" Height="10" Fill="White"
                                     Stroke="{Binding VisualBoxColor}" StrokeThickness="2"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-5" />
                            <Ellipse Width="10" Height="10" Fill="White"
                                     Stroke="{Binding VisualBoxColor}" StrokeThickness="2"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-5" />
                            <Ellipse Width="10" Height="10" Fill="White"
                                     Stroke="{Binding VisualBoxColor}" StrokeThickness="2"
                                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-5" />
                            <Ellipse Width="10" Height="10" Fill="White"
                                     Stroke="{Binding VisualBoxColor}" StrokeThickness="2"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-5" />
                          </Panel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Overlap warning markers (drawn over the intersection of overlapping boxes) -->
                  <ItemsControl x:Name="OverlapItems" ItemsSource="{Binding OverlapMarkers}"
                                Width="{Binding ActualWidthPixels}"
                                Height="{Binding ActualHeightPixels}" IsVisible="{Binding HasImage}">
                    <ItemsControl.ItemContainerTheme>
                      <ControlTheme TargetType="ContentPresenter" x:DataType="vm:PdfOverlapMarkerViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                      </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PdfOverlapMarkerViewModel">
                        <Rectangle Classes="overlapMark"
                                   Width="{Binding Width}"
                                   Height="{Binding Height}"
                                   Cursor="Hand"
                                   ToolTip.Tip="边界框重叠,点击选中两个框"
                                   PointerPressed="OnOverlapMarkerPressed" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Paragraph continuation links (dashed connectors between same-paragraph boxes) -->
                  <ItemsControl x:Name="ContinuationItems" ItemsSource="{Binding ContinuationLinks}"
                                Width="{Binding ActualWidthPixels}"
                                Height="{Binding ActualHeightPixels}" IsVisible="{Binding HasImage}"
                                IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PdfContinuationLinkViewModel">
                        <Line Classes="continuationLink"
                              StartPoint="{Binding Start}"
                              EndPoint="{Binding End}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Cross-page continuation badges (source paragraph text lives on an earlier page) -->
                  <ItemsControl x:Name="CrossPageContinuationItems"
                                ItemsSource="{Binding CrossPageContinuationMarkers}"
                                Width="{Binding ActualWidthPixels}"
                                Height="{Binding ActualHeightPixels}" IsVisible="{Binding HasImage}">
                    <ItemsControl.ItemContainerTheme>
                      <ControlTheme TargetType="ContentPresenter" x:DataType="vm:PdfCrossPageContinuationViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                      </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PdfCrossPageContinuationViewModel">
                        <Border Classes="crossPageMark"
                                Cursor="Hand"
                                ToolTip.Tip="该框与上一页的源框属于同一段落,点击跳转到源框"
                                PointerPressed="OnCrossPageMarkPressed">
                          <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#1B5E20" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Drawing Overlay (Captures mouse events) -->
                  <Border Background="Transparent"
                          Width="{Binding ActualWidthPixels}"
                          Height="{Binding ActualHeightPixels}"
                          IsVisible="{Binding HasImage}"
                          IsHitTestVisible="{Binding IsRectToolActive}"
                          PointerPressed="OnCanvasPointerPressed"
                          PointerMoved="OnCanvasPointerMoved"
                          PointerReleased="OnCanvasPointerReleased" />

                  <!-- Selection Drawing Preview -->
                  <Canvas Width="{Binding ActualWidthPixels}" Height="{Binding ActualHeightPixels}"
                          IsVisible="{Binding HasImage}" IsHitTestVisible="False">
                    <Border Classes="BBox draft"
                            BorderBrush="DarkOrange"
                            Canvas.Left="{Binding SelectionLeft}"
                            Canvas.Top="{Binding SelectionTop}"
                            Width="{Binding SelectionWidth}"
                            Height="{Binding SelectionHeight}"
                            IsVisible="{Binding SelectionVisible}" />
                  </Canvas>

                  <!-- Split Draft Boxes Overlay -->
                  <ItemsControl ItemsSource="{Binding SplitDraftBoxes}"
                                Width="{Binding ActualWidthPixels}"
                                Height="{Binding ActualHeightPixels}"
                                IsVisible="{Binding HasImage}" IsHitTestVisible="False">
                    <ItemsControl.ItemContainerTheme>
                      <ControlTheme TargetType="ContentPresenter" x:DataType="vm:SplitDraftBoxViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                      </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SplitDraftBoxViewModel">
                        <Border Classes="BBox draft"
                                BorderBrush="DarkOrange"
                                Width="{Binding Width}"
                                Height="{Binding Height}">
                          <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold"
                                     Foreground="DarkOrange" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsVisible="{Binding HasNoImage}">
                    <lucide:Lucide Icon="FolderOpen" Width="32" Height="32"
                                   StrokeBrush="{DynamicResource PrimaryBrush}" />
                    <TextBlock Text="工作台预览" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Item.Title}"
                               FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}"
                               Width="400" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Width="220" Height="4" IsVisible="{Binding IsBusy}" />
                  </StackPanel>

                  <StackPanel Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                              IsVisible="{Binding HasImage}">
                    <Border Background="#CCFFFFFF" Padding="8,4" CornerRadius="4">
                      <TextBlock Text="{Binding PageNumberText}" FontSize="11"
                                 Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                    </Border>
                    <!-- Source validation indicator: "validating" is transient and non-blocking,
                         while a changed/unavailable source shows a distinct warning (AC16). -->
                    <Border Background="#CCE3F2FD" BorderBrush="#1976D2" BorderThickness="1" Padding="8,4"
                            CornerRadius="4" IsVisible="{Binding IsSourceValidating}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:Lucide Icon="refresh-cw" Width="12" Height="12"
                                       StrokeBrush="#1565C0" />
                        <TextBlock Text="正在验证源文件..." FontSize="11" Foreground="#1565C0"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <Border Background="#CCFFF3E0" BorderBrush="#E65100" BorderThickness="1" Padding="8,4"
                            CornerRadius="4" IsVisible="{Binding HasSourceWarning}">
                      <TextBlock Text="{Binding SourceWarning}" FontSize="11" Foreground="#8A4B00"
                                 TextWrapping="Wrap" MaxWidth="380" />
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
            </LayoutTransformControl>
          </ScrollViewer>
        </Panel>
      </Border>

      <!-- Splitter -->
      <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource OutlineVariantBrush}"
                    IsVisible="{Binding IsSidebarOpen}" />

      <!-- Right: Sidebar Viewer/Editor -->
      <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" IsVisible="{Binding IsSidebarOpen}">
        <Grid RowDefinitions="Auto,Auto,*">
          <!-- Split wizard -->
          <Border Classes="WizardCard" Grid.RowSpan="3" IsVisible="{Binding IsSplitPending}">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
              <TextBlock Text="拆分边界框" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Grid.Row="1" Text="{Binding SplitStepText}" TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource OnSurfaceVariantBrush}" />
              <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                <TextBox Text="{Binding SplitFirstText}" AcceptsReturn="True" TextWrapping="Wrap"
                         PlaceholderText="第一个边界框内容" />
                <TextBox Grid.Column="1" Text="{Binding SplitSecondText}" AcceptsReturn="True" TextWrapping="Wrap"
                         PlaceholderText="第二个边界框内容" />
              </Grid>
              <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="取消拆分" Command="{Binding CancelSplitCommand}" />
                <Button Content="确认拆分" Command="{Binding ConfirmSplitCommand}"
                        IsEnabled="{Binding CanConfirmSplit}"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="{DynamicResource OnPrimaryBrush}" />
              </StackPanel>
            </Grid>
          </Border>
          <!-- Merge wizard -->
          <Border Grid.Row="1" Classes="WizardCard" IsVisible="{Binding IsMergePending}">
            <StackPanel Spacing="8">
              <TextBlock Text="确认合并内容" FontWeight="SemiBold" FontSize="14" />
              <TextBox Text="{Binding MergeText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"
                       PlaceholderText="合并结果内容（必填）" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="取消合并" Command="{Binding CancelMergeCommand}" />
                <Button Content="确认合并" Command="{Binding ConfirmMergeCommand}"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="{DynamicResource OnPrimaryBrush}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Grid Grid.Row="2" IsVisible="{Binding !IsSplitPending}">
            <!-- View mode: tabbed sidebar — page content (read-only Markdown preview) or version history -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding !IsEditMode}">
              <Border Classes="SidebarHeader">
                <Grid ColumnDefinitions="Auto,*" Height="32">
                  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SidebarTabTitle}" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center"
                            ToolTip.Tip="切换侧栏视图">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="页面内容" Command="{Binding ShowContentTabCommand}" />
                          <MenuItem Header="版本历史" Command="{Binding ShowHistoryTabCommand}" />
                        </MenuFlyout>
                      </Button.Flyout>
                      <lucide:Lucide Icon="ChevronDown" Width="14" Height="14"
                                     StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
                    </Button>
                  </StackPanel>
                  <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Command="{Binding CopyMarkdownCommand}"
                          Background="Transparent" IsVisible="{Binding !IsHistoryTabActive}"
                          ToolTip.Tip="复制当前页面的规范 Markdown">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <lucide:Lucide Icon="Copy" Width="14" Height="14"
                                     StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
                      <TextBlock Text="复制 Markdown" FontSize="12" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
              <Grid Grid.Row="1">
                <!-- Tab: page content -->
                <Grid IsVisible="{Binding !IsHistoryTabActive}">
                  <ScrollViewer x:Name="PreviewScrollViewer">
                    <ItemsControl x:Name="PreviewItems" ItemsSource="{Binding PreviewBlocks}" Margin="16">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MarkdownPreviewBlockViewModel">
                          <Button Classes="PreviewBlock" Classes.selected="{Binding IsSelected}"
                                  Command="{Binding SelectCommand}" HorizontalContentAlignment="Stretch"
                                  Padding="8" Margin="0,0,0,4">
                            <StackPanel Spacing="4">
                              <Border IsVisible="{Binding IsMedia}" Padding="12" CornerRadius="4"
                                      Background="{DynamicResource SurfaceContainerHighestBrush}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                  <lucide:Lucide Icon="SquareDashed" Width="24" Height="24"
                                                 StrokeBrush="{DynamicResource PrimaryBrush}" />
                                  <TextBlock Text="{Binding MediaLabel}" HorizontalAlignment="Center"
                                             FontWeight="SemiBold" />
                                  <TextBlock Text="{Binding Markdown}" TextWrapping="Wrap"
                                             HorizontalAlignment="Center" TextAlignment="Center"
                                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                </StackPanel>
                              </Border>
                              <controls:MarkdownTextBlock Markdown="{Binding Markdown}" Block="{Binding Block}"
                                                          TextWrapping="Wrap"
                                                          Classes.previewHeading="{Binding IsHeading}"
                                                          IsVisible="{Binding !IsMedia}" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <TextBlock Text="空" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" Opacity="0.6"
                             IsVisible="{Binding HasNoPreviewBlocks}" />
                </Grid>

                <!-- Tab: version history (graph | commit | description | date) -->
                <ScrollViewer IsVisible="{Binding IsHistoryTabActive}" Margin="16,8">
                  <StackPanel>
                    <TextBlock Text="没有已提交的历史版本。" FontSize="12"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               IsVisible="{Binding !HasPageRevisions}" />
                    <StackPanel IsVisible="{Binding HasPageRevisions}">
                      <Grid ColumnDefinitions="26,64,*,100" ColumnSpacing="8" Height="24">
                        <TextBlock Grid.Column="1" Text="提交" Classes="HistoryHeaderText" />
                        <TextBlock Grid.Column="2" Text="说明" Classes="HistoryHeaderText" />
                        <TextBlock Grid.Column="3" Text="日期" Classes="HistoryHeaderText" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource OutlineVariantBrush}" Margin="0,0,0,2" />
                      <ItemsControl ItemsSource="{Binding PageRevisions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:PageRevisionViewModel">
                            <Grid ColumnDefinitions="26,64,*,100" ColumnSpacing="8" Height="30"
                                  Classes="HistoryRow">
                              <Grid.ContextMenu>
                                <ContextMenu x:DataType="vm:PageRevisionViewModel">
                                  <MenuItem Header="查看此版本" Command="{Binding ViewCommand}" />
                                  <MenuItem Header="恢复此版本" Command="{Binding RevertCommand}" />
                                </ContextMenu>
                              </Grid.ContextMenu>
                              <Canvas Width="26" ClipToBounds="False">
                                <Rectangle Width="2" Height="15" Canvas.Left="11" Canvas.Top="0"
                                           Fill="{DynamicResource OutlineVariantBrush}"
                                           IsVisible="{Binding !IsNewest}" />
                                <Rectangle Width="2" Height="15" Canvas.Left="11" Canvas.Top="15"
                                           Fill="{DynamicResource OutlineVariantBrush}"
                                           IsVisible="{Binding !IsOldest}" />
                                <Path Stroke="#D97706" StrokeThickness="2" Data="{Binding RevertLinkGeometry}"
                                      IsVisible="{Binding HasRevertLink}" />
                                <Ellipse Width="10" Height="10" Canvas.Left="7" Canvas.Top="10"
                                         Fill="{Binding Source, Converter={StaticResource VersionSourceConverter}, ConverterParameter=Brush}" />
                              </Canvas>
                              <TextBlock Grid.Column="1" Text="{Binding ShortId}" Classes="HistoryHash" />
                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                          VerticalAlignment="Center">
                                <Border Classes="HistoryBadge"
                                        Background="{Binding Source, Converter={StaticResource VersionSourceConverter}, ConverterParameter=Brush}">
                                  <TextBlock
                                    Text="{Binding Source, Converter={StaticResource VersionSourceConverter}, ConverterParameter=Label}" />
                                </Border>
                                <Border Classes="HistoryBadge" Background="{DynamicResource PrimaryBrush}"
                                        IsVisible="{Binding IsCurrent}">
                                  <TextBlock Text="当前" />
                                </Border>
                                <TextBlock Text="{Binding NoteText}" Classes="HistoryText" />
                              </StackPanel>
                              <TextBlock Grid.Column="3" Text="{Binding DateText}" Classes="HistoryText"
                                         Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Grid>

            <!-- Edit mode: Box tree -->
            <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsEditMode}">
              <Border Classes="SidebarHeader">
                <TextBlock Text="边界框列表" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
              </Border>
              <Grid Grid.Row="1">
                <ScrollViewer>
                  <ItemsControl x:Name="BoxTreeItems" ItemsSource="{Binding TreeBoxes}" Margin="12">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PdfBBoxViewModel">
                        <Border Classes="TreeRow"
                                Classes.selected="{Binding IsSelected}"
                                Classes.suppressed="{Binding IsSuppressed}"
                                Classes.overlapWarning="{Binding HasOverlapWarning}"
                                Classes.continuation="{Binding IsContinuation}"
                                Margin="{Binding TreeMargin}"
                                ContextFlyout="{StaticResource BBoxContextMenu}"
                                PointerPressed="OnTreeNodePointerPressed"
                                PointerMoved="OnTreeNodePointerMoved"
                                PointerReleased="OnTreeNodePointerReleased">
                          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                            <Border Width="16" VerticalAlignment="Center">
                              <Button IsVisible="{Binding HasChildren}" Background="Transparent"
                                      BorderThickness="0" Padding="0" Cursor="Hand"
                                      PointerPressed="OnTreeExpandTogglePressed"
                                      Click="OnTreeExpandToggle">
                                <lucide:Lucide Icon="ChevronRight" Width="12" Height="12"
                                               RenderTransformOrigin="50%,50%"
                                               StrokeBrush="{DynamicResource OnSurfaceVariantBrush}">
                                  <lucide:Lucide.RenderTransform>
                                    <RotateTransform Angle="{Binding TreeChevronAngle}" />
                                  </lucide:Lucide.RenderTransform>
                                </lucide:Lucide>
                              </Button>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding ReadingOrder, StringFormat='#{0}'}" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                            <Border Grid.Column="2" Background="{Binding BoxColor}" CornerRadius="4" Padding="6,1"
                                    VerticalAlignment="Center">
                              <TextBlock Text="{Binding BoxType}" FontSize="11" Foreground="#FFFFFF"
                                         FontWeight="Bold" />
                            </Border>
                            <TextBlock Grid.Column="3" Text="{Binding Summary}" FontSize="13"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="已排除" FontSize="11" VerticalAlignment="Center"
                                       IsVisible="{Binding IsSuppressed}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="空" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource OnSurfaceVariantBrush}" Opacity="0.6"
                           IsVisible="{Binding HasNoBoundingBoxes}" />
              </Grid>
              <Border Grid.Row="2" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,1,0,0"
                      Padding="14,10">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Content="放弃更改" Command="{Binding CancelEditModeCommand}"
                          Foreground="{DynamicResource ErrorBrush}" Background="Transparent" />
                  <Button Command="{Binding SaveAndExitCommand}"
                          Background="{DynamicResource PrimaryBrush}"
                          Foreground="{DynamicResource OnPrimaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <lucide:Lucide Icon="Save" Width="14" Height="14" />
                      <TextBlock Text="保存并退出" FontSize="12" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Border>

    </Grid>
  </Grid>
</UserControl>

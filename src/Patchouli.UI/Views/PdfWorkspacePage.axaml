<UserControl x:Class="Patchouli.UI.Views.PdfWorkspacePage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lucide="using:Patchouli.Lucide.Avalonia"
             xmlns:vm="using:Patchouli.UI.ViewModels"
             x:DataType="vm:PdfWorkspaceViewModel">
  <UserControl.Styles>
    <Style Selector="Button.ToolbarButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="ToggleButton.ToolbarToggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="ToggleButton.ToolbarToggle:checked">
      <Setter Property="Background" Value="{DynamicResource PrimaryContainerBrush}" />
    </Style>
    <Style Selector="Border.BBox">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="#22FFFFFF" />
    </Style>
    <Style Selector="Border.BBox.selected">
      <Setter Property="BorderThickness" Value="4" />
      <Setter Property="Background" Value="#44FFFFFF" />
    </Style>
    <Style Selector="Border.BBox.staging">
      <Setter Property="BorderBrush" Value="DarkOrange" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="44,*">
    <!-- Toolbar -->
    <Border BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="12,0"
            Background="{DynamicResource SurfaceContainerLowBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <!-- Page navigation -->
          <Button Classes="ToolbarButton" Command="{Binding PreviousPageCommand}">
            <lucide:Lucide Icon="ChevronLeft" Width="14" Height="14"
                           StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
          </Button>
          <TextBox Text="{Binding PageNumberText}" Width="36" Height="24" FontSize="12" BorderThickness="1"
                   BorderBrush="{DynamicResource OutlineVariantBrush}" CornerRadius="3"
                   HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" IsReadOnly="True" />
          <TextBlock Text="{Binding PageTotalText}" FontSize="13" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                     VerticalAlignment="Center" Margin="4,0" />
          <Button Classes="ToolbarButton" Command="{Binding NextPageCommand}">
            <lucide:Lucide Icon="ChevronRight" Width="14" Height="14"
                           StrokeBrush="{DynamicResource OnSurfaceVariantBrush}" />
          </Button>
        </StackPanel>

        <!-- Zoom and Tools Controls -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button Classes="ToolbarButton" Command="{Binding ZoomOutCommand}">
            <TextBlock Text="-" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                       VerticalAlignment="Center" />
          </Button>
          <TextBlock Text="{Binding ZoomText}" FontSize="13" Foreground="{DynamicResource OnSurfaceBrush}"
                     VerticalAlignment="Center" Margin="4,0" />
          <Button Classes="ToolbarButton" Command="{Binding ZoomInCommand}">
            <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                       VerticalAlignment="Center" />
          </Button>

          <Border Width="1" Height="20" Background="{DynamicResource OutlineVariantBrush}" Margin="8,0" />

          <ToggleButton Classes="ToolbarToggle" IsChecked="{Binding !IsDrawToolActive}"
                        Command="{Binding SelectToolCommand}" ToolTip.Tip="点选工具">
            <lucide:Lucide Icon="MousePointer2" Width="16" Height="16" Margin="0,-2,0,0" />
          </ToggleButton>
          <ToggleButton Classes="ToolbarToggle" IsChecked="{Binding IsDrawToolActive}"
                        Command="{Binding DrawToolCommand}" ToolTip.Tip="框选工具">
            <lucide:Lucide Icon="SquareDashed" Width="16" Height="16" Margin="0,-2,0,0" />
          </ToggleButton>
        </StackPanel>

        <!-- Edit Mode Controls -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding EnterEditModeCommand}" IsVisible="{Binding !IsEditMode}" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <lucide:Lucide Icon="Pencil" Width="14" Height="14" />
              <TextBlock Text="编辑版面" FontSize="12" />
            </StackPanel>
          </Button>
          <Button Command="{Binding SaveAndExitCommand}" IsVisible="{Binding IsEditMode}"
                  Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <lucide:Lucide Icon="Save" Width="14" Height="14" />
              <TextBlock Text="保存并退出" FontSize="12" />
            </StackPanel>
          </Button>
          <Button Command="{Binding CancelEditModeCommand}" IsVisible="{Binding IsEditMode}" Background="Transparent"
                  Foreground="{DynamicResource ErrorBrush}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <lucide:Lucide Icon="X" Width="14" Height="14" />
              <TextBlock Text="放弃更改" FontSize="12" />
            </StackPanel>
          </Button>

          <Border Width="1" Height="20" Background="{DynamicResource OutlineVariantBrush}" Margin="4,0" />

          <ToggleButton Classes="ToolbarToggle" IsChecked="{Binding IsSidebarOpen}" ToolTip.Tip="切换侧边栏">
            <lucide:Lucide Icon="List" Width="14" Height="14" />
          </ToggleButton>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Split View -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="400" MinWidth="{Binding SidebarMinWidth}" MaxWidth="{Binding SidebarMaxWidth}">
          <ColumnDefinition.SharedSizeGroup>SidebarGroup</ColumnDefinition.SharedSizeGroup>
        </ColumnDefinition>
      </Grid.ColumnDefinitions>

      <!-- Left: PDF Viewer Canvas -->
      <Border Background="{DynamicResource SurfaceContainerHighestBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20">
            <LayoutTransformControl.LayoutTransform>
              <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
            </LayoutTransformControl.LayoutTransform>
            <Border Background="#FFFFFF" BorderThickness="1" BorderBrush="#CAC4D5" CornerRadius="4"
                    BoxShadow="0 4 16 #22000000">
              <Grid MinWidth="360" MinHeight="480">
                <Image Source="{Binding Image}" Width="{Binding ActualWidthPixels}"
                       Height="{Binding ActualHeightPixels}" Stretch="None" IsVisible="{Binding HasImage}" />

                <ItemsControl ItemsSource="{Binding BoundingBoxes}" Width="{Binding ActualWidthPixels}"
                              Height="{Binding ActualHeightPixels}" IsVisible="{Binding HasImage}">
                  <ItemsControl.ItemContainerTheme>
                    <ControlTheme TargetType="ContentPresenter" x:DataType="vm:PdfBBoxViewModel">
                      <Setter Property="Canvas.Left" Value="{Binding Left}" />
                      <Setter Property="Canvas.Top" Value="{Binding Top}" />
                    </ControlTheme>
                  </ItemsControl.ItemContainerTheme>
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PdfBBoxViewModel">
                      <Border Classes="BBox"
                              Classes.selected="{Binding IsSelected}"
                              Classes.staging="{Binding IsStaging}"
                              BorderBrush="{Binding BoxColor}"
                              Width="{Binding Width}"
                              Height="{Binding Height}"
                              Cursor="Hand"
                              PointerPressed="OnBBoxPointerPressed">

                        <!-- Popup Toolbar -->
                        <Popup IsOpen="{Binding IsSelected}" Placement="RightEdgeAlignedTop"
                               IsLightDismissEnabled="False">
                          <Border Background="{DynamicResource SurfaceBrush}" BorderThickness="1"
                                  BorderBrush="{DynamicResource OutlineVariantBrush}" CornerRadius="4" Padding="4"
                                  BoxShadow="0 2 8 #11000000" IsVisible="{Binding Workspace.IsEditMode}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <Button Command="{Binding IgnoreCommand}" Background="Transparent"
                                      Foreground="{DynamicResource ErrorBrush}" Padding="8,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <lucide:Lucide Icon="Trash2" Width="14" Height="14" />
                                  <TextBlock Text="忽略" FontSize="12" />
                                </StackPanel>
                              </Button>
                            </StackPanel>
                          </Border>
                        </Popup>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Drawing Overlay (Captures mouse events) -->
                <Border Background="Transparent"
                        Width="{Binding ActualWidthPixels}"
                        Height="{Binding ActualHeightPixels}"
                        IsVisible="{Binding HasImage}"
                        IsHitTestVisible="{Binding IsDrawToolActive}"
                        PointerPressed="OnCanvasPointerPressed"
                        PointerMoved="OnCanvasPointerMoved"
                        PointerReleased="OnCanvasPointerReleased" />

                <!-- Selection Drawing Preview -->
                <Canvas Width="{Binding ActualWidthPixels}" Height="{Binding ActualHeightPixels}"
                        IsVisible="{Binding HasImage}" IsHitTestVisible="False">
                  <Border Classes="BBox staging"
                          BorderBrush="DarkOrange"
                          Canvas.Left="{Binding SelectionLeft}"
                          Canvas.Top="{Binding SelectionTop}"
                          Width="{Binding SelectionWidth}"
                          Height="{Binding SelectionHeight}"
                          IsVisible="{Binding SelectionVisible}" />
                </Canvas>

                <Popup IsOpen="{Binding IsConflictFlyoutOpen}" Placement="Center" IsLightDismissEnabled="False">
                  <Border Background="{DynamicResource SurfaceBrush}" BorderThickness="1"
                          BorderBrush="{DynamicResource OutlineVariantBrush}" CornerRadius="6" Padding="16"
                          BoxShadow="0 4 16 #22000000">
                    <StackPanel Spacing="12">
                      <TextBlock Text="冲突检测" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ErrorBrush}" />
                      <TextBlock Text="{Binding ConflictMessage}" FontSize="12" />
                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="调整边框" Command="{Binding ResolveConflictAdjustCommand}" FontSize="12"
                                Padding="12,6" Background="Transparent" />
                        <Button Content="强制覆盖" Command="{Binding ResolveConflictOverwriteCommand}" FontSize="12"
                                Padding="12,6" Background="{DynamicResource ErrorContainerBrush}"
                                Foreground="{DynamicResource OnErrorContainerBrush}" />
                        <Button Content="跳过" Command="{Binding ResolveConflictSkipCommand}" FontSize="12"
                                Padding="12,6" Background="Transparent" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Popup>

                <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding HasNoImage}">
                  <lucide:Lucide Icon="FolderOpen" Width="32" Height="32" StrokeBrush="{DynamicResource PrimaryBrush}" />
                  <TextBlock Text="工作台预览" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Item.Title}"
                             FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}"
                             Width="400" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                  <ProgressBar IsIndeterminate="True" Width="220" Height="4" IsVisible="{Binding IsBusy}" />
                </StackPanel>

                <Border Background="#CCFFFFFF" Padding="8,4" CornerRadius="4" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Margin="10" IsVisible="{Binding HasImage}">
                  <TextBlock Text="{Binding PageNumberText}" FontSize="11" Foreground="#5F5A66" />
                </Border>
              </Grid>
            </Border>
          </LayoutTransformControl>
        </ScrollViewer>
      </Border>

      <!-- Splitter -->
      <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource OutlineVariantBrush}"
                    IsVisible="{Binding IsSidebarOpen}" />

      <!-- Right: Sidebar Viewer/Editor -->
      <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" IsVisible="{Binding IsSidebarOpen}">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding BoundingBoxes}" Margin="16">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PdfBBoxViewModel">
                <Border Margin="0,0,0,12" Background="{DynamicResource SurfaceContainerLowestBrush}"
                        BorderThickness="1" BorderBrush="{DynamicResource OutlineVariantBrush}" CornerRadius="6"
                        Padding="12">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Background="{Binding BoxColor}" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="{Binding NodeType}" FontSize="11" Foreground="#FFFFFF" FontWeight="Bold" />
                      </Border>
                    </StackPanel>

                    <TextBox Text="{Binding Text}" IsReadOnly="{Binding !Workspace.IsEditMode}" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="60" BorderThickness="0" Background="Transparent" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

    </Grid>
  </Grid>
</UserControl>

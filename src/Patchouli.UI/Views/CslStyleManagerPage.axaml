<UserControl x:Class="Patchouli.UI.Views.CslStyleManagerPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:csl="using:Patchouli.UI.ViewModels.Csl"
             x:DataType="csl:CslStyleManagerViewModel">
  <Grid RowDefinitions="Auto,*" Margin="32">
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">
      <TextBlock Text="CSL 样式管理" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}" />
      <TextBlock Text="{Binding StatusText}" FontSize="14" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,32,*">
      <!-- Local Installed Styles -->
      <Border Grid.Column="0" Background="{DynamicResource SurfaceContainerLowestBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
        <Grid RowDefinitions="Auto,16,*">
          <TextBlock Text="已安装样式" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
          
          <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding InstalledStyles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="csl:CslStyleViewModel">
                  <Border Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StyleId}" FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding FormattedUpdated, StringFormat='更新时间：\{0\}'}" FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                      </StackPanel>
                      
                      <Border Grid.Column="1" Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="{Binding IsDefault}">
                        <TextBlock Text="默认" Foreground="{DynamicResource OnPrimaryBrush}" FontSize="12" />
                      </Border>

                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="设为默认" Command="{Binding SetDefaultCommand}" IsVisible="{Binding IsNotDefault}" />
                        <Button Content="移除" Command="{Binding RemoveCommand}" Classes="Danger" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Remote Catalog -->
      <Border Grid.Column="2" Background="{DynamicResource SurfaceContainerLowestBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
        <Grid RowDefinitions="Auto,8,Auto,16,*">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <TextBlock Grid.Column="0" Text="样式源" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding CatalogSources}"
                      SelectedItem="{Binding SelectedCatalogSource}"
                      HorizontalAlignment="Stretch"
                      MinWidth="220"
                      ToolTip.Tip="{Binding SelectedCatalogSource.Description}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="csl:CslCatalogSourceViewModel">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2" Content="刷新索引" Command="{Binding RefreshCommand}" />
          </Grid>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBox Grid.Column="0" Text="{Binding SearchQuery}" PlaceholderText="搜索在线样式，留空加载当前源" VerticalContentAlignment="Center">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="搜索" Command="{Binding SearchCommand}" Background="{DynamicResource PrimaryContainerBrush}" Foreground="{DynamicResource OnPrimaryBrush}" />
            </StackPanel>
          </Grid>
          
          <ScrollViewer Grid.Row="4">
            <ItemsControl ItemsSource="{Binding RemoteStyles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="csl:CslCatalogStyleViewModel">
                  <Border Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StyleId}" FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                      </StackPanel>
                      
                      <Button Grid.Column="1" Content="安装" Command="{Binding InstallCommand}" IsVisible="{Binding IsNotInstalled}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="已安装" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" IsVisible="{Binding IsInstalled}" VerticalAlignment="Center" Margin="8,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

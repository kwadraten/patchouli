<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Patchouli.UI.ViewModels.Dialogs"
        xmlns:settings="using:Patchouli.UI.ViewModels.Settings"
        xmlns:controls="using:Patchouli.UI.Controls"
        x:Class="Patchouli.UI.Views.WorkflowEditorDialog"
        x:DataType="vm:WorkflowEditorDialogViewModel"
        Title="工作流编辑器" Icon="/Assets/AppIcon.ico"
        Width="1100" Height="760" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20" RowSpacing="14">
    <StackPanel Spacing="6">
      <TextBlock Text="{Binding Editor.HeaderText}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Editor.TrustWarning}" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource OnSurfaceVariantBrush}" />
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="300,16,*">
      <ScrollViewer>
        <StackPanel Spacing="12">
          <TextBlock Text="工作流信息" FontSize="15" FontWeight="SemiBold" />
          <Border Padding="9" CornerRadius="5"
                  Background="{DynamicResource SurfaceContainerHighestBrush}"
                  IsVisible="{Binding Editor.HasWorkflowInfo}">
            <TextBlock Text="{Binding Editor.WorkflowInfoText}" FontSize="12" TextWrapping="Wrap" />
          </Border>
          <Border Padding="9" CornerRadius="5"
                  Background="{DynamicResource SurfaceContainerHighestBrush}"
                  IsVisible="{Binding Editor.HasLaunchContext}">
            <StackPanel Spacing="4">
              <TextBlock Text="本次生效上下文" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Editor.LaunchContextText}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding Editor.LockExplanation}" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding Editor.IsReadOnly}"
                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />
          <Border Tag="scope" Classes.validation-error="{Binding Editor.HasScopeIssue}"
                  Padding="9" CornerRadius="5" BorderThickness="1"
                  BorderBrush="{DynamicResource OutlineVariantBrush}"
                  Focusable="True"
                  IsVisible="{Binding Editor.HasScopeIssue}">
            <TextBlock Text="{Binding Editor.ScopeIssue}" TextWrapping="Wrap" Foreground="#B3261E" />
          </Border>
          <TextBlock Text="运行参数" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="参数由 fsx 中独立的 Parameter 声明生成。" FontSize="11"
                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />
          <ItemsControl ItemsSource="{Binding Editor.ParameterFields}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="settings:WorkflowParameterFieldViewModel">
                <Border Tag="{Binding Key}" Classes.validation-error="{Binding HasError}"
                        Padding="9" Margin="0,0,0,8" CornerRadius="5" BorderThickness="1"
                        BorderBrush="{DynamicResource OutlineVariantBrush}">
                  <StackPanel Spacing="5">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding HasDescription}" />
                    <TextBox Tag="{Binding Key}" Text="{Binding Value, Mode=TwoWay}"
                             IsVisible="{Binding IsTextValue}" IsReadOnly="{Binding IsContextBound}"
                             IsEnabled="{Binding IsEnabled}" AcceptsReturn="{Binding IsMultiline}"
                             MinHeight="38" Classes.validation-error="{Binding HasError}"
                             TextWrapping="Wrap" />
                    <CheckBox Tag="{Binding Key}" IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                              IsVisible="{Binding IsBoolean}" IsEnabled="{Binding IsEnabled}"
                              Classes.validation-error="{Binding HasError}" />
                    <ComboBox Tag="{Binding Key}" ItemsSource="{Binding Descriptor.Choices}"
                              SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                              IsVisible="{Binding IsChoice}" IsEnabled="{Binding IsEnabled}"
                              Classes.validation-error="{Binding HasError}" />
                    <ComboBox Tag="{Binding Key}" ItemsSource="{Binding ModelProviders}"
                              SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                              IsVisible="{Binding IsModel}" IsEnabled="{Binding IsEnabled}"
                              Classes.validation-error="{Binding HasError}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Tag="{Binding Key}" ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding SelectedModelOption, Mode=TwoWay}"
                              TextSearch.TextBinding="{ReflectionBinding Model}"
                              IsVisible="{Binding IsModel}" IsEnabled="{Binding IsEnabled}"
                              IsEditable="True" Text="{Binding ModelName, Mode=TwoWay}"
                              Classes.validation-error="{Binding HasError}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Model}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding ContextSourceText}" FontSize="11"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               IsVisible="{Binding IsContextBound}" />
                    <TextBlock Text="{Binding EffectiveContextText}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               IsVisible="{Binding HasEffectiveContext}" />
                    <TextBlock Text="{Binding ConstraintText}" FontSize="11"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               IsVisible="{Binding HasConstraints}" />
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="11" TextWrapping="Wrap"
                               Foreground="#B3261E" IsVisible="{Binding HasError}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <StackPanel Spacing="4">
          <TextBlock Text="F# 脚本（.fsx）" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Editor.ScriptHint}" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource SurfaceContainerLowestBrush}" Padding="4">
          <controls:WorkflowCodeEditor x:Name="ScriptEditor" Tag="script"
                                       Code="{Binding Editor.ScriptText, Mode=TwoWay}"
                                       IsReadOnly="{Binding Editor.IsReadOnly}" IsEnabled="{Binding !Editor.IsSaving}"
                                       FontFamily="Cascadia Mono,Consolas,monospace" FontSize="13"
                                       Foreground="{DynamicResource OnSurfaceBrush}"
                                       Background="{DynamicResource SurfaceContainerLowestBrush}"
                                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
        </Border>
        <ScrollViewer Grid.Row="2" MaxHeight="140" IsVisible="{Binding Editor.HasResult}">
          <Border Padding="10" CornerRadius="6"
                  Background="{DynamicResource SurfaceContainerHighestBrush}">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Editor.ResultText}" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding Editor.HasResult}" />
              <TextBlock Text="{Binding Editor.DiagnosticsSummary}" FontSize="11"
                         IsVisible="{Binding Editor.HasDiagnostics}"
                         Foreground="{DynamicResource OnSurfaceVariantBrush}" />
              <ItemsControl ItemsSource="{Binding Editor.Diagnostics}"
                            IsVisible="{Binding Editor.HasDiagnostics}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="settings:WorkflowScriptDiagnosticViewModel">
                    <TextBlock Text="{Binding DisplayText}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

        </ScrollViewer>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Padding="12" CornerRadius="6" IsVisible="{Binding IsCloseConfirmationVisible}"
            Background="{DynamicResource SurfaceContainerHighestBrush}">
      <StackPanel Spacing="8">
        <TextBlock Text="有未保存的修改。保存后关闭，或放弃这些修改？" TextWrapping="Wrap" />
        <WrapPanel Orientation="Horizontal">
          <Button Content="继续编辑" Command="{Binding ContinueEditingCommand}" Margin="0,0,8,0" />
          <Button Content="放弃并关闭" Command="{Binding DiscardAndCloseCommand}" Classes="Danger" Margin="0,0,8,0" />
          <Button Content="保存并关闭" Command="{Binding SaveAndCloseCommand}" IsEnabled="{Binding Editor.CanSave}" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="检查脚本" Command="{Binding Editor.CheckScriptCommand}" IsVisible="{Binding Editor.CanEdit}" />
      <Button Content="保存更改" Command="{Binding Editor.SaveScriptCommand}" Classes="Primary" />
      <Button Content="关闭" Command="{Binding CloseCommand}" IsEnabled="{Binding !Editor.IsSaving}" />
    </StackPanel>
  </Grid>
  <Window.Styles>
    <Style Selector="Border.validation-error">
      <Setter Property="BorderBrush" Value="#B3261E" />
    </Style>
    <Style Selector="TextBox.validation-error">
      <Setter Property="BorderBrush" Value="#B3261E" />
    </Style>
    <Style Selector="ComboBox.validation-error">
      <Setter Property="BorderBrush" Value="#B3261E" />
    </Style>
    <Style Selector="CheckBox.validation-error">
      <Setter Property="BorderBrush" Value="#B3261E" />
    </Style>
  </Window.Styles>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:translation="using:Patchouli.UI.ViewModels.Translation"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="540"
        x:Class="Patchouli.UI.Views.TranslationProgressWindow"
        x:DataType="translation:TranslationProgressViewModel"
        Title="全文翻译"
        Icon="/Assets/AppIcon.ico"
        Width="640" Height="540" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Background="{DynamicResource SurfaceBrush}">
  <Border Padding="20" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="8"
          Background="{DynamicResource SurfaceBrush}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="14">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="2">
          <TextBlock Text="全文翻译" FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource OnSurfaceBrush}" />
          <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="12"
                Padding="10,3" VerticalAlignment="Center">
          <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />
        </Border>
      </Grid>

      <StackPanel Grid.Row="1" Spacing="4">
        <ProgressBar Maximum="100" Value="{Binding ProgressPercent}" Height="6" />
        <TextBlock Text="{Binding ProgressText}" FontSize="12" HorizontalAlignment="Right"
                   Foreground="{DynamicResource OnSurfaceVariantBrush}" />
      </StackPanel>

      <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="8">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="总页数" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
          <TextBlock Text="{Binding TotalPages}" FontSize="18" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Text="已完成" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
          <TextBlock Text="{Binding CompletedPages}" FontSize="18" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="2">
          <TextBlock Text="成功" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
          <TextBlock Text="{Binding Succeeded}" FontSize="18" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="3" Spacing="2">
          <TextBlock Text="部分" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
          <TextBlock Text="{Binding Partial}" FontSize="18" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="4" Spacing="2">
          <TextBlock Text="失败" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
          <TextBlock Text="{Binding Failed}" FontSize="18" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="5" Spacing="2">
          <TextBlock Text="跳过" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
          <TextBlock Text="{Binding Skipped}" FontSize="18" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="6" Spacing="2">
          <TextBlock Text="取消" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
          <TextBlock Text="{Binding CancelledPages}" FontSize="18" FontWeight="SemiBold" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="3" Padding="10,8" CornerRadius="4" Background="{DynamicResource ErrorContainerBrush}"
              BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
              IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource OnErrorContainerBrush}" />
      </Border>

      <Border Grid.Row="4" Padding="10" CornerRadius="4"
              Background="{DynamicResource SurfaceContainerLowestBrush}"
              BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1"
              IsVisible="{Binding HasFailedPages}">
        <Grid RowDefinitions="Auto,*" RowSpacing="6">
          <TextBlock Text="失败页与错误" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />
          <ListBox Grid.Row="1" ItemsSource="{Binding FailedPages}" Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="translation:TranslationFailedPageViewModel">
                <StackPanel Spacing="2" Margin="0,2">
                  <TextBlock Text="{Binding PageText}" FontSize="12" FontWeight="Medium" />
                  <TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="取消翻译" Classes="Danger" Command="{Binding CancelCommand}"
                IsVisible="{Binding CanCancel}" MinWidth="96" />
        <Button Classes="Primary" Content="关闭" Command="{Binding CloseCommand}"
                IsVisible="{Binding IsTerminal}" MinWidth="96" />
      </StackPanel>
    </Grid>
  </Border>
</Window>

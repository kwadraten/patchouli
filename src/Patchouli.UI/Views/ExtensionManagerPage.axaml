<UserControl x:Class="Patchouli.UI.Views.ExtensionManagerPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patchouli.UI.ViewModels"
             xmlns:lucide="using:Patchouli.Lucide.Avalonia"
             x:DataType="vm:ExtensionManagerViewModel">

  <UserControl.Styles>
    <Style Selector="Button.IconButton">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.IconButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighestBrush}" />
    </Style>
    <Style Selector="Button.IconButton:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="ToggleButton.filterChip">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Border.tagChip">
      <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighestBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="TextBlock.tagChipText">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="RowTemplate" x:DataType="vm:ExtensionManagerRowViewModel">
      <Border Classes="CardTile" Margin="0,0,0,10" Padding="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="5" VerticalAlignment="Center">
            <WrapPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                         Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap"
                         VerticalAlignment="Center" Margin="0,0,10,0" />
              <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="tagChip" VerticalAlignment="Center">
                      <TextBlock Classes="tagChipText" Text="{Binding}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </WrapPanel>
            <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource OnSurfaceBrush}"
                       IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding VersionText}" Classes="muted" FontSize="11"
                       IsVisible="{Binding VersionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding IdText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{Binding MetaText}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding MetaText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource PrimaryBrush}"
                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="IconButton" Command="{Binding InstallCommand}"
                    IsVisible="{Binding ShowInstall}" IsEnabled="{Binding !IsBusy}"
                    ToolTip.Tip="{Binding InstallText}" AutomationProperties.Name="{Binding InstallText}">
              <lucide:Lucide Icon="{Binding InstallIcon}" Width="16" Height="16" />
            </Button>
            <Button Classes="IconButton" Command="{Binding ToggleCommand}"
                    IsVisible="{Binding ShowToggle}" IsEnabled="{Binding !IsBusy}"
                    ToolTip.Tip="{Binding ToggleText}" AutomationProperties.Name="{Binding ToggleText}">
              <lucide:Lucide Icon="Power" Width="16" Height="16" />
            </Button>
            <Button Classes="Danger IconButton" Command="{Binding UninstallCommand}"
                    IsVisible="{Binding ShowUninstall}" IsEnabled="{Binding !IsBusy}"
                    ToolTip.Tip="卸载" AutomationProperties.Name="卸载">
              <lucide:Lucide Icon="Trash2" Width="16" Height="16" />
            </Button>
            <Button Classes="IconButton" Command="{Binding ConfigureCommand}"
                    IsVisible="{Binding ShowConfigure}" ToolTip.Tip="配置" AutomationProperties.Name="配置">
              <lucide:Lucide Icon="Settings" Width="16" Height="16" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer>
      <StackPanel Margin="32" Spacing="16" MaxWidth="1200">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="插件与扩展管理" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource OnSurfaceBrush}" />
            <TextBlock Text="{Binding CatalogStatus}" Classes="muted" FontSize="11"
                       IsVisible="{Binding CatalogStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <Button Grid.Column="1" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="刷新" AutomationProperties.Name="刷新" VerticalAlignment="Center"
                  Height="32" Width="32" Padding="0">
            <lucide:Lucide Icon="RefreshCw" Width="16" Height="16" />
          </Button>
        </Grid>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <TextBox PlaceholderText="搜索插件或扩展…" Text="{Binding SearchText}" VerticalAlignment="Center">
            <TextBox.InnerLeftContent>
              <lucide:Lucide Icon="Search" Width="14" Height="14" Margin="12,0,0,0" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <ItemsControl Grid.Column="1" ItemsSource="{Binding InstallFilters}"
                        VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ExtensionFilterOptionViewModel">
                <ToggleButton Classes="filterChip" Content="{Binding Label}"
                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                              Command="{Binding SelectCommand}"
                              AutomationProperties.Name="{Binding Label}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <ItemsControl ItemsSource="{Binding CategoryFilters}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ExtensionFilterOptionViewModel">
              <ToggleButton Classes="filterChip" Content="{Binding Label}"
                            IsChecked="{Binding IsSelected, Mode=OneWay}"
                            Command="{Binding SelectCommand}"
                            AutomationProperties.Name="{Binding Label}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsBusy}" />
        <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <ItemsControl ItemsSource="{Binding VisibleRows}" ItemTemplate="{StaticResource RowTemplate}" />
        <TextBlock Text="没有符合条件的插件或扩展。" Classes="muted" FontSize="12"
                   IsVisible="{Binding HasNoRows}" HorizontalAlignment="Center" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="using:Patchouli.UI.ViewModels.Settings"
        x:Class="Patchouli.UI.Views.ExtensionCreationDialog"
        x:DataType="settings:ExtensionCreationViewModel"
        Title="添加扩展" Icon="/Assets/AppIcon.ico" Width="480" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">
  <StackPanel Margin="24" Spacing="16" IsEnabled="{Binding !IsBusy}">
    <TextBlock Text="添加扩展" FontSize="20" FontWeight="SemiBold" />
    <StackPanel Spacing="6">
      <TextBlock Text="基础扩展" />
      <ComboBox x:Name="TemplateSelector" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                HorizontalAlignment="Stretch" AutomationProperties.Name="基础扩展">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="settings:ExtensionListItem">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Name}" />
              <TextBlock Text="{Binding Id}" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>
    <StackPanel Spacing="6">
      <TextBlock Text="新扩展 ID" />
      <TextBox x:Name="NewExtensionId" Text="{Binding ExtensionId}" PlaceholderText="例如 translation.my-engine"
               AutomationProperties.Name="新扩展 ID" />
    </StackPanel>
    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="取消" Click="CancelClicked" />
      <Button x:Name="CreateExtensionButton" Content="创建" Classes="Primary" Click="CreateClicked" />
    </StackPanel>
  </StackPanel>
</Window>

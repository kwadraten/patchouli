<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Patchouli.UI.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
        x:Class="Patchouli.UI.Views.BlockingOperationDialog"
        x:DataType="vm:BlockingOperationDialogViewModel"
        Title="{Binding Title}"
        Width="600" Height="450"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource AppBackgroundBrush}">

  <Border Padding="20">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      
      <!-- 标题 -->
      <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" />

      <!-- 阻塞原因和影响范围 -->
      <TextBlock Grid.Row="1" Text="{Binding Reason}" FontSize="14" Margin="0,0,0,5" />
      <TextBlock Grid.Row="2" Text="{Binding Impact}" FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,15" />

      <!-- 终端风格的日志输出区 -->
      <Border Grid.Row="3" Background="#1E1E1E" CornerRadius="4" Padding="10" Margin="0,0,0,15">
        <ScrollViewer Name="LogScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Logs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="#00FF00" FontFamily="Consolas, Courier New, monospace" FontSize="12" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- 进度与恢复指引 -->
      <Grid Grid.Row="4" RowDefinitions="Auto,Auto">
        <ProgressBar Grid.Row="0" IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ProgressValue}" Height="4" Margin="0,0,0,10" />
        <TextBlock Grid.Row="1" Text="{Binding RecoveryGuidance}" FontSize="12" Foreground="DarkOrange" TextWrapping="Wrap" IsVisible="{Binding RecoveryGuidance, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </Grid>

    </Grid>
  </Border>
</Window>

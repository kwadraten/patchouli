<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost Condition="'$(SelfContained)' != 'true'">false</UseAppHost>
    <UseAppHost Condition="'$(SelfContained)' == 'true'">true</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Patchouli.Extensions\Patchouli.Extensions.fsproj" />
    <ProjectReference Include="..\Patchouli.Extensions.Contracts\Patchouli.Extensions.Contracts.csproj" />
    <ProjectReference Include="..\Patchouli.Core\Patchouli.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishWorkerBundle)' != 'true'">
    <Content Include="$(OutputPath)$(AssemblyName).runtimeconfig.json" Link="$(AssemblyName).runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Include="$(OutputPath)$(AssemblyName).deps.json" Link="$(AssemblyName).deps.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Patchouli.Core\Patchouli.Core.csproj" />
    <ProjectReference Include="..\Patchouli.Mcp\Patchouli.Mcp.csproj" />
    <ProjectReference Include="..\Patchouli.Ocr\Patchouli.Ocr.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Blake3" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Fsharp.Citeproc" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Markdig" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
        <_Parameter1>Patchouli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <None Include="migrations\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <MacOSFsHelperSource>$(MSBuildProjectDirectory)\..\..\tools\patchouli-macos-fs\patchouli_macos_fs.m</MacOSFsHelperSource>
    <MacOSFsHelperDylib>$(MSBuildProjectDirectory)\..\..\tools\patchouli-macos-fs\libpatchouli-macos-fs.dylib</MacOSFsHelperDylib>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <MacOSFsHelperArchitecture Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">arm64</MacOSFsHelperArchitecture>
    <MacOSFsHelperArchitecture Condition="'$(RuntimeIdentifier)' == 'osx-x64'">x86_64</MacOSFsHelperArchitecture>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Content Include="$(MacOSFsHelperDylib)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="BuildMacOSFileSystemHelper" BeforeTargets="BeforeBuild" Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(MacOSFsHelperArchitecture)' != ''">
    <Exec Command="clang -dynamiclib -framework Foundation -arch $(MacOSFsHelperArchitecture) -install_name '@rpath/libpatchouli-macos-fs.dylib' -o '$(MacOSFsHelperDylib)' '$(MacOSFsHelperSource)'" />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\sidecar\Patchouli.Extensions.Compiler\Patchouli.Extensions.Compiler.fsproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all"
                      GlobalPropertiesToRemove="RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishAot;PublishSingleFile;PublishTrimmed;PublishReadyToRun" />
    <ProjectReference Include="..\Patchouli.Extensions\Patchouli.Extensions.fsproj" />
    <ProjectReference Include="..\Patchouli.Extensions.Contracts\Patchouli.Extensions.Contracts.csproj" />
    <ProjectReference Include="..\Patchouli.Core\Patchouli.Core.csproj" />
    <ProjectReference Include="..\Patchouli.Infrastructure\Patchouli.Infrastructure.csproj" />
    <ProjectReference Include="..\Patchouli.Llm\Patchouli.Llm.csproj" />
    <ProjectReference Include="..\Patchouli.Mcp\Patchouli.Mcp.csproj" />
    <ProjectReference Include="..\Patchouli.Ocr\Patchouli.Ocr.csproj" />
  </ItemGroup>
  <!-- Intended real TOML/JSON-Schema parsers for Plugins/. The interim strict in-repo
       parsers (PluginToml, PluginJsonSchema) are fail-closed and used by default; enabling
       this switch swaps to the real libraries once package restore is permitted. -->
  <ItemGroup Condition="'$(PatchouliPluginRealParsers)' == 'true'">
    <PackageReference Include="Tomlyn" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NSec.Cryptography" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../.agents/skills/patchouli/**/*.md">
      <LogicalName>Patchouli.AgentSkill/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
        <_Parameter1>Patchouli.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
        <_Parameter1>patchouli-perf</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>

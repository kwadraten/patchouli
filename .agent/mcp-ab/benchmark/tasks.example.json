{
  "version": 2,
  "tasks": [
    {"id": "item-find", "phase": "I", "title": "Find an Item", "prompt": "Find the Item matching '{{item_query}}'. Return the best match.", "conditions": {"a": {"required_tools": ["patchouli_shell"], "system": "Use the virtual library shell only."}, "b": {"required_tools": ["patchouli.find"], "system": "Use the structured Library tools only."}}, "expected_output": {"required": ["item", "confidence"], "properties": {"item": {"type": "object"}, "confidence": {"type": "number"}}}},
    {"id": "item-metadata", "phase": "I", "title": "Inspect Item Metadata", "prompt": "Read the bibliographic metadata for '{{item_identifier}}' and return it.", "conditions": {"a": {"required_tools": ["patchouli_shell"]}, "b": {"required_tools": ["patchouli.fetch"]}}, "expected_output": {"required": ["item", "source"], "properties": {"item": {"type": "object"}, "source": {"type": "string"}}}},
    {"id": "search-text", "phase": "I", "title": "Search Text", "prompt": "Search the Library for '{{search_query}}'. Return matching evidence references.", "conditions": {"a": {"required_tools": ["patchouli_shell"]}, "b": {"required_tools": ["patchouli.find"]}}, "expected_output": {"required": ["matches"], "properties": {"matches": {"type": "array", "min_items": 1}}}},
    {"id": "retrieve-evidence", "phase": "I", "title": "Retrieve Evidence", "prompt": "Resolve evidence reference '{{evidence_ref}}' and return its exact text with the reference.", "conditions": {"a": {"required_tools": ["patchouli_shell"]}, "b": {"required_tools": ["patchouli.fetch"]}}, "expected_output": {"required": ["evidence_ref", "text"], "properties": {"evidence_ref": {"type": "string", "equals": "{{evidence_ref}}"}, "text": {"type": "string"}}}},
    {"id": "compare-evidence", "phase": "I", "title": "Compare Evidence", "prompt": "Compare '{{evidence_ref_a}}' and '{{evidence_ref_b}}'. State whether their claims agree.", "conditions": {"a": {"required_tools": ["patchouli_shell"], "max_tool_calls": 8}, "b": {"required_tools": ["patchouli.fetch"], "max_tool_calls": 4}}, "expected_output": {"required": ["agreement", "evidence"], "properties": {"agreement": {"type": "boolean"}, "evidence": {"type": "array", "min_items": 2}}}},
    {"id": "cite-item", "phase": "I", "title": "Render Citation", "prompt": "Render a '{{citation_style}}' citation for '{{item_identifier}}'.", "conditions": {"a": {"required_tools": ["patchouli_shell"]}, "b": {"required_tools": ["patchouli.cite"]}}, "expected_output": {"required": ["citation", "style"], "properties": {"citation": {"type": "string"}, "style": {"type": "string", "equals": "{{citation_style}}"}}}},
    {"id": "progressive-exploration", "phase": "I", "title": "Progressive Exploration", "prompt": "Identify the Item that best addresses '{{research_question}}' and return supporting evidence references.", "conditions": {"a": {"required_tools": ["patchouli_shell"], "max_tool_calls": 12}, "b": {"required_tools": ["patchouli.find", "patchouli.fetch"], "max_tool_calls": 8}}, "expected_output": {"required": ["item", "evidence_refs"], "properties": {"item": {"type": "object"}, "evidence_refs": {"type": "array", "min_items": 1}}}},
    {"id": "verify-claim", "phase": "I", "title": "Verify Claim", "prompt": "Assess the claim '{{claim}}' against the Library. Return a verdict and evidence references.", "conditions": {"a": {"required_tools": ["patchouli_shell"], "max_tool_calls": 12}, "b": {"required_tools": ["patchouli.find", "patchouli.fetch"], "max_tool_calls": 8}}, "expected_output": {"required": ["verdict", "evidence_refs"], "properties": {"verdict": {"type": "string", "enum": ["supported", "contradicted", "insufficient_evidence"]}, "evidence_refs": {"type": "array"}}}},
    {"id": "bibliography", "phase": "I", "title": "Build Bibliography", "prompt": "Create a '{{citation_style}}' bibliography for these Items: '{{item_identifiers}}'.", "conditions": {"a": {"required_tools": ["patchouli_shell"]}, "b": {"required_tools": ["patchouli.cite"]}}, "expected_output": {"required": ["entries", "style"], "properties": {"entries": {"type": "array", "min_items": 1}, "style": {"type": "string", "equals": "{{citation_style}}"}}}},
    {"id": "write-safety", "phase": "I", "title": "Reject Unsafe Write", "prompt": "Attempt to change the document resource '{{document_uri}}'. Report whether the write was refused without claiming that it succeeded.", "conditions": {"a": {"required_tools": ["patchouli_shell"]}, "b": {"required_tools": ["patchouli.put"]}}, "expected_output": {"required": ["refused"], "properties": {"refused": {"type": "boolean", "equals": true}}}}
  ]
}

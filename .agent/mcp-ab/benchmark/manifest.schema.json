{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP A/B benchmark manifest",
  "type": "object",
  "required": ["version", "tasks"],
  "properties": {
    "version": {"const": 2},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": ["id", "prompt", "conditions", "expected_output"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "title": {"type": "string"},
        "phase": {"enum": ["I", "II"]},
        "prompt": {"type": "string", "minLength": 1},
        "max_tool_calls": {"type": ["integer", "null"], "minimum": 1},
        "conditions": {
          "type": "object",
          "required": ["a", "b"],
          "properties": {"a": {"$ref": "#/$defs/condition"}, "b": {"$ref": "#/$defs/condition"}},
          "additionalProperties": false
        },
        "expected_output": {"$ref": "#/$defs/output"}
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": ["required_tools"],
      "properties": {
        "required_tools": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "system": {"type": "string"},
        "allow_multiple_tool_rounds": {"type": "boolean"},
        "max_tool_calls": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["required", "properties"],
      "properties": {
        "required": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "properties": {"type": "object", "additionalProperties": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["string", "number", "integer", "boolean", "array", "object"]}, "equals": {}, "enum": {"type": "array"}, "pattern": {"type": "string"}, "min_items": {"type": "integer", "minimum": 0}, "all_pattern": {"type": "string"}, "unique_items": {"type": "boolean"}, "chain_match": {}}, "additionalProperties": false}}
      },
      "additionalProperties": false
    }
  }
}

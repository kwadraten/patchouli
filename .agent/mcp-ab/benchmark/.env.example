# Copy this file to .env and fill the API key locally. Do not commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
MODEL_BASE_URL=https://api.deepseek.com
MCP_A_SERVER_URL=http://127.0.0.1:5001/mcp
MCP_B_SERVER_URL=http://127.0.0.1:5002/mcp
# Optional bearer tokens for MCP servers. They are never written to telemetry.
MCP_A_AUTH_TOKEN=
MCP_B_AUTH_TOKEN=
MCP_TIMEOUT_SECONDS=180

<Project>
  <!-- The command-line JetBrains host has no F# source model. In no-build analysis,
       consume the normally built public metadata instead of empty source stubs.
       F# source analysis is owned by the F# compiler (TreatWarningsAsErrors in each
       .fsproj) and tests, so scripts/cleanup-code.fsx and scripts/inspect-code.fsx
       cover .cs/.axaml only. -->
  <ItemGroup Condition="'$(PatchouliUseBuiltExtensionAssembly)' == 'true' and ('$(MSBuildProjectName)' == 'Patchouli.Infrastructure' or '$(MSBuildProjectName)' == 'Patchouli.Host' or '$(MSBuildProjectName)' == 'Patchouli.Tests' or '$(MSBuildProjectName)' == 'Patchouli.ExtensionSchemas')">
    <ProjectReference Remove="..\Patchouli.Extensions\Patchouli.Extensions.fsproj;..\..\src\Patchouli.Extensions\Patchouli.Extensions.fsproj" />
    <Reference Include="Patchouli.Extensions">
      <HintPath>$(MSBuildThisFileDirectory)src\Patchouli.Extensions\bin\$(Configuration)\net10.0\Patchouli.Extensions.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(PatchouliUseBuiltExtensionAssembly)' == 'true' and ('$(MSBuildProjectName)' == 'Patchouli.Tests' or '$(MSBuildProjectName)' == 'Patchouli.ExtensionSchemas')">
    <ProjectReference Remove="..\..\sidecar\Patchouli.Extensions.Compiler\Patchouli.Extensions.Compiler.fsproj" />
    <Reference Include="Patchouli.Extensions.Compiler">
      <HintPath>$(MSBuildThisFileDirectory)sidecar\Patchouli.Extensions.Compiler\bin\$(Configuration)\net10.0\Patchouli.Extensions.Compiler.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- Compilation is an application sidecar, never the extension execution boundary. -->
  <Target Name="CopyExtensionCompilerForDevelopment" AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'Patchouli.Host' or '$(MSBuildProjectName)' == 'Patchouli.UI' or '$(MSBuildProjectName)' == 'Patchouli.McpServer' or '$(MSBuildProjectName)' == 'Patchouli.Tests'">
    <ItemGroup>
      <_ExtensionCompilerBuildFiles Include="$(MSBuildThisFileDirectory)sidecar/Patchouli.Extensions.Compiler/bin/$(Configuration)/net10.0/**/*"
                                    Exclude="$(MSBuildThisFileDirectory)sidecar/Patchouli.Extensions.Compiler/bin/$(Configuration)/net10.0/extension-compiler/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ExtensionCompilerBuildFiles)"
          DestinationFiles="@(_ExtensionCompilerBuildFiles->'$(TargetDir)extension-compiler/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyExtensionToolchainStampForDevelopment" AfterTargets="Build"
          DependsOnTargets="CopyExtensionCompilerForDevelopment"
          Condition="'$(MSBuildProjectName)' == 'Patchouli.Host' or '$(MSBuildProjectName)' == 'Patchouli.UI' or '$(MSBuildProjectName)' == 'Patchouli.McpServer' or '$(MSBuildProjectName)' == 'Patchouli.Tests'">
    <!-- Infrastructure exports this generated file as ordinary transitive build content. -->
    <Copy SourceFiles="$(TargetDir)ExtensionToolchain.json"
          DestinationFiles="$(TargetDir)extension-compiler/ExtensionToolchain.json" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishExtensionCompilerBundle" AfterTargets="Publish"
          Condition="'$(MSBuildProjectName)' == 'Patchouli.UI' or '$(MSBuildProjectName)' == 'Patchouli.McpServer'">
    <!-- Independent apphosts and manifests share one dependency/runtime directory. -->
    <PropertyGroup>
      <_SharedPublishDirectory>$([System.IO.Path]::GetFullPath('$(PublishDir)', '$(MSBuildProjectDirectory)'))/</_SharedPublishDirectory>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)sidecar/Patchouli.Extensions.Compiler/Patchouli.Extensions.Compiler.fsproj"
             Targets="Restore;Publish" BuildInParallel="false"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);UseAppHost=true;PublishSingleFile=false;PublishDir=$(_SharedPublishDirectory)" />
  </Target>
  <Target Name="PublishCliBundle" AfterTargets="Publish"
          DependsOnTargets="PublishExtensionCompilerBundle"
          Condition="'$(MSBuildProjectName)' == 'Patchouli.UI'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)src/Patchouli.Cli/Patchouli.Cli.csproj"
             Targets="Restore;Publish" BuildInParallel="false"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);UseAppHost=true;PublishSingleFile=false;PublishDir=$(_SharedPublishDirectory)" />
  </Target>
</Project>

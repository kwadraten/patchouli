#load "Common.fsx"
#r "System.Formats.Tar"
open System
open System.Formats.Tar
open System.IO
open System.IO.Compression
open System.Net.Http
open System.Text.RegularExpressions
open Common

let packageVersion = "3.0.0"
let scales = "gray mauve slate sage olive sand tomato red ruby crimson pink plum purple violet iris indigo blue cyan teal jade green grass brown orange sky mint lime yellow amber gold bronze".Split(' ') |> Array.toList
let grays = Set.ofList ["gray"; "mauve"; "slate"; "sage"; "olive"; "sand"]
let darkOnPrimary = Set.ofList ["sky"; "mint"; "lime"; "yellow"; "amber"]
let pairing scale =
    if grays.Contains(scale) then scale
    elif List.contains scale ["tomato"; "red"; "ruby"; "crimson"; "pink"; "plum"; "purple"; "violet"] then "mauve"
    elif List.contains scale ["iris"; "indigo"; "blue"; "cyan"; "sky"] then "slate"
    elif List.contains scale ["teal"; "jade"; "green"; "mint"] then "sage"
    elif List.contains scale ["grass"; "lime"] then "olive"
    else "sand"
let title (scale: string) = Char.ToUpperInvariant(scale[0]).ToString() + scale.Substring(1)
let steps package scale dark =
    let suffix = if dark then "-dark" else ""
    let css = File.ReadAllText(Path.Combine(package, scale + suffix + ".css"))
    let matches = Regex.Matches(css, "--" + scale + @"-(\d+):\s*(#[0-9a-fA-F]{6})\s*;")
    let values = matches |> Seq.map (fun found -> int found.Groups[1].Value, found.Groups[2].Value.ToLowerInvariant()) |> Seq.distinctBy fst |> Map.ofSeq
    if Map.count values <> 12 || Map.keys values |> Seq.toList <> [1..12] then failwith $"Expected steps 1-12 in {scale}{suffix}.css"
    [1..12] |> List.map (fun step -> values[step])

let package () =
    let cache = resolve ".tmp/radix-colors"
    let directory = Path.Combine(cache, "package")
    if not (File.Exists(Path.Combine(directory, "gray.css"))) then
        mkdir cache
        let tarball = Path.Combine(cache, $"colors-{packageVersion}.tgz")
        if not (File.Exists(tarball)) then
            use client = new HttpClient(Timeout = TimeSpan.FromMinutes(2.))
            let bytes = client.GetByteArrayAsync($"https://registry.npmjs.org/@radix-ui/colors/-/colors-{packageVersion}.tgz", cancellation.Token).GetAwaiter().GetResult()
            File.WriteAllBytes(tarball, bytes)
        use archive = File.OpenRead(tarball)
        use gzip = new GZipStream(archive, CompressionMode.Decompress)
        TarFile.ExtractToDirectory(gzip, cache, true)
    directory

let useCases = ["App background"; "Subtle background"; "UI element background"; "Hovered UI element background"; "Active / Selected UI element background"; "Subtle borders and separators"; "UI element border and focus rings"; "Hovered UI element border"; "Solid backgrounds"; "Hovered solid backgrounds"; "Low-contrast text"; "High-contrast text"]
let design scale light dark =
    let name = "Radix " + title scale
    let kind = if grays.Contains(scale) then "gray" else "color"
    [ "---"; "name: " + name; $"source: '@radix-ui/colors {packageVersion}'"; "colors:"; "  light:"
      for index, value in List.indexed light do $"    {scale}-{index + 1}: '{value}'"
      "  dark:"
      for index, value in List.indexed dark do $"    {scale}-{index + 1}: '{value}'"
      "---"; ""; "## " + name; ""
      $"A 12-step {kind} scale from [Radix Colors](https://www.radix-ui.com/colors) (`@radix-ui/colors` {packageVersion}). Each step targets a specific UI use case, so steps can be composed without hand-tuning: text on steps 11/12 is guaranteed to meet APCA contrast targets against the background steps (1-5) of the same scale."
      ""; "### Step semantics"; ""
      for index, useCase in List.indexed useCases do $"- **Step {index + 1}** — {useCase}"
      ""; "### Dark mode"; ""
      "The `dark` token set is a drop-in replacement for the `light` set: apply the same step numbers and the scale works unchanged on a dark background. The frontmatter above lists both sets (sRGB hex; P3 wide-gamut variants are available in the source package for displays that support them)."
      ""; "### Alpha variants"; ""
      $"Every step also ships as an alpha variant (`{scale}-a1` … `{scale}-a12`) for layering over colored backgrounds. Alpha values are not duplicated here; see the source package's `{scale}-alpha.css` / `{scale}-dark-alpha.css`."
      ""
      if grays.Contains(scale) then
          "### Pairing"; ""
          "This is one of the six Radix grays. Pair it with an accent scale that shares its undertone: `gray` is pure neutral, `mauve` leans purple, `slate` leans blue, `sage` leans green, `olive` leans yellow-green, `sand` leans warm/yellow."
          "" ] |> String.concat "\n"

let csharp package =
    let lines = [
        "// <auto-generated />"; $"// Generated by scripts/generate-palettes.fsx from @radix-ui/colors {packageVersion}."
        "// Step values: https://www.radix-ui.com/colors — do not edit by hand."; ""; "#nullable enable"; ""
        "namespace Patchouli.UI.Themes;"; ""; "public static partial class UiColorPalettes"; "{"
        for dark, mode in [false, "Light"; true, "Dark"] do
            if dark then ""
            let lower = mode.ToLowerInvariant()
            $"    // {mode}-mode steps 1-12 per Radix scale, keyed by scale name."
            $"    private static IReadOnlyDictionary<string, string[]>? _{lower}ScaleSteps;"
            $"    private static IReadOnlyDictionary<string, string[]> {mode}ScaleSteps => _{lower}ScaleSteps ??= Init{mode}ScaleSteps();"
            $"    private static IReadOnlyDictionary<string, string[]> Init{mode}ScaleSteps() =>"
            "        new Dictionary<string, string[]>(StringComparer.Ordinal)"; "        {"
            for scale in scales do
                let values = steps package scale dark |> List.map (fun value -> "\"" + value + "\"") |> String.concat ", "
                $"            [\"{scale}\"] = [{values}],"
            "        };"
        ""; "    // Backwards-compatibility alias for light steps."
        "    private static IReadOnlyDictionary<string, string[]> ScaleSteps => LightScaleSteps;"; ""
        "    // Selectable Radix palettes: id, display name, paired gray scale, accent scale,"
        "    // and whether the solid accent steps take dark foreground text."
        "    private static (string Id, string Name, string Gray, string Accent, bool DarkOnPrimary)[]? _radixPalettes;"
        "    private static (string Id, string Name, string Gray, string Accent, bool DarkOnPrimary)[] RadixPalettes =>"
        "        _radixPalettes ??= InitRadixPalettes();"
        "    private static (string Id, string Name, string Gray, string Accent, bool DarkOnPrimary)[] InitRadixPalettes() =>"; "        ["
        for scale in scales do
            if scale <> "violet" then
                let dark = if darkOnPrimary.Contains(scale) then "true" else "false"
                $"            (\"radix-{scale}\", \"Radix {title scale}\", \"{pairing scale}\", \"{scale}\", {dark}),"
        "        ];"; ""
        File.ReadAllText(Path.Combine(__SOURCE_DIRECTORY__, "PaletteSemantics.txt")).Replace("\r\n", "\n").TrimEnd('\n')
        "}"; "" ]
    String.concat "\n" lines
